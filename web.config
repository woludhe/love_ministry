<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 220 MB: the Audio Library accepts audio files up to 200 MB (IIS's default is 30 MB).
               dotnet publish adds the ASP.NET Core handler settings to this file. -->
          <requestLimits maxAllowedContentLength="230686720" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
