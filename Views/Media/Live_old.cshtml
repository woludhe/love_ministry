// Autoplay
function dismissGuestPrompt() { document.getElementById('guestPrompt').style.display='none'; playAllVideos(); }
function unblockAutoplay() { document.getElementById('autoplayUnblock').style.display='none'; playAllVideos(); }
function playAllVideos() {
    document.getElementById('guestVideoGrid')?.querySelectorAll('video')
        .forEach(v => { if (v.paused) v.play().catch(()=>{}); });
}
function checkAutoplayBlocked(vid) {
    setTimeout(() => {
        if (vid.paused) {
            const o=document.getElementById('autoplayUnblock');
            if (o){o.style.display='flex';o.style.alignItems='center';o.style.justifyContent='center';}
        }
    }, 800);
}

// Reflow grid
let spotlightId = null;
function reflow() {
    const grid = document.getElementById('guestVideoGrid');
    if (!grid) return;
    if (spotlightId) {
        const sp = document.getElementById(`tile-${spotlightId}`);
        Array.from(grid.querySelectorAll('.video-tile')).forEach(t => {
            t.style.display = (t===sp)?'':'none';
            if (t===sp) { t.classList.add('spotlight-tile'); const v=t.querySelector('video'); if(v?.srcObject&&v.paused) v.play().catch(()=>{}); }
            else t.classList.remove('spotlight-tile');
        });
        grid.className='video-grid solo spotlight-mode';
        const lbl=document.getElementById('spotlightLabel');
        if(lbl){lbl.style.display='flex';document.getElementById('spotlightName').textContent=peerInfo[spotlightId]?.name??'Participant';}
    } else {
        Array.from(grid.querySelectorAll('.video-tile')).forEach(t => {
            t.style.display=''; t.classList.remove('spotlight-tile');
            const v=t.querySelector('video'); if(v?.srcObject&&v.paused) v.play().catch(()=>{});
        });
        const n=grid.querySelectorAll('.video-tile').length;
        grid.className='video-grid '+(n<=1?'solo':n===2?'duo':n===3?'trio':n<=4?'quad':'many');
        if(n<=1)      {grid.style.gridTemplateColumns='1fr';              grid.style.gridTemplateRows='1fr';}
        else if(n===2){grid.style.gridTemplateColumns='1fr 1fr';          grid.style.gridTemplateRows='1fr';}
        else if(n===3){grid.style.gridTemplateColumns='repeat(3,1fr)';    grid.style.gridTemplateRows='1fr';}
        else if(n<=4) {grid.style.gridTemplateColumns='1fr 1fr';          grid.style.gridTemplateRows='1fr 1fr';}
        else          {grid.style.gridTemplateColumns='repeat(auto-fill,minmax(200px,1fr))'; grid.style.gridTemplateRows='';}
        grid.style.alignContent='stretch';
        document.getElementById('spotlightLabel').style.display='none';
    }
}

