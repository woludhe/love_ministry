@model ChurchMinistry.Models.Sermon?
@{
    ViewData["Title"] = "Watch Live";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int sermonId      = Model?.Id ?? 0;
    bool isOnline     = Model?.IsOnlineMeeting == true
                     && !string.IsNullOrEmpty(Model.MeetingRoomCode);
    bool isLoggedIn   = User.Identity?.IsAuthenticated == true;
    bool isAdminPastor = User.IsInRole("Admin") || User.IsInRole("Pastor");
    string roomCode   = Model?.MeetingRoomCode ?? "";
    var meetingRoom   = ViewBag.MeetingRoom as ChurchMinistry.Models.MeetingRoom;
    int participantCount = ViewBag.ParticipantCount as int? ?? 0;
}

@section css {
    <link rel="stylesheet" href="~/css/live.css" asp-append-version="true" />
}

<div class="live-page-wrap" id="livePageWrap">

    @* Announcement marquee *@
    <div class="live-marquee-bar" id="marqueeBar" style="display:none">
        <span class="live-marquee-label">📢</span>
        <div class="live-marquee-track">
            <span class="live-marquee-inner" id="marqueeText"></span>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="live-container">
        <div class="live-main" id="liveMain">
            <div class="live-video-col" id="liveWrap">
                <div class="live-player-wrap" id="playerWrap">

                    @if (isOnline)
                    {
                        <div id="guestMeetingWrap" style="position:absolute;inset:0;background:#0f0f13">
                            <div id="guestVideoGrid" class="video-grid solo" style="position:absolute;inset:0"></div>

                            <div class="live-verse-overlay" id="verseOverlay" style="display:none">
                                <p class="live-verse-text" id="verseText"></p>
                                <span class="live-verse-ref" id="verseRef"></span>
                            </div>

                            <div id="spotlightLabel" class="spotlight-label" style="display:none">
                                <i class="fas fa-star"></i> <span id="spotlightName"></span>
                            </div>

                            <div id="startingSoonOverlay"
                                 style="position:absolute;inset:0;z-index:30;display:flex;
                                        align-items:center;justify-content:center;background:#0f0f13">
                                <div style="text-align:center;padding:2rem;max-width:340px">
                                    <div class="starting-soon-pulse"><i class="fas fa-church"></i></div>
                                    <h2 style="font-size:1.4rem;font-weight:800;color:white;margin:.75rem 0 .4rem">
                                        Starting Soon
                                    </h2>
                                    <p style="font-size:.9rem;color:rgba(255,255,255,.5);margin-bottom:1.5rem;line-height:1.6">
                                        The host has not yet joined. The live stream will begin shortly.
                                    </p>
                                    <div class="starting-soon-dots">
                                        <span></span><span></span><span></span>
                                    </div>
                                    <p style="font-size:.78rem;color:rgba(255,255,255,.3);margin-top:1.5rem">
                                        @Model?.Title
                                    </p>
                                </div>
                            </div>

                            <div class="guest-join-prompt" id="guestPrompt" style="display:none">
                                <div class="guest-prompt-inner">
                                    <i class="fas fa-users fa-2x"></i>
                                    <p>Sign in for chat &amp; reactions</p>
                                    <a asp-controller="Account" asp-action="Login"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-sign-in-alt"></i> Sign In
                                    </a>
                                    <button onclick="dismissGuestPrompt()"
                                            class="btn btn-outline btn-sm"
                                            style="color:white;border-color:rgba(255,255,255,.3)">
                                        <i class="fas fa-play"></i> Watch Live
                                    </button>
                                </div>
                            </div>

                            <div id="autoplayUnblock"
                                 style="display:none;position:absolute;inset:0;z-index:40;
                                        align-items:center;justify-content:center;
                                        background:rgba(0,0,0,.55);cursor:pointer"
                                 onclick="unblockAutoplay()">
                                <div style="text-align:center;color:white">
                                    <div style="width:64px;height:64px;border-radius:50%;
                                         background:rgba(99,102,241,.85);display:flex;
                                         align-items:center;justify-content:center;
                                         margin:0 auto .75rem;font-size:1.4rem">
                                        <i class="fas fa-volume-up"></i>
                                    </div>
                                    <p style="font-size:.9rem;font-weight:600">Tap to enable sound</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(Model.LiveStreamUrl))
                        {
                            @if (Model.LiveStreamUrl.Contains("youtube"))
                            {
                                var ytId = Model.LiveStreamUrl.Contains("v=")
                                    ? Model.LiveStreamUrl.Split("v=")[1].Split("&")[0]
                                    : Model.LiveStreamUrl.Split("/").Last();
                                <iframe src="https://www.youtube.com/embed/@ytId?autoplay=1&rel=0"
                                        style="position:absolute;inset:0;width:100%;height:100%"
                                        frameborder="0" allowfullscreen allow="autoplay"></iframe>
                            }
                            else
                            {
                                <video src="@Model.LiveStreamUrl" controls autoplay playsinline
                                       style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></video>
                            }
                        }
                        else
                        {
                            <div class="live-placeholder">
                                <i class="fas fa-broadcast-tower fa-3x"></i>
                                <p>Stream starting soon...</p>
                            </div>
                        }
                        <div class="live-verse-overlay" id="verseOverlay" style="display:none">
                            <p class="live-verse-text" id="verseText"></p>
                            <span class="live-verse-ref" id="verseRef"></span>
                        </div>
                    }

                </div>

                @* Sermon info row *@
                <div class="live-info-row">
                    <div>
                        <h2 class="live-sermon-title">@Model.Title</h2>
                        <p class="live-sermon-meta">
                            <span class="live-now-badge"><span class="live-dot"></span> LIVE</span>
                            &nbsp; @Model.Speaker
                            @if (!string.IsNullOrEmpty(Model.ScriptureReference))
                            {
                                <span>&nbsp;·&nbsp; @Model.ScriptureReference</span>
                            }
                            @if (isOnline)
                            {
                                <span class="meeting-badge">
                                    <i class="fas fa-video"></i> Online Meeting
                                    @if (participantCount > 0)
                                    {<span>· @participantCount watching</span>}
                                </span>
                            }
                        </p>
                    </div>
                    <div style="display:flex;gap:.6rem;flex-shrink:0;flex-wrap:wrap;align-items:center">
                        <button class="live-action-btn" onclick="shareStream()">
                            <i class="fas fa-share-alt"></i> Share
                        </button>

                        @* Reactions button — between Share and Chat *@
                        <div style="position:relative">
                            <button class="live-action-btn" onclick="toggleReactions()" title="React">
                                <i class="fas fa-face-smile"></i> React
                            </button>
                            <div class="reactions-bar" id="reactionsBar">
                                @foreach (var emoji in new[]{"🙏","❤️","🔥","👏","✝️","🎉","😭","🙌"})
                                {
                                    <button class="reaction-emoji" onclick="sendReaction('@emoji')">@emoji</button>
                                }
                            </div>
                        </div>

                        @if (isLoggedIn)
                        {
                            <button class="live-action-btn" id="btnInfoChat"
                                    onclick="toggleLiveChat()" title="Live Chat">
                                <i class="fas fa-comments"></i> Chat
                                <span class="ctrl-chat-badge" id="infoChatBadge" style="display:none"></span>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="live-action-btn"
                               style="border-color:rgba(99,102,241,.4);color:#a5b4fc">
                                <i class="fas fa-comments"></i> Sign in to chat
                            </a>
                        }

                        @if (isAdminPastor)
                        {
                            <a href="/Admin/LiveSettings/@Model.Id" target="_blank"
                               class="live-action-btn live-action-admin">
                                <i class="fas fa-sliders"></i> Live Settings
                            </a>
                        }
                    </div>
                </div>
            </div>

        </div>

        @* Giving sidebar *@
        <div class="live-giving-sidebar" id="givingSidebar" style="display:none">
            <div class="giving-sidebar-inner">
                <div class="giving-sidebar-header">
                    <i class="fas fa-hand-holding-heart" style="color:#10b981"></i>
                    <span id="givingCta">Support this ministry</span>
                </div>
                <div class="giving-methods" id="givingMethods"></div>
                <div class="giving-amounts">
                    <div class="giving-amounts-label">Quick amount (UGX)</div>
                    <div class="giving-amounts-grid">
                        @foreach (var amt in new[]{10000, 20000, 50000, 100000})
                        {
                            <button class="giving-amt-btn" onclick="selectAmount(@amt)">@(amt/1000)K</button>
                        }
                    </div>
                    <input type="number" id="customAmount" class="form-control giving-custom-input"
                           placeholder="Custom amount" min="1000" step="500" />
                </div>
                <a asp-controller="Giving" asp-action="Give" id="givingBtn" class="btn btn-primary btn-full">
                    <i class="fas fa-heart"></i> Give Now
                </a>
                <p class="giving-secure-note"><i class="fas fa-lock"></i> Secured by Flutterwave</p>
            </div>
        </div>

        @* Live Chat panel *@
        @if (isLoggedIn)
        {
            <div class="live-chat-panel closed" id="liveChatPanel">
                <div class="live-chat-header">
                    <div style="display:flex;align-items:center;gap:.5rem">
                        <i class="fas fa-comments" style="color:#6366f1"></i>
                        <span>Live Chat</span>
                        <span class="badge-count" id="chatUnreadBadge" style="display:none">0</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:.4rem">
                        @if (isAdminPastor)
                        {
                            <button class="chat-header-btn" id="btnPauseChat" onclick="toggleChatPause()" title="Pause chat">
                                <i class="fas fa-pause"></i>
                            </button>
                            <button class="chat-header-btn" onclick="clearChat()" title="Clear chat">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                        <button class="chat-header-btn" onclick="toggleLiveChat()" title="Close chat">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="live-chat-messages" id="liveChatMessages">
                    <div class="chat-welcome-msg">
                        <i class="fas fa-hands-praying" style="font-size:1.5rem;color:#6366f1;display:block;margin-bottom:.4rem"></i>
                        Welcome to the live chat! Be kind and encouraging. 🙏
                    </div>
                </div>
                <div class="live-chat-input-area" id="chatInputArea">
                    <div class="live-chat-input-row">
                        <img src="/images/avatar-default.png" class="chat-user-avatar" alt="You" />
                        <div class="live-chat-input-wrap">
                            <textarea id="liveChatInput" class="live-chat-textarea" rows="1"
                                      placeholder="Say something..."
                                      onkeydown="liveChatKeyDown(event)"
                                      oninput="autoResizeChat(this)"></textarea>
                            <div class="live-chat-actions">
                                <button class="emoji-pick-btn" onclick="toggleEmojiPicker()" title="Emoji">😊</button>
                                <button class="prayer-send-btn" onclick="sendLivePrayer()" title="Send as prayer">
                                    <i class="fas fa-hands-praying"></i>
                                </button>
                                <button class="chat-send-live-btn" onclick="sendLiveChat()">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="emoji-picker-row" id="emojiPickerRow" style="display:none">
                        @foreach (var e in new[]{"🙏","❤️","🔥","👏","✝️","🎉","😭","🙌","💪","🕊️","✨","🌿"})
                        {
                            <button class="emoji-quick-btn" onclick="insertEmoji('@e')">@e</button>
                        }
                    </div>
                </div>
                @if (isAdminPastor)
                {
                    <div class="chat-paused-banner" id="chatPausedBanner" style="display:none">
                        <i class="fas fa-pause-circle"></i> Chat is paused for viewers
                    </div>
                }
            </div>
        }

        @* Prayer FAB *@
        <a asp-controller="Prayer" asp-action="Submit" class="prayer-fab" id="prayerFab" style="display:none">
            <i class="fas fa-hands-praying"></i>
        </a>
        </div>
    }
    else
    {
        <div class="live-offline">
            <i class="fas fa-church fa-4x"></i>
            <h2>No live service at the moment</h2>
            <p>Join us every Sunday at 8:00 AM and 10:30 AM (EAT)</p>
            <a asp-controller="Media" asp-action="Index" class="btn btn-primary" style="margin-top:1.5rem">
                <i class="fas fa-play"></i> Watch Past Sermons
            </a>
        </div>
    }

</div>

<div id="liveData"
     data-sermon-id="@sermonId"
     data-room-code="@roomCode"
     data-is-online="@isOnline.ToString().ToLower()"
     data-is-logged-in="@isLoggedIn.ToString().ToLower()"
     data-display-name="@(isLoggedIn ? (ViewBag.MemberName as string ?? User.Identity?.Name ?? "Member") : "Guest")"
     style="display:none"></div>

@section Scripts {
<style>
/* Starting Soon */
.starting-soon-pulse    { width:80px;height:80px;border-radius:50%;background:rgba(99,102,241,.15);
                          border:2px solid rgba(99,102,241,.3);display:flex;align-items:center;
                          justify-content:center;margin:0 auto .75rem;font-size:1.8rem;
                          color:rgba(99,102,241,.8);animation:soonPulse 2s ease-in-out infinite; }
.starting-soon-dots     { display:flex;gap:6px;justify-content:center; }
.starting-soon-dots span{ width:8px;height:8px;border-radius:50%;background:rgba(99,102,241,.6);
                           animation:dotBounce 1.2s ease-in-out infinite; }
.starting-soon-dots span:nth-child(2){ animation-delay:.2s; }
.starting-soon-dots span:nth-child(3){ animation-delay:.4s; }
/* Reactions bar anchored below the React button */
.reactions-bar          { position:absolute;top:calc(100% + 6px);right:0;z-index:50;
                          display:flex;gap:.4rem;background:rgba(20,18,40,.95);
                          backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.1);
                          border-radius:100px;padding:.4rem .75rem;
                          opacity:0;pointer-events:none;transition:opacity .2s;white-space:nowrap; }
.reactions-bar.visible  { opacity:1;pointer-events:all; }
.reaction-emoji         { font-size:1.4rem;cursor:pointer;background:none;border:none;
                          padding:.1rem .2rem;transition:transform .12s;border-radius:6px; }
.reaction-emoji:hover   { transform:scale(1.35); }
.floating-reaction      { position:fixed;font-size:2rem;pointer-events:none;z-index:999;
                          animation:floatUp 2.5s ease-out forwards; }
/* Guest prompt */
.guest-join-prompt      { position:absolute;inset:0;z-index:30;display:flex;
                          align-items:flex-end;justify-content:flex-end;padding:1rem;pointer-events:none; }
.guest-prompt-inner     { background:rgba(15,10,35,.9);backdrop-filter:blur(12px);
                          border:1px solid rgba(255,255,255,.15);border-radius:14px;
                          padding:1.25rem;display:flex;flex-direction:column;
                          align-items:center;gap:.65rem;text-align:center;
                          color:white;max-width:220px;pointer-events:all; }
.guest-prompt-inner i   { color:rgba(255,255,255,.6); }
.guest-prompt-inner p   { font-size:.82rem;color:rgba(255,255,255,.75); }
/* Spotlight label */
.spotlight-label        { position:absolute;top:.75rem;left:.75rem;z-index:15;
                          display:flex;align-items:center;gap:.4rem;
                          background:rgba(99,102,241,.9);backdrop-filter:blur(6px);
                          color:white;padding:.3rem .8rem;border-radius:100px;
                          font-size:.78rem;font-weight:700;pointer-events:none; }
/* Video grid */
#guestVideoGrid         { position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;
                          overflow:hidden;display:grid;gap:6px;padding:8px;
                          grid-template-rows:1fr;align-content:stretch; }
#guestMeetingWrap       { overflow:hidden !important; }
.video-tile             { position:relative;background:#1e1b4b;border-radius:12px;
                          overflow:hidden;border:2px solid transparent;
                          width:100%;height:100%;min-height:0;min-width:0;
                          align-self:stretch;justify-self:stretch; }
.video-tile video       { position:absolute;top:0;left:0;right:0;bottom:0;
                          width:100%;height:100%;object-fit:cover;display:block; }
.video-tile.video-off video   { display:none; }
.video-tile.video-on .tile-avatar { display:none; }
.tile-avatar            { position:absolute;inset:0;display:flex;flex-direction:column;
                          align-items:center;justify-content:center;gap:.6rem; }
.tile-avatar img        { width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid #6366f1; }
.tile-avatar span       { font-size:.85rem;font-weight:600;color:rgba(255,255,255,.7); }
.tile-name              { position:absolute;bottom:.5rem;left:.6rem;background:rgba(0,0,0,.6);
                          backdrop-filter:blur(4px);padding:.2rem .6rem;border-radius:6px;
                          font-size:.78rem;font-weight:600;color:white; }
.video-grid.duo  { grid-template-columns:1fr 1fr !important;grid-template-rows:1fr !important; }
.video-grid.trio { grid-template-columns:repeat(3,1fr) !important;grid-template-rows:1fr !important; }
.video-grid.quad { grid-template-columns:1fr 1fr !important;grid-template-rows:1fr 1fr !important; }
.video-grid.many { grid-template-columns:repeat(auto-fill,minmax(200px,1fr)) !important; }
.video-grid.spotlight-mode { display:block !important;width:100% !important;height:100% !important; }
.video-grid.spotlight-mode .video-tile { width:100% !important;height:100% !important;border:2px solid #6366f1; }
@@keyframes soonPulse { 0%,100%{box-shadow:0 0 0 0 rgba(99,102,241,.3)} 50%{box-shadow:0 0 0 16px rgba(99,102,241,0)} }
@@keyframes dotBounce { 0%,80%,100%{transform:scale(.8);opacity:.5} 40%{transform:scale(1.2);opacity:1} }
@@keyframes floatUp   { 0%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(-200px)} }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
const D         = document.getElementById('liveData').dataset;
const SERMON_ID = parseInt(D.sermonId);
const ROOM_CODE = D.roomCode;
const IS_ONLINE = D.isOnline   === 'true';
const IS_LOGGED = D.isLoggedIn === 'true';
const DISPLAY   = D.displayName;

const iceConfig = { iceServers:[
    {urls:'stun:stun.l.google.com:19302'},
    {urls:'stun:stun1.l.google.com:19302'}
]};
const peers = {}, peerInfo = {}, viewerPeers = {};

// LiveSession hub — overlays, giving, chat (everyone)
const liveConn = new signalR.HubConnectionBuilder()
    .withUrl('/liveSessionHub').withAutomaticReconnect().build();

// Meeting hub — receive-only video from Room.cshtml (all users)
const guestConn = IS_ONLINE
    ? new signalR.HubConnectionBuilder()
        .withUrl('/meetingHub').withAutomaticReconnect().build()
    : null;

// LiveSession events
liveConn.on('VerseChanged', ({reference,verseText,translation}) => showVerse(reference,verseText,translation));
liveConn.on('VerseCleared', () => document.getElementById('verseOverlay').style.display='none');
liveConn.on('AnnouncementChanged', text => setMarquee(text));
liveConn.on('OverlayToggled', (overlay, visible) => {
    if (overlay==='verse')   toggleEl('verseOverlay', visible);
    if (overlay==='marquee') toggleEl('marqueeBar', visible);
    if (overlay==='giving')  {
        toggleEl('givingSidebar', visible);
        document.getElementById('liveWrap')?.classList.toggle('fill-wrap', !visible);
        document.getElementById('playerWrap')?.classList.toggle('fill-player-wrap', !visible);
    }
    if (overlay==='prayer') document.getElementById('prayerFab').style.display = visible?'flex':'none';
});
liveConn.on('SettingsChanged', s => {
    toggleEl('verseOverlay', s.showVerseOverlay);
    toggleEl('marqueeBar',   s.showMarquee);
    toggleEl('givingSidebar',s.showGivingPanel);
    if (s.givingCta) document.getElementById('givingCta').textContent = s.givingCta;
    if (s.marqueeSpeed) setMarqueeSpeed(s.marqueeSpeed);
    document.getElementById('prayerFab').style.display = s.showPrayerButton?'flex':'none';
    document.getElementById('liveWrap')?.classList.toggle('fill-wrap', !s.showGivingPanel);
    document.getElementById('playerWrap')?.classList.toggle('fill-player-wrap', !s.showGivingPanel);
});
liveConn.on('GivingCtaChanged', cta => document.getElementById('givingCta').textContent=cta);
liveConn.on('MarqueeSpeedChanged', speed => setMarqueeSpeed(speed));
liveConn.on('LiveChatMessage', msg => appendLiveChatMessage(msg));
liveConn.on('LiveChatPaused', paused => {
    chatPaused = paused;
    const area = document.getElementById('chatInputArea');
    if (area && !@isAdminPastor.ToString().ToLower()) {
        area.style.opacity      = paused?'.4':'1';
        area.style.pointerEvents = paused?'none':'auto';
    }
    appendSystemChatMsg(paused?'⏸ Chat has been paused.':'▶ Chat has been resumed.');
});
liveConn.on('LiveChatCleared', () => {
    const box = document.getElementById('liveChatMessages');
    if (box) box.innerHTML='<div class="live-chat-system-msg">Chat was cleared by the host.</div>';
});
// Show reactions from other viewers floating up on screen
liveConn.on('LiveReaction', ({emoji}) => showFloatingReaction(emoji));

// Meeting hub events — receive-only video
if (guestConn) {
    guestConn.on('RoomJoined', ({participants}) => {
        const hostPresent = participants.some(p => p.isHost || p.isAdminPastor);
        if (hostPresent) hostArrived();
        for (const p of participants)
            peerInfo[p.connectionId] = {
                name:p.displayName, photo:p.photo,
                isHost:p.isHost??false, isAdminPastor:p.isAdminPastor??false
            };
    });
    guestConn.on('PeerJoined', ({connectionId,displayName,photo,isHost,isAdminPastor}) => {
        peerInfo[connectionId] = {name:displayName,photo,isHost:isHost??false,isAdminPastor:isAdminPastor??false};
        if (isHost||isAdminPastor) hostArrived();
    });
    guestConn.on('PeerLeft', (cid, wasHost) => {
        const peerWasHost = wasHost||peerInfo[cid]?.isHost||peerInfo[cid]?.isAdminPastor;
        document.getElementById(`tile-${cid}`)?.remove();
        closePeer(cid); delete peerInfo[cid]; reflow();
        if (peerWasHost && !Object.values(peerInfo).some(p=>p.isHost||p.isAdminPastor)) {
            const soon=document.getElementById('startingSoonOverlay');
            if (soon){soon.style.display='flex';soon.style.opacity='1';}
            const prompt=document.getElementById('guestPrompt');
            if (prompt) prompt.style.display='none';
        }
    });
    guestConn.on('ReceiveOffer', async (from, offer) => {
        const pc = getOrCreateGuestPeer(from);
        await pc.setRemoteDescription(new RTCSessionDescription(offer));
        const ans = await pc.createAnswer();
        await pc.setLocalDescription(ans);
        await guestConn.invoke('SendAnswer', from, ans);
        document.getElementById('guestPrompt').style.display='none';
    });
    guestConn.on('ReceiveAnswer', async (from, ans) => {
        const pc = peers[from]||viewerPeers[from];
        if (pc) await pc.setRemoteDescription(new RTCSessionDescription(ans));
    });
    guestConn.on('ReceiveIceCandidate', async (from, c) => {
        const pc = peers[from]||viewerPeers[from];
        try { if (pc&&c) await pc.addIceCandidate(new RTCIceCandidate(c)); } catch {}
    });
    guestConn.on('SpotlightChanged', cid => {
        spotlightId = cid||null;
        reflow();
        if (cid) showToast(`📌 ${peerInfo[cid]?.name??'Participant'} spotlighted`);
        else     showToast('Spotlight cleared');
    });
}

// WebRTC receive-only
function getOrCreateGuestPeer(cid) {
    if (peers[cid]) return peers[cid];
    const pc = new RTCPeerConnection(iceConfig);
    peers[cid] = pc;
    const remoteStream = new MediaStream();
    pc.onicecandidate = e => { if (e.candidate) guestConn.invoke('SendIceCandidate', cid, e.candidate); };
    pc.ontrack = e => {
        remoteStream.addTrack(e.track);

        // Create tile on FIRST track arrival — audio may arrive before video
        let tile = document.getElementById(`tile-${cid}`);
        if (!tile) tile = addRemoteTile(cid, peerInfo[cid]?.name, peerInfo[cid]?.photo);

        const vid = tile.querySelector('video');
        if (!vid) return;

        // Always attach stream and attempt play — even for audio-first arrival.
        // vid.play() is a no-op if already playing, safe to call on every track.
        vid.srcObject = remoteStream;
        vid.play().catch(() => {});

        if (e.track.kind === 'video') {
            checkAutoplayBlocked(vid);
            tile.classList.remove('video-off');
            tile.classList.add('video-on');
            reflow();
        }
    };
    return pc;
}
function addRemoteTile(cid, name, photo) {
    const grid = document.getElementById('guestVideoGrid');
    const tile = document.createElement('div');
    tile.className='video-tile video-off'; tile.id=`tile-${cid}`;
    tile.innerHTML=`
        <video autoplay playsinline style="width:100%;height:100%;object-fit:cover;display:block"></video>
        <div class="tile-avatar">
            <img src="${escHtml(photo??'/images/avatar-default.png')}" alt="${escHtml(name??'Participant')}"/>
            <span>${escHtml(name??'Participant')}</span>
        </div>
        <div class="tile-name">${escHtml(name??'Participant')}</div>`;
    grid?.appendChild(tile); reflow(); return tile;
}
function closePeer(cid) { peers[cid]?.close(); delete peers[cid]; }

