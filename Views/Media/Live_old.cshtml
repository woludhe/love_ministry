}
const speedMap={slow:'28s',normal:'16s',fast:'9s'};
function setMarqueeSpeed(speed) { const el=document.querySelector('.live-marquee-inner'); if(el) el.style.animationDuration=speedMap[speed]??'16s'; }
function toggleEl(id,visible) { const el=document.getElementById(id); if(el) el.style.display=visible?'flex':'none'; }

// Giving
function buildGivingMethods(state) {
    const methods=[];
    if(state.showMtn)    methods.push({label:'MTN Mobile Money',cls:'gm-mtn',icon:'MTN'});
    if(state.showAirtel) methods.push({label:'Airtel Money',cls:'gm-airtel',icon:'AIR'});
    if(state.showMpesa)  methods.push({label:'M-Pesa',cls:'gm-mpesa',icon:'M-P'});
    if(state.showVisa)   methods.push({label:'VISA / Mastercard',cls:'gm-visa',icon:'VISA'});
    document.getElementById('givingMethods').innerHTML=methods.map(m=>
        `<a href="/Giving/Give" class="giving-method-btn ${m.cls}"><span class="giving-method-icon">${m.icon}</span>${m.label}</a>`
    ).join('');
}
function selectAmount(amt) {
    document.getElementById('customAmount').value=amt;
    document.getElementById('givingBtn').href=`/Giving/Give?amount=${amt}`;
}

// Share
function shareStream() {
    if(navigator.share) navigator.share({title:document.title,url:location.href});
    else {navigator.clipboard.writeText(location.href);showToast('Link copied!');}
}

// Live Chat
let chatOpen=false, chatPaused=false, unreadChat=0;
function toggleLiveChat() {
    chatOpen=!chatOpen;
    document.getElementById('liveChatPanel')?.classList.toggle('closed',!chatOpen);
    document.getElementById('btnInfoChat')?.classList.toggle('active-btn',chatOpen);
    if(chatOpen){unreadChat=0;updateChatBadge(0);document.getElementById('liveChatInput')?.focus();
        if(SERMON_ID>0) liveConn.invoke('JoinLiveChatRoom',SERMON_ID).catch(()=>{});}
}
function liveChatKeyDown(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendLiveChat();}}
function autoResizeChat(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,100)+'px';}
function sendLiveChat(){
    if(chatPaused&&!@isAdminPastor.ToString().ToLower()){showToast('Chat is paused');return;}
    const input=document.getElementById('liveChatInput');
    const msg=input.value.trim(); if(!msg) return;
    liveConn.invoke('SendLiveChat',SERMON_ID,msg,'chat').catch(console.error);
    input.value=''; input.style.height='auto';
}
function sendLivePrayer(){
    const input=document.getElementById('liveChatInput');
    const msg=input.value.trim(); if(!msg) return;
    liveConn.invoke('SendLiveChat',SERMON_ID,'🙏 '+msg,'prayer').catch(console.error);
    input.value=''; input.style.height='auto'; showToast('Prayer request shared 🙏');
}
function toggleEmojiPicker(){const row=document.getElementById('emojiPickerRow');row.style.display=row.style.display==='none'?'flex':'none';}
function insertEmoji(emoji){const input=document.getElementById('liveChatInput');if(input){input.value+=emoji;input.focus();}}
function appendLiveChatMessage({senderName,message,type,sentAt,isOwn,photo}){
    const box=document.getElementById('liveChatMessages'); if(!box) return;
    box.querySelector('.chat-welcome-msg')?.remove();
    const div=document.createElement('div');
    div.className=`live-chat-msg ${isOwn?'own':''} ${type==='prayer'?'prayer-msg':''}`;
    div.innerHTML=`${!isOwn?`<img class="chat-msg-avatar" src="${escHtml(photo??'/images/avatar-default.png')}" alt="${escHtml(senderName)}">`:''}
        <div class="chat-msg-bubble-wrap">
            ${!isOwn?`<div class="chat-msg-name">${escHtml(senderName)}</div>`:''}
            <div class="chat-msg-bubble ${type==='prayer'?'prayer-bubble':''}">${escHtml(message)}</div>
            <div class="chat-msg-time">${sentAt}</div>
        </div>`;
    box.appendChild(div); box.scrollTop=box.scrollHeight;
    if(!chatOpen){unreadChat++;updateChatBadge(unreadChat);}
}
function appendSystemChatMsg(msg){
    const box=document.getElementById('liveChatMessages'); if(!box) return;
    const d=document.createElement('div');d.className='live-chat-system-msg';d.textContent=msg;
    box.appendChild(d);box.scrollTop=box.scrollHeight;
}
function updateChatBadge(count){
    ['chatUnreadBadge','infoChatBadge'].forEach(id=>{
        const el=document.getElementById(id); if(!el) return;
        if(count>0){el.textContent=count>99?'99+':count;el.style.display='inline-flex';}
        else el.style.display='none';
    });
}
function toggleChatPause(){
    chatPaused=!chatPaused;
    liveConn.invoke('PauseLiveChat',SERMON_ID,chatPaused).catch(console.error);
    document.getElementById('btnPauseChat')?.classList.toggle('meet-ctrl-danger',chatPaused);
    const banner=document.getElementById('chatPausedBanner');
    if(banner) banner.style.display=chatPaused?'flex':'none';
    showToast(chatPaused?'⏸ Chat paused':'▶ Chat resumed');
}
function clearChat(){
    if(!confirm('Clear all chat messages for everyone?')) return;
    liveConn.invoke('ClearLiveChat',SERMON_ID).catch(console.error);
    const box=document.getElementById('liveChatMessages');
    if(box) box.innerHTML='<div class="live-chat-system-msg">Chat was cleared by the host.</div>';
}

// Utilities
function escHtml(s){const d=document.createElement('div');d.textContent=s??'';return d.innerHTML;}
function showToast(msg){
    const t=document.createElement('div');t.className='ls-toast';t.textContent=msg;
    document.body.appendChild(t);
    setTimeout(()=>t.classList.add('ls-toast-show'),10);
    setTimeout(()=>{t.classList.remove('ls-toast-show');setTimeout(()=>t.remove(),400);},3000);
}

// Boot
(async()=>{
    await liveConn.start();
    if(SERMON_ID>0){
        await liveConn.invoke('JoinLiveRoom',SERMON_ID);
        try{
            const res=await fetch(`/api/LiveSettings/${SERMON_ID}/State`);
            const s=await res.json();
            if(s.activeVerse) showVerse(s.activeVerse.reference,s.activeVerse.verseText,s.activeVerse.translation);
            if(s.activeAnnouncement) setMarquee(s.activeAnnouncement);
            if(s.givingCta) document.getElementById('givingCta').textContent=s.givingCta;
            toggleEl('verseOverlay',s.showVerseOverlay&&!!s.activeVerse);
            toggleEl('marqueeBar',s.showMarquee&&!!s.activeAnnouncement);
            toggleEl('givingSidebar',s.showGivingPanel);
            if(s.showPrayerButton) document.getElementById('prayerFab').style.display='flex';
            buildGivingMethods(s);
            if(s.marqueeSpeed) setMarqueeSpeed(s.marqueeSpeed);
        }catch{}
    }

    if(IS_ONLINE&&guestConn){
        await guestConn.start();
        const name=IS_LOGGED?DISPLAY:'Guest';
        try{
            await guestConn.invoke('JoinAsViewer',ROOM_CODE,name);
            console.log('JoinAsViewer ok, connId:',guestConn.connectionId);
        }catch(err){console.error('JoinAsViewer failed:',err);}

        // Retry after 6s if no video yet
        setTimeout(async()=>{
            const grid=document.getElementById('guestVideoGrid');
            const hasVideo=grid&&Array.from(grid.querySelectorAll('.video-on')).length>0;
            if(!hasVideo&&guestConn.state==='Connected')
                guestConn.invoke('RequestVideoFromParticipants',ROOM_CODE).catch(()=>{});
        },6000);
    }
})();

window.addEventListener('beforeunload',()=>{
    if(IS_ONLINE&&guestConn) guestConn.invoke('LeaveAsViewer',ROOM_CODE).catch(()=>{});
});
</script>
