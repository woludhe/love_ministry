@model ChurchMinistry.Models.Sermon
@inject Microsoft.Extensions.Configuration.IConfiguration OgConfig
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Pass recommended sermons from controller via ViewBag *@
@{
    var recommended = ViewBag.Recommended as List<ChurchMinistry.Models.Sermon>
                      ?? new List<ChurchMinistry.Models.Sermon>();
    // Show the poster instead of a player
    var isUpcoming = Model.IsUpcoming;
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    // Reactions, prayer, questions, comments and notes (Media/Watch loads these)
    var eng = ViewBag.Engagement as ChurchMinistry.ViewModels.SermonEngagementViewModel
              ?? new ChurchMinistry.ViewModels.SermonEngagementViewModel { SermonId = Model.Id };
    var canEngage = isSignedIn && eng.Me != null;   // staff without a member record just watch
    var loginUrl = "/Account/Login?returnUrl=" + Uri.EscapeDataString($"/Media/Watch/{Model.Id}");
    var testimonyUrl = "/Community/NewPost?category=Testimony&title=" + Uri.EscapeDataString($"Testimony: {Model.Title}");
    var myMemberId = eng.Me?.Id;
    var isStaffViewer = User.IsInRole("Admin") || User.IsInRole("Pastor");

    // ── Hero banner (turns into the player when Play is pressed) ──
    var heroYtId = ChurchMinistry.Services.MediaLinks.YouTubeVideoId(Model.VideoUrl);
    var heroImage = !string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? Model.ThumbnailUrl
                  : heroYtId != null ? $"https://img.youtube.com/vi/{heroYtId}/hqdefault.jpg"
                  : null;
    var hasVideo = !isUpcoming && !string.IsNullOrWhiteSpace(Model.VideoUrl);
    var hasAudio = !isUpcoming && !hasVideo
                   && (!string.IsNullOrEmpty(Model.AudioUrl) || (!Model.IsLive && !string.IsNullOrEmpty(Model.RecordingUrl)));
    var canPlay = hasVideo || hasAudio;
    var heroBadge = isUpcoming ? "Upcoming Sermon"
                  : Model.IsLive ? "Live now"
                  : !string.IsNullOrWhiteSpace(Model.SeriesName) ? Model.SeriesName
                  : hasAudio ? "Audio Message" : "Sermon";
    var heroBadgeIcon = isUpcoming ? "fa-hourglass-half" : Model.IsLive ? "fa-tower-broadcast" : hasAudio ? "fa-headphones" : "fa-play";
    var shareUrl = "https://apostleenockmakoko.com" + Context.Request.Path;
    var audioDownload = isSignedIn && !string.IsNullOrEmpty(Model.AudioUrl) ? Model.AudioUrl
                      : isSignedIn && !Model.IsLive && !string.IsNullOrEmpty(Model.RecordingUrl) ? Model.RecordingUrl
                      : null;
    var showCommentsTab = eng.AllowComments;
    var showNotesTab = canEngage;
}

@section meta {
    @* Rich link preview (WhatsApp, Facebook, X, Telegram…) built from the sermon's thumbnail.
       Crawlers need absolute URLs, so relative /uploads paths are prefixed with this site's origin. *@
    @{
        var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        string Abs(string u) => Uri.TryCreate(u, UriKind.Absolute, out var a) && (a.Scheme == "http" || a.Scheme == "https")
            ? u : origin + (u.StartsWith("/") ? u : "/" + u);

        var ogYtId = ChurchMinistry.Services.MediaLinks.YouTubeVideoId(Model.VideoUrl);
        var ogImage = !string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? Abs(Model.ThumbnailUrl)
                    : ogYtId != null ? $"https://img.youtube.com/vi/{ogYtId}/hqdefault.jpg"
                    : Abs(OgConfig["Church:Logo"] ?? "/images/logo.png");

        var siteName = OgConfig["Church:Name"] ?? "";
        var ogDesc = !string.IsNullOrWhiteSpace(Model.Description) ? Model.Description.Trim()
                   : string.Join(" · ", new[] { Model.Speaker, Model.ScriptureReference, Model.SermonDate.ToString("dd MMMM yyyy") }
                                         .Where(s => !string.IsNullOrWhiteSpace(s)));
        ogDesc = System.Text.RegularExpressions.Regex.Replace(ogDesc, @"\s+", " ");
        if (ogDesc.Length > 200) ogDesc = ogDesc[..197].TrimEnd() + "…";
        var ogUrl = origin + Context.Request.Path;
    }
    <meta name="description" content="@ogDesc" />
    <link rel="canonical" href="@ogUrl" />
    <meta property="og:type" content="@(Model.DeliveryMode == "audio" ? "music.song" : "video.other")" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:url" content="@ogUrl" />
    <meta property="og:image" content="@ogImage" />
    @if (ogImage.StartsWith("https://"))
    {
        <meta property="og:image:secure_url" content="@ogImage" />
    }
    <meta property="og:image:alt" content="@Model.Title" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Title" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image" content="@ogImage" />
}

<div class="watch-page">

    @* {{-- ── Breadcrumb + share ── --}} *@
    <div class="watch-topbar">
        <nav class="watch-crumbs" aria-label="Breadcrumb">
            <a href="/" title="Home"><i class="fas fa-home"></i><span class="sr-only">Home</span></a>
            <i class="fas fa-chevron-right crumb-sep" aria-hidden="true"></i>
            <a href="/Media">Sermons</a>
            <i class="fas fa-chevron-right crumb-sep" aria-hidden="true"></i>
            <span class="crumb-current" aria-current="page">@Model.Title</span>
        </nav>
        <div class="watch-share">
            <span>Share:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(shareUrl)"
               target="_blank" rel="noopener" class="share-btn fb" title="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="https://wa.me/?text=@Uri.EscapeDataString(Model.Title + " " + shareUrl)"
               target="_blank" rel="noopener" class="share-btn wa" title="Share on WhatsApp"><i class="fab fa-whatsapp"></i></a>
            <button type="button" class="share-btn more" data-share title="More ways to share"><i class="fas fa-ellipsis-h"></i></button>
        </div>
    </div>

    <div class="watch-layout">

        @* {{-- ── Main column ── --}} *@
        <div class="video-col">

            @* {{-- Hero banner over the player: Play swaps it for the player --}} *@
            <div class="video-player-wrap @(canPlay ? "" : "no-media")" id="playerWrap">

                <div class="watch-hero" id="watchHero">
                    @if (heroImage != null)
                    {
                        <img class="hero-bg" src="@heroImage" alt="" />
                    }
                    <div class="hero-shade"></div>
                    <div class="hero-content">
                        <span class="hero-badge"><i class="fas @heroBadgeIcon"></i> @heroBadge</span>
                        <h1 class="hero-title">@Model.Title</h1>
                        <p class="hero-meta">
                            @if (!string.IsNullOrWhiteSpace(Model.Speaker))
                            {
                                <span><i class="fas fa-user"></i> @Model.Speaker</span>
                            }
                            <span><i class="fas fa-calendar-alt"></i> @Model.SermonDate.ToString("dd MMMM yyyy")</span>
                            <span><i class="fas fa-eye"></i> @Model.ViewCount views</span>
                        </p>
                        @if (!string.IsNullOrEmpty(Model.ScriptureReference))
                        {
                            <p class="hero-scripture"><i class="fas fa-book-open"></i> @Model.ScriptureReference</p>
                        }
                        <div class="hero-cta">
                            @if (isUpcoming)
                            {
                                <span class="hero-play static" aria-hidden="true"><i class="fas fa-hourglass-half"></i></span>
                                <span class="hero-cta-sep" aria-hidden="true"></span>
                                <span class="hero-cta-text">
                                    <strong>@Model.SermonDate.ToString("dddd, dd MMMM yyyy")</strong>
                                    <small><i class="fas fa-clock"></i> @Model.SermonDate.ToString("h:mm tt")</small>
                                </span>
                            }
                            else if (canPlay)
                            {
                                <button type="button" class="hero-play" id="heroPlay" aria-label="@(hasAudio ? "Listen to" : "Watch") @Model.Title">
                                    <i class="fas fa-play"></i>
                                </button>
                                <span class="hero-cta-sep" aria-hidden="true"></span>
                                <span class="hero-cta-text">
                                    <strong>@(hasAudio ? "Listen" : "Watch / Listen")</strong>
                                    <small>Be inspired by God's Word</small>
                                </span>
                            }
                            else if (Model.IsLive)
                            {
                                <a class="hero-play" href="/Media/Live" aria-label="Join the live service"><i class="fas fa-tower-broadcast"></i></a>
                                <span class="hero-cta-sep" aria-hidden="true"></span>
                                <span class="hero-cta-text">
                                    <strong>Join Live</strong>
                                    <small>This message is streaming now</small>
                                </span>
                            }
                            else
                            {
                                <span class="hero-play static" aria-hidden="true"><i class="fas fa-microphone-alt"></i></span>
                                <span class="hero-cta-sep" aria-hidden="true"></span>
                                <span class="hero-cta-text">
                                    <strong>Recording coming soon</strong>
                                    <small>Check back to watch or listen</small>
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @if (isUpcoming)
                {
                    @* {{-- Only the banner until it happens --}} *@
                }
                else if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                {
                    var ytId = ChurchMinistry.Services.MediaLinks.YouTubeVideoId(Model.VideoUrl);
                    if (ChurchMinistry.Services.MediaLinks.IsFacebook(Model.VideoUrl))
                    {
                        <iframe src="https://www.facebook.com/plugins/video.php?href=@Uri.EscapeDataString(Model.VideoUrl)&show_text=false"
                                width="100%"
                                height="100%"
                                style="border:none;overflow:hidden"
                                allowfullscreen
                                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
                        </iframe>
                    }
                    else if (ytId != null)
                    {
                        <iframe id="ytPlayer"
                                src="https://www.youtube.com/embed/@(ytId)?enablejsapi=1&rel=0&modestbranding=1"
                                width="100%"
                                height="100%"
                                frameborder="0"
                                allowfullscreen
                                allow="autoplay; encrypted-media"
                                data-video-type="youtube">
                        </iframe>
                    }
                    else
                    {
                        <video id="htmlPlayer"
                               controls
                               src="@Model.VideoUrl"
                               poster="@Model.ThumbnailUrl"
                               data-video-type="html5"
                               style="width:100%;height:100%;object-fit:cover">
                        </video>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.AudioUrl) || (!Model.IsLive && !string.IsNullOrEmpty(Model.RecordingUrl)))
                {
                    @* {{-- Audio sermon, or the audio recorded from the meeting room while it was live:
                           the poster with a waveform of the sound, controls along the bottom --}} *@
                    <div class="audio-only-wrap">
                        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <div class="audio-poster-bg" style="background-image:url('@Model.ThumbnailUrl')"></div>
                            <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="audio-thumb" />
                        }
                        else
                        {
                            <div class="audio-poster-icon"><i class="fas fa-headphones"></i></div>
                        }
                        <canvas class="audio-wave" id="audioWave" width="320" height="56" aria-hidden="true"></canvas>
                        <audio id="htmlPlayer"
                               controls
                               controlsList="@(isSignedIn ? null : "nodownload")"
                               oncontextmenu="@(isSignedIn ? null : "return false")"
                               src="@(!string.IsNullOrEmpty(Model.AudioUrl) ? Model.AudioUrl : Model.RecordingUrl)"
                               data-video-type="html5"
                               class="audio-player-bar"></audio>
                    </div>
                }

                @* {{-- ── Recommendations panel (hidden until 5 min before end) ── --}} *@
                <div class="reco-panel" id="recoPanel" aria-hidden="true">
                    <div class="reco-panel-header">
                        <div class="reco-panel-title">
                            <i class="fas fa-list-ul"></i>
                            Up Next
                        </div>
                        <div class="reco-countdown">
                            Continuing in <span id="recoCountdown">5:00</span>
                        </div>
                        <button class="reco-dismiss" onclick="dismissPanel()" title="Keep watching">
                            <i class="fas fa-times"></i> Keep watching
                        </button>
                    </div>

                    <div class="reco-cards" id="recoCards">
                        @foreach (var s in recommended)
                        {
                            <a class="reco-card" href="/Media/Watch/@s.Id">
                                <div class="reco-thumb-wrap">
                                    @if (!string.IsNullOrEmpty(s.ThumbnailUrl))
                                    {
                                        <img src="@s.ThumbnailUrl" alt="@s.Title" class="reco-thumb" />
                                    }
                                    else
                                    {
                                        <div class="reco-thumb-placeholder">
                                            <i class="fas fa-play-circle"></i>
                                        </div>
                                    }
                                </div>
                                <div class="reco-card-info">
                                    @if (!string.IsNullOrEmpty(s.SeriesName))
                                    {
                                        <span class="tag" style="font-size:.68rem">@s.SeriesName</span>
                                    }
                                    <p class="reco-card-title">@s.Title</p>
                                    <p class="reco-card-meta">
                                        <i class="fas fa-user"></i> @s.Speaker
                                        &nbsp;·&nbsp;
                                        <i class="fas fa-calendar"></i> @s.SermonDate.ToString("dd MMM yyyy")
                                    </p>
                                </div>
                            </a>
                        }
                    </div>

                    @* {{-- Auto-advance progress bar --}} *@
                    <div class="reco-autoplay-bar">
                        <div class="reco-autoplay-fill" id="recoAutoFill"></div>
                    </div>
                </div>

            </div>@* {{-- /playerWrap --}} *@

            @* Reactions, right under the player. Guests are sent to Login and come back here. *@
            <div class="react-row" id="reactRow">
                @if (canEngage)
                {
                    <button type="button" class="engage-btn react @(eng.Amened ? "on" : "")" data-kind="Amen" aria-pressed="@(eng.Amened ? "true" : "false")" title="Amen">
                        <span aria-hidden="true">🙏</span> Amen <span class="engage-count" data-count="Amen">@eng.AmenCount</span>
                    </button>
                    <button type="button" class="engage-btn react @(eng.Blessed ? "on" : "")" data-kind="Blessed" aria-pressed="@(eng.Blessed ? "true" : "false")" title="I was blessed">
                        <i class="fas fa-heart"></i> Blessed <span class="engage-count" data-count="Blessed">@eng.BlessedCount</span>
                    </button>
                }
                else if (isSignedIn)
                {
                    @* Signed in without a member profile (e.g. the seeded admin): counts only *@
                    <span class="engage-btn static"><span aria-hidden="true">🙏</span> Amen <span class="engage-count">@eng.AmenCount</span></span>
                    <span class="engage-btn static"><i class="fas fa-heart"></i> Blessed <span class="engage-count">@eng.BlessedCount</span></span>
                }
                else
                {
                    <a class="engage-btn" href="@loginUrl" title="Sign in to say Amen">
                        <span aria-hidden="true">🙏</span> Amen <span class="engage-count">@eng.AmenCount</span>
                    </a>
                    <a class="engage-btn" href="@loginUrl" title="Sign in to say you were blessed">
                        <i class="fas fa-heart"></i> Blessed <span class="engage-count">@eng.BlessedCount</span>
                    </a>
                }
            </div>

            @* {{-- Respond to the sermon. Guests are sent to Login and come back here. --}} *@
            @* {{-- On phones these become round icons; data-tip is the tooltip, the label is hidden --}} *@
            <div class="engage-bar" id="engageBar">
                @if (canEngage)
                {
                    <button type="button" class="engage-btn primary" data-open="prayDialog" data-tip="Request Prayer" aria-label="Request Prayer"><i class="fas fa-praying-hands"></i> <span class="engage-label">Request Prayer</span></button>
                    <button type="button" class="engage-btn" data-open="askDialog" data-tip="Ask a Question" aria-label="Ask a Question"><i class="fas fa-question-circle"></i> <span class="engage-label">Ask a Question</span></button>
                    <a class="engage-btn" href="@testimonyUrl" target="_blank" rel="noopener" data-tip="Share a Testimony" aria-label="Share a Testimony"><i class="fas fa-star"></i> <span class="engage-label">Share a Testimony</span></a>
                    <a class="engage-btn" href="/Giving/Give" target="_blank" rel="noopener" data-tip="Give" aria-label="Give"><i class="fas fa-hand-holding-heart"></i> <span class="engage-label">Give</span></a>
                    <a class="engage-btn" href="/Members/Dashboard#one-on-one" target="_blank" rel="noopener" data-tip="One-on-One" aria-label="One-on-One"><i class="fas fa-user-friends"></i> <span class="engage-label">One-on-One</span></a>
                }
                else if (!isSignedIn)
                {
                    <a class="engage-btn primary" href="@loginUrl" data-tip="Request Prayer" aria-label="Request Prayer"><i class="fas fa-praying-hands"></i> <span class="engage-label">Request Prayer</span></a>
                    <a class="engage-btn" href="@loginUrl" data-tip="Ask a Question" aria-label="Ask a Question"><i class="fas fa-question-circle"></i> <span class="engage-label">Ask a Question</span></a>
                    <a class="engage-btn" href="@loginUrl" data-tip="Share a Testimony" aria-label="Share a Testimony"><i class="fas fa-star"></i> <span class="engage-label">Share a Testimony</span></a>
                    <a class="engage-btn" href="/Giving/Give" target="_blank" rel="noopener" data-tip="Give" aria-label="Give"><i class="fas fa-hand-holding-heart"></i> <span class="engage-label">Give</span></a>
                    <a class="engage-btn" href="@loginUrl" data-tip="One-on-One" aria-label="One-on-One"><i class="fas fa-user-friends"></i> <span class="engage-label">One-on-One</span></a>
                }
                else
                {
                    @* Signed in without a member profile (e.g. the seeded admin) *@
                    <a class="engage-btn" href="/Giving/Give" target="_blank" rel="noopener" data-tip="Give" aria-label="Give"><i class="fas fa-hand-holding-heart"></i> <span class="engage-label">Give</span></a>
                }
                @* {{-- Downloading is for signed-in members only --}} *@
                @if (audioDownload != null)
                {
                    <a class="engage-btn" href="@audioDownload" download data-tip="Download Audio" aria-label="Download Audio"><i class="fas fa-download"></i> <span class="engage-label">Download Audio</span></a>
                }
            </div>
            <div class="engage-msg" id="engageMsg" role="status" hidden></div>

            @Html.AntiForgeryToken()

            @* {{-- About this message --}} *@
            @if (!string.IsNullOrEmpty(Model.Description) || !string.IsNullOrEmpty(Model.Tags))
            {
                <section class="watch-card about-card">
                    <h2 class="card-title"><i class="fas fa-align-left"></i> <span>@Model.Title</span></h2>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="sermon-description" id="sermonDescription">@Model.Description.Trim()</p>
                        <button type="button" class="read-more" id="readMore" hidden>Read more</button>
                    }
                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        <div class="sermon-tags">
                            @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="tag">@tag.Trim()</span>
                            }
                        </div>
                    }
                </section>
            }

            @* {{-- Comments and private notes, as tabs --}} *@
            @if (showCommentsTab || showNotesTab)
            {
                <section class="watch-card tabs-card" id="comments">
                    <div class="watch-tabs" role="tablist">
                        @if (showCommentsTab)
                        {
                            <button type="button" class="watch-tab active" role="tab" id="tab-comments" aria-controls="panel-comments" aria-selected="true">
                                <i class="fas fa-comments"></i> <span>Comments (<span id="commentCount">@eng.Comments.Count</span>)</span>
                            </button>
                        }
                        @if (showNotesTab)
                        {
                            <button type="button" class="watch-tab @(showCommentsTab ? "" : "active")" role="tab" id="tab-notes" aria-controls="panel-notes" aria-selected="@(showCommentsTab ? "false" : "true")">
                                <i class="fas fa-file-alt"></i> My Sermon Notes
                            </button>
                            <span class="notes-private" id="notesPrivate" @(showCommentsTab ? "hidden" : "")><i class="fas fa-lock"></i> Only you can see these</span>
                        }
                    </div>

                    @if (showCommentsTab)
                    {
                        <div class="watch-panel" role="tabpanel" id="panel-comments" aria-labelledby="tab-comments">
                            @if (canEngage)
                            {
                                <form class="sc-form" id="commentForm">
                                    <img src="@(eng.Me!.ProfilePhoto ?? "/images/avatar-default.png")" alt="" class="sc-avatar" />
                                    <div class="sc-form-body">
                                        <textarea name="content" class="form-control" rows="3" maxlength="@ChurchMinistry.Models.SermonComment.MaxLength"
                                                  placeholder="Share what blessed you, or encourage others…" required></textarea>
                                        <div class="sc-form-actions">
                                            <span class="sc-error" id="commentError" role="alert"></span>
                                            <button type="submit" class="btn btn-primary sc-post"><i class="fas fa-paper-plane"></i> Post</button>
                                        </div>
                                    </div>
                                </form>
                            }
                            else if (!isSignedIn)
                            {
                                <p class="sc-signin"><a href="@loginUrl">Sign in</a> to join the conversation.</p>
                            }
                            <div class="sc-list" id="commentList">
                                @foreach (var c in eng.Comments)
                                {
                                    <partial name="_SermonComment" model="@(new ChurchMinistry.ViewModels.SermonCommentViewModel { Comment = c, CanDelete = isStaffViewer || c.MemberId == myMemberId })" />
                                }
                            </div>
                            @if (eng.Comments.Count == 0)
                            {
                                <div class="sc-empty" id="commentEmpty">
                                    <span class="sc-empty-icon" aria-hidden="true"><i class="fas fa-comments"></i></span>
                                    <strong>No comments yet.</strong>
                                    <span>Be the first to share what blessed you.</span>
                                </div>
                            }
                        </div>
                    }
                    @if (showNotesTab)
                    {
                        <div class="watch-panel" role="tabpanel" id="panel-notes" aria-labelledby="tab-notes" @(showCommentsTab ? "hidden" : "")>
                            <textarea id="sermonNote" class="form-control" rows="7" maxlength="20000"
                                      placeholder="Key points, scriptures, what God is saying to you…">@eng.MyNote</textarea>
                            <div class="notes-status" id="noteStatus" aria-live="polite"></div>
                        </div>
                    }
                </section>
            }
        </div>

        @* {{-- ── Sidebar ── --}} *@
        <aside class="watch-sidebar">
            <section class="watch-card side-card details-card">
                <h2 class="card-title"><i class="fas fa-info-circle"></i> Sermon Details</h2>
                <ul class="detail-list">
                    <li>
                        <i class="fas fa-calendar-alt"></i>
                        <div><small>@(isUpcoming ? "Scheduled for" : "Published on")</small><strong>@Model.SermonDate.ToString("dd MMMM yyyy")</strong></div>
                    </li>
                    <li>
                        <i class="fas fa-eye"></i>
                        <div><small>Views</small><strong>@Model.ViewCount</strong></div>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.Speaker))
                    {
                        <li>
                            <i class="fas fa-user"></i>
                            <div><small>Speaker</small><strong>@Model.Speaker</strong></div>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SeriesName))
                    {
                        <li>
                            <i class="fas fa-layer-group"></i>
                            <div><small>Series</small><strong>@Model.SeriesName</strong></div>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ScriptureReference))
                    {
                        <li>
                            <i class="fas fa-book-open"></i>
                            <div><small>Scripture</small><strong>@Model.ScriptureReference</strong></div>
                        </li>
                    }
                </ul>
                <div class="side-divider"></div>
                <button type="button" class="share-this" data-share><i class="fas fa-share"></i> Share This Sermon</button>
                <div class="share-toast" role="status" hidden>Link copied</div>
            </section>

            @if (recommended.Count > 0)
            {
                <section class="watch-card side-card">
                    <div class="card-title-row">
                        <h2 class="card-title"><i class="fas fa-play-circle"></i> Related Sermons</h2>
                        <a href="/Media" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div class="related-list">
                        @foreach (var s in recommended)
                        {
                            <a class="related-item" href="/Media/Watch/@s.Id">
                                <span class="related-thumb">
                                    @if (!string.IsNullOrEmpty(s.ThumbnailUrl))
                                    {
                                        <img src="@s.ThumbnailUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-play-circle"></i>
                                    }
                                </span>
                                <span class="related-info">
                                    <strong>@s.Title</strong>
                                    <small><i class="fas fa-calendar-alt"></i> @s.SermonDate.ToString("dd MMMM yyyy")</small>
                                    <small><i class="fas fa-eye"></i> @s.ViewCount</small>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (!isSignedIn)
            {
                <section class="stay-card">
                    <span class="stay-icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                    <div>
                        <h2>Stay Connected</h2>
                        <p>Join our community for more inspiring messages.</p>
                    </div>
                    <a href="/Account/Register" class="stay-btn">Register <i class="fas fa-arrow-right"></i></a>
                </section>
            }
        </aside>

    </div>
</div>

@if (canEngage)
{
    <dialog class="engage-dialog" id="prayDialog" aria-labelledby="prayTitle">
        <form method="dialog" class="engage-dialog-form" data-action="/Media/Pray/@Model.Id">
            <div class="engage-dialog-head">
                <h3 id="prayTitle"><i class="fas fa-praying-hands"></i> Request prayer</h3>
                <button type="button" class="engage-dialog-close" data-close aria-label="Close"><i class="fas fa-xmark"></i></button>
            </div>
            <p class="engage-dialog-sub">Our pastors and prayer team will stand with you. We'll note that you were watching "@Model.Title".</p>
            <textarea name="Request" class="form-control" rows="5" required placeholder="How can we pray for you?"></textarea>
            <div class="engage-dialog-row">
                <label for="prayCategory">Category</label>
                <select name="Category" id="prayCategory" class="form-control">
                    @foreach (var cat in Enum.GetValues<ChurchMinistry.Models.PrayerCategory>())
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            @* The hidden "false" after each box is what's sent when it's unticked (the first value wins) *@
            <label class="engage-check"><input type="checkbox" name="IsPublic" value="true" checked /> Share on the Prayer Wall so others can pray too</label>
            <input type="hidden" name="IsPublic" value="false" />
            <label class="engage-check"><input type="checkbox" name="IsAnonymous" value="true" /> Post anonymously</label>
            <input type="hidden" name="IsAnonymous" value="false" />
            <div class="engage-dialog-error" role="alert"></div>
            <div class="engage-dialog-actions">
                <button type="button" class="btn btn-outline btn-sm" data-close>Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i> Send request</button>
            </div>
        </form>
    </dialog>

    <dialog class="engage-dialog" id="askDialog" aria-labelledby="askTitle">
        <form method="dialog" class="engage-dialog-form" data-action="/Media/Ask/@Model.Id">
            <div class="engage-dialog-head">
                <h3 id="askTitle"><i class="fas fa-question-circle"></i> Ask a question</h3>
                <button type="button" class="engage-dialog-close" data-close aria-label="Close"><i class="fas fa-xmark"></i></button>
            </div>
            <p class="engage-dialog-sub">Your question goes to the Pastor and is posted in Community (Pastor Q&amp;A), so others can learn from the answer too.</p>
            <textarea name="question" class="form-control" rows="5" required maxlength="4000" placeholder="What would you like to ask about this message?"></textarea>
            <div class="engage-dialog-error" role="alert"></div>
            <div class="engage-dialog-actions">
                <button type="button" class="btn btn-outline btn-sm" data-close>Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i> Send question</button>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script src="~/js/audio-wave.js" asp-append-version="true"></script>
    <script>
        // ── Banner, tabs, sharing, "Read more" ──
        (() => {
            // Play: the banner fades away and the player (already loaded underneath) starts
            const wrap = document.getElementById('playerWrap');
            document.getElementById('heroPlay')?.addEventListener('click', () => {
                wrap.classList.add('playing');
                const media = document.getElementById('htmlPlayer');
                if (media) { media.play().catch(() => {}); return; }
                if (document.getElementById('ytPlayer')) {
                    if (window.__ytPlayer?.playVideo) window.__ytPlayer.playVideo();
                    else window.__ytPlayWanted = true;   // the YouTube API isn't ready yet: it plays on ready
                }
                // Facebook: its own play button is now in view
            });

            // Comments / My Sermon Notes tabs
            const tabs = [...document.querySelectorAll('.watch-tab')];
            const lockNote = document.getElementById('notesPrivate');
            tabs.forEach(tab => tab.addEventListener('click', () => {
                tabs.forEach(t => {
                    const on = t === tab;
                    t.classList.toggle('active', on);
                    t.setAttribute('aria-selected', on);
                    document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
                });
                if (lockNote) lockNote.hidden = tab.id !== 'tab-notes';
                if (tab.id === 'tab-notes') document.getElementById('sermonNote')?.focus();
            }));

            // Share: the phone's share sheet, or copy the link
            const shareUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(shareUrl));
            const shareTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title));
            const toast = document.querySelector('.share-toast');
            const showToast = text => {
                if (!toast) return;
                toast.textContent = text; toast.hidden = false;
                clearTimeout(showToast.t); showToast.t = setTimeout(() => toast.hidden = true, 2500);
            };
            const copy = async text => {
                try { await navigator.clipboard.writeText(text); return true; } catch { }
                const ta = Object.assign(document.createElement('textarea'), { value: text });
                ta.style.cssText = 'position:fixed;opacity:0';
                document.body.appendChild(ta); ta.select();
                const ok = document.execCommand('copy'); ta.remove();
                return ok;
            };
            document.querySelectorAll('[data-share]').forEach(btn => btn.addEventListener('click', async () => {
                if (navigator.share) {
                    try { await navigator.share({ title: shareTitle, url: shareUrl }); } catch { }
                    return;
                }
                showToast(await copy(shareUrl) ? 'Link copied' : shareUrl);
            }));

            // Long descriptions fold to a few lines. Measured once the page (and the styles that
            // come after this script) has loaded.
            const desc = document.getElementById('sermonDescription');
            const more = document.getElementById('readMore');
            if (desc && more) {
                more.addEventListener('click', () => {
                    const folded = desc.classList.toggle('folded');
                    more.textContent = folded ? 'Read more' : 'Show less';
                });
                document.addEventListener('DOMContentLoaded', () => {
                    desc.classList.add('folded');
                    if (desc.scrollHeight > desc.clientHeight + 2) more.hidden = false;
                    else desc.classList.remove('folded');
                });
            }
        })();
    </script>
    <script>
        // ── Engagement: reactions, prayer, questions, comments, notes ──
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const sermonId = @Model.Id;
            const post = (url, data) => fetch(url, {
                method: 'POST', body: data, headers: { 'RequestVerificationToken': token }
            });
            const errorOf = async res => {
                try { return (await res.json()).error; } catch { return null; }
            };
            const msg = document.getElementById('engageMsg');
            const flash = html => {
                if (!msg) return;
                msg.innerHTML = html; msg.hidden = false;
                clearTimeout(flash.t); flash.t = setTimeout(() => msg.hidden = true, 9000);
            };

            // Amen / Blessed
            document.querySelectorAll('.engage-btn.react').forEach(btn => btn.addEventListener('click', async () => {
                btn.disabled = true;
                const data = new FormData(); data.append('kind', btn.dataset.kind);
                try {
                    const res = await post(`/Media/React/${sermonId}`, data);
                    if (!res.ok) return;
                    const r = await res.json();
                    document.querySelector('[data-count="Amen"]').textContent = r.amen;
                    document.querySelector('[data-count="Blessed"]').textContent = r.blessed;
                    document.querySelectorAll('.engage-btn.react').forEach(b => {
                        const on = r.mine.includes(b.dataset.kind);
                        b.classList.toggle('on', on); b.setAttribute('aria-pressed', on);
                    });
                } finally { btn.disabled = false; }
            }));

            // Phones have no hover: a touch on a round action icon shows its tooltip briefly
            document.querySelectorAll('#engageBar [data-tip]').forEach(b => {
                let t;
                b.addEventListener('touchstart', () => {
                    document.querySelectorAll('#engageBar .tip-show').forEach(o => o.classList.remove('tip-show'));
                    b.classList.add('tip-show');
                    clearTimeout(t); t = setTimeout(() => b.classList.remove('tip-show'), 1600);
                }, { passive: true });
            });

            // Pray / Ask pop-ups
            document.querySelectorAll('[data-open]').forEach(b => b.addEventListener('click', () =>
                document.getElementById(b.dataset.open)?.showModal()));
            document.querySelectorAll('.engage-dialog').forEach(dlg => {
                dlg.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => dlg.close()));
                dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });   // backdrop
                const form = dlg.querySelector('form');
                form.addEventListener('submit', async e => {
                    e.preventDefault();
                    const err = form.querySelector('.engage-dialog-error');
                    const submit = form.querySelector('[type=submit]');
                    err.textContent = ''; submit.disabled = true;
                    try {
                        const res = await post(form.dataset.action, new FormData(form));
                        if (!res.ok) { err.textContent = await errorOf(res) ?? 'Something went wrong. Please try again.'; return; }
                        const r = await res.json();
                        form.reset(); dlg.close();
                        flash(dlg.id === 'prayDialog'
                            ? '<i class="fas fa-check-circle"></i> Your prayer request was sent. We are praying with you. <a href="/Prayer/MyRequests">My prayer requests</a>'
                            : `<i class="fas fa-check-circle"></i> Your question was sent to the Pastor. <a href="${r.url}">View it in Community</a>`);
                    } catch { err.textContent = 'Could not send. Check your connection and try again.'; }
                    finally { submit.disabled = false; }
                });
            });

            // Notes: saved a moment after typing stops (and when leaving the page)
            const note = document.getElementById('sermonNote');
            if (note) {
                const status = document.getElementById('noteStatus');
                let timer = null, saved = note.value;
                const save = async () => {
                    clearTimeout(timer); timer = null;
                    if (note.value === saved) return;
                    const value = note.value;
                    status.textContent = 'Saving…';
                    const data = new FormData(); data.append('note', value);
                    try {
                        const res = await post(`/Media/SaveNote/${sermonId}`, data);
                        if (res.ok) { saved = value; status.textContent = 'Saved'; }
                        else status.textContent = 'Not saved, will try again';
                    } catch { status.textContent = 'Not saved, will try again'; }
                };
                note.addEventListener('input', () => { status.textContent = ''; clearTimeout(timer); timer = setTimeout(save, 1200); });
                note.addEventListener('blur', save);
                window.addEventListener('pagehide', () => {
                    if (note.value === saved) return;
                    const data = new FormData(); data.append('note', note.value);
                    fetch(`/Media/SaveNote/${sermonId}`, { method: 'POST', body: data, keepalive: true, headers: { 'RequestVerificationToken': token } });
                });
            }

            // Comments
            const list = document.getElementById('commentList');
            const count = document.getElementById('commentCount');
            const form = document.getElementById('commentForm');
            form?.addEventListener('submit', async e => {
                e.preventDefault();
                const err = document.getElementById('commentError');
                const submit = form.querySelector('[type=submit]');
                err.textContent = ''; submit.disabled = true;
                try {
                    const res = await post(`/Media/Comment/${sermonId}`, new FormData(form));
                    if (!res.ok) { err.textContent = await errorOf(res) ?? 'Could not post. Please try again.'; return; }
                    list.insertAdjacentHTML('afterbegin', await res.text());
                    document.getElementById('commentEmpty')?.remove();
                    count.textContent = +count.textContent + 1;
                    form.reset();
                } catch { err.textContent = 'Could not post. Check your connection and try again.'; }
                finally { submit.disabled = false; }
            });
            list?.addEventListener('click', async e => {
                const del = e.target.closest('.sc-delete');
                if (!del || !confirm('Delete this comment?')) return;
                const data = new FormData(); data.append('commentId', del.dataset.id);
                const res = await post('/Media/DeleteComment', data);
                if (res.ok) {
                    del.closest('.sc-item').remove();
                    count.textContent = Math.max(0, +count.textContent - 1);
                }
            });
        })();
    </script>
    <script>
        // Audio sermons: waveform under the poster while it plays
        (() => {
            const canvas = document.getElementById('audioWave');
            const audio = document.getElementById('htmlPlayer');
            if (!canvas || !audio) return;
            const wave = AudioWave(canvas);
            wave.addMedia(audio);
            wave.start();
        })();
    </script>
    <script>
        // ═══════════════════════════════════════════════════════════
        //  Sermon Recommendation Engine
        //  Works for both YouTube embeds and HTML5 <video>/<audio>
        // ═══════════════════════════════════════════════════════════

        const TRIGGER_SECONDS = 300; // show panel 5 minutes (300s) before end
        const AUTO_NAV_DELAY = 15;  // seconds to wait before auto-navigating
        const FIRST_RECO_URL = document.querySelector('.reco-card')?.href;

        let panelVisible = false;
        let dismissed = false;
        let countdownSecs = TRIGGER_SECONDS;
        let autoNavTimer = null;
        let autoFillTimer = null;
        let pollTimer = null;

        // ── Panel controls ────────────────────────────────────────
        function showPanel() {
            if (panelVisible || dismissed) return;
            panelVisible = true;
            const panel = document.getElementById('recoPanel');
            panel.classList.add('reco-panel-visible');
            panel.setAttribute('aria-hidden', 'false');
            startAutoNav();
        }

        function dismissPanel() {
            dismissed = true;
            panelVisible = false;
            document.getElementById('recoPanel').classList.remove('reco-panel-visible');
            clearAutoNav();
        }

        // ── Countdown inside panel ────────────────────────────────
        function startCountdown(remaining) {
            let secs = Math.round(remaining);
            const el = document.getElementById('recoCountdown');
            const tick = () => {
                if (secs <= 0) { showPanel(); return; }
                const m = Math.floor(secs / 60);
                const s = secs % 60;
                if (el) el.textContent = `${m}:${String(s).padStart(2, '0')}`;
                secs--;
            };
            tick();
            return setInterval(tick, 1000);
        }

        // ── Auto-navigate to first recommendation ─────────────────
        function startAutoNav() {
            if (!FIRST_RECO_URL) return;
            let secs = AUTO_NAV_DELAY;
            const fill = document.getElementById('recoAutoFill');

            autoFillTimer = setInterval(() => {
                secs--;
                if (fill) fill.style.width = ((AUTO_NAV_DELAY - secs) / AUTO_NAV_DELAY * 100) + '%';
                if (secs <= 0) {
                    clearInterval(autoFillTimer);
                    window.location.href = FIRST_RECO_URL;
                }
            }, 1000);
        }

        function clearAutoNav() {
            clearInterval(autoFillTimer);
            clearInterval(autoNavTimer);
            const fill = document.getElementById('recoAutoFill');
            if (fill) fill.style.width = '0%';
        }

        // ── HTML5 video / audio ───────────────────────────────────
        const html5Player = document.getElementById('htmlPlayer');
        let countdownInterval = null;

        if (html5Player) {
            html5Player.addEventListener('timeupdate', () => {
                if (dismissed || panelVisible) return;

                const duration = html5Player.duration;
                const current = html5Player.currentTime;
                if (!duration || isNaN(duration)) return;

                const remaining = duration - current;

                if (remaining <= TRIGGER_SECONDS && !panelVisible && !dismissed) {
                    if (!countdownInterval) {
                        countdownInterval = startCountdown(remaining);
                    }
                }

                if (remaining <= 0) showPanel();
            });

            // Also trigger on ended
            html5Player.addEventListener('ended', showPanel);
        }

        // ── YouTube IFrame API ────────────────────────────────────
        const ytFrame = document.getElementById('ytPlayer');

        if (ytFrame) {
            // Load YouTube IFrame API
            const tag = document.createElement('script');
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(tag);

            let ytPlayer;
            let ytCountdownStarted = false;

            window.onYouTubeIframeAPIReady = function () {
                ytPlayer = new YT.Player('ytPlayer', {
                    events: {
                        onReady: () => {
                            window.__ytPlayer = ytPlayer;   // the banner's Play button starts it
                            if (window.__ytPlayWanted) ytPlayer.playVideo();
                            // Poll every second once playing
                            pollTimer = setInterval(() => {
                                if (!ytPlayer) return;
                                const state = ytPlayer.getPlayerState();
                                const playing = state === YT.PlayerState.PLAYING;
                                if (!playing) return;

                                const duration = ytPlayer.getDuration();
                                const current = ytPlayer.getCurrentTime();
                                if (!duration) return;

                                const remaining = duration - current;

                                if (remaining <= TRIGGER_SECONDS && !dismissed) {
                                    if (!ytCountdownStarted) {
                                        ytCountdownStarted = true;
                                        startCountdown(remaining);
                                    }
                                    if (remaining <= 1) showPanel();
                                }
                            }, 1000);
                        },
                        onStateChange: (e) => {
                            if (e.data === YT.PlayerState.ENDED) showPanel();
                        }
                    }
                });
            };
        }

        // ── Cleanup on page unload ────────────────────────────────
        window.addEventListener('beforeunload', () => {
            clearInterval(pollTimer);
            clearInterval(countdownInterval);
            clearAutoNav();
        });
    </script>

    <style>
        /* ═══ Sermon page: purple hero, pill actions, tabbed comments/notes, card sidebar ═══ */
        .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }

        /* ── Layout ─────────────────────────────────── */
        .watch-page { max-width:1280px; margin:0 auto; padding:1.25rem 1.5rem 2rem; }
        .watch-layout { display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:1.75rem; align-items:start; }
        .video-col { display:flex; flex-direction:column; gap:1.25rem; min-width:0; }
        .watch-sidebar { display:flex; flex-direction:column; gap:1.25rem; min-width:0; }

        /* ── Breadcrumb + share ─────────────────────── */
        .watch-topbar { display:flex; align-items:center; justify-content:space-between; gap:.75rem 1.5rem; flex-wrap:wrap; margin-bottom:1rem; }
        .watch-crumbs { display:flex; align-items:center; gap:.7rem; min-width:0; font-size:1rem; color:var(--text-s); }
        .watch-crumbs a { color:var(--text); text-decoration:none; font-weight:500; }
        .watch-crumbs a:hover { color:var(--purple); }
        .watch-crumbs .fa-home { font-size:1.2rem; color:var(--text); }
        .crumb-sep { font-size:.7rem; color:var(--text-s); }
        .crumb-current { color:var(--purple); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:40ch; }
        .watch-share { display:flex; align-items:center; gap:.55rem; font-size:.9rem; color:var(--text-s); }
        .share-btn { width:36px; height:36px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center;
                     color:#fff; font-size:.95rem; border:none; cursor:pointer; transition:transform .15s, opacity .15s; text-decoration:none; }
        .share-btn:hover { color:#fff; transform:translateY(-1px); opacity:.9; }
        .share-btn.fb { background:#1877f2; }
        .share-btn.wa { background:#25d366; }
        .share-btn.more { background:var(--surface-2); color:var(--text); }
        .share-btn.more:hover { color:var(--purple); }
        .share-btn:focus-visible, .share-this:focus-visible { outline:2px solid var(--purple); outline-offset:2px; }

        /* ── Hero banner / player ───────────────────── */
        .video-player-wrap { position:relative; border-radius:20px; overflow:hidden; background:#1e1b4b; box-shadow:0 18px 40px -18px rgba(49,46,129,.55); }
        .video-player-wrap.playing { aspect-ratio:16/9; background:#000; }
        /* The players sit underneath the banner until Play */
        .video-player-wrap > iframe,
        .video-player-wrap > video { position:absolute; inset:0; width:100%; height:100%; border:0; }
        .video-player-wrap > video { object-fit:contain; background:#000; }

        .watch-hero { position:relative; z-index:5; min-height:clamp(300px, 31vw, 360px); display:flex; align-items:center;
                      background:radial-gradient(circle at 85% 20%, rgba(167,139,250,.45), transparent 45%),
                                 linear-gradient(120deg, #1e1b4b 0%, #312e81 45%, #4f46e5 100%);
                      transition:opacity .35s ease; }
        .video-player-wrap.playing .watch-hero { position:absolute; inset:0; opacity:0; pointer-events:none; }
        .hero-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
        .hero-shade { position:absolute; inset:0;
                      background:linear-gradient(90deg, rgba(23,20,64,.97) 0%, rgba(36,31,100,.9) 38%, rgba(49,46,129,.45) 68%, rgba(49,46,129,.05) 100%); }
        .hero-content { position:relative; padding:2rem 2.25rem; color:#fff; max-width:min(100%, 640px); }
        .hero-badge { display:inline-flex; align-items:center; gap:.5rem; padding:.45rem 1rem; border-radius:999px;
                      background:rgba(99,102,241,.85); color:#fff; font-size:.92rem; font-weight:600; }
        .hero-title { margin:.9rem 0 .6rem; color:#fff; font-size:clamp(1.6rem, 3.3vw, 2.7rem); font-weight:800; line-height:1.12; letter-spacing:-.01em; }
        .hero-meta { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem 0; margin:0; font-size:.98rem; color:rgba(255,255,255,.92); }
        .hero-meta span { display:inline-flex; align-items:center; gap:.5rem; }
        .hero-meta span + span::before { content:""; width:1px; height:18px; background:rgba(255,255,255,.35); margin:0 .9rem; }
        .hero-meta i { opacity:.9; }
        .hero-scripture { margin:.55rem 0 0; font-size:.9rem; color:rgba(255,255,255,.8); }
        .hero-scripture i { margin-right:.4rem; }
        .hero-cta { display:flex; align-items:center; gap:1.25rem; margin-top:1.6rem; }
        .hero-play { width:78px; height:78px; flex-shrink:0; border-radius:50%; display:inline-flex; align-items:center; justify-content:center;
                     background:#4f46e5; border:4px solid #fff; color:#fff; font-size:1.65rem; cursor:pointer; text-decoration:none;
                     box-shadow:0 10px 30px rgba(79,70,229,.55); transition:transform .15s, background .15s; }
        .hero-play i.fa-play { margin-left:5px; }
        .hero-play:hover { transform:scale(1.06); background:#6366f1; color:#fff; }
        .hero-play:focus-visible { outline:3px solid #c7d2fe; outline-offset:3px; }
        .hero-play.static { cursor:default; background:rgba(99,102,241,.6); font-size:1.4rem; }
        .hero-play.static:hover { transform:none; }
        .hero-cta-sep { width:1px; height:60px; background:rgba(255,255,255,.35); }
        .hero-cta-text { display:flex; flex-direction:column; gap:.2rem; }
        .hero-cta-text strong { font-size:1.08rem; color:#fff; }
