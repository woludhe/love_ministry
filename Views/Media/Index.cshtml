@model ChurchMinistry.ViewModels.SermonIndexViewModel
@{ ViewData["Title"] = "Sermons & Media"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="page-header">
  <h1><i class="fas fa-video"></i> Sermons & Media</h1>
  @if (Model.LiveSermon != null) {
    <div class="live-alert"><span class="live-dot"></span> We are LIVE now! <a asp-action="Live" class="btn btn-sm btn-primary">Watch Live</a></div>
  }
</section>
<div class="container">
  <form method="get" class="filter-bar">
    <input name="search" value="@Model.SearchTerm" placeholder="Search sermons..." class="form-control" />
    <input name="speaker" value="@Model.Speaker" placeholder="Speaker..." class="form-control" />
    <input name="series" value="@Model.Series" placeholder="Series..." class="form-control" />
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
  </form>
  <div class="cards-grid">
    @foreach (var s in Model.Sermons) {
      <partial name="_SermonCard" model="s" />
    }
  </div>
  @if (Model.TotalPages > 1) {
    <div class="pagination">
      @for (int i = 1; i <= Model.TotalPages; i++) {
        <a href="?page=@i&search=@Model.SearchTerm&speaker=@Model.Speaker&series=@Model.Series" class="page-btn @(i==Model.Page?"active":"")">@i</a>
      }
    </div>
  }
</div>
