@model ChurchMinistry.ViewModels.SermonIndexViewModel
@{ ViewData["Title"] = "Sermons & Media"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="page-header">
  <h1><i class="fas fa-video"></i> Sermons & Media</h1>
  @if (Model.LiveSermon != null) {
    <div class="live-alert"><span class="live-dot"></span> We are LIVE now! <a asp-action="Live" class="btn btn-sm btn-primary">Watch Live</a></div>
  }
</section>
<div class="container">
  <form method="get" class="filter-bar">
    <input name="search" value="@Model.SearchTerm" placeholder="Search sermons..." class="form-control" />
    <input name="speaker" value="@Model.Speaker" placeholder="Speaker..." class="form-control" />
    <input name="series" value="@Model.Series" placeholder="Series..." class="form-control" />
    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
  </form>
  <div class="cards-grid">
    @foreach (var s in Model.Sermons) {
      <div class="card sermon-card">
        @if (!string.IsNullOrEmpty(s.ThumbnailUrl)) { <img src="@s.ThumbnailUrl" class="card-thumb" /> }
        else { <div class="card-thumb-placeholder"><i class="fas fa-play-circle fa-3x"></i></div> }
        <div class="card-body">
          @if (!string.IsNullOrEmpty(s.SeriesName)) { <span class="tag">@s.SeriesName</span> }
          <h3>@s.Title</h3>
          <p class="meta"><i class="fas fa-user"></i> @s.Speaker &nbsp; <i class="fas fa-calendar"></i> @s.SermonDate.ToString("dd MMM yyyy")</p>
          @if (!string.IsNullOrEmpty(s.ScriptureReference)) { <p class="scripture"><i class="fas fa-book-open"></i> @s.ScriptureReference</p> }
          <div class="card-actions">
            <a asp-action="Watch" asp-route-id="@s.Id" class="btn btn-primary btn-sm"><i class="fas fa-play"></i> Watch</a>
            @if (!string.IsNullOrEmpty(s.AudioUrl)) { <a href="@s.AudioUrl" class="btn btn-outline btn-sm"><i class="fas fa-headphones"></i> Audio</a> }
          </div>
          <p class="view-count"><i class="fas fa-eye"></i> @s.ViewCount views</p>
        </div>
      </div>
    }
  </div>
  @if (Model.TotalPages > 1) {
    <div class="pagination">
      @for (int i = 1; i <= Model.TotalPages; i++) {
        <a href="?page=@i&search=@Model.SearchTerm&speaker=@Model.Speaker&series=@Model.Series" class="page-btn @(i==Model.Page?"active":"")">@i</a>
      }
    </div>
  }
</div>
