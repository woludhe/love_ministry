@{
    ViewData["Title"] = "Live Chat";
    @if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
<section class="page-header"><h1><i class="fas fa-comment-dots"></i> Members Chat</h1></section>
<div class="chat-page">
    <div class="chat-rooms">
        <div class="room-btn active" data-room="general" onclick="joinRoom('general',this)"><i class="fas fa-globe"></i> General</div>
        <div class="room-btn" data-room="prayer" onclick="joinRoom('prayer',this)"><i class="fas fa-hands-praying"></i> Prayer</div>
        <div class="room-btn" data-room="youth" onclick="joinRoom('youth',this)"><i class="fas fa-users"></i> Youth</div>
        <div class="room-btn" data-room="announcements" onclick="joinRoom('announcements',this)"><i class="fas fa-bullhorn"></i> Announcements</div>
    </div>
    <div class="chat-container">
        <div class="chat-header"><span id="currentRoomLabel">General Chat</span></div>
        <div class="chat-messages" id="chatMessages"></div>
        <div class="chat-input-row">
            <input type="text" id="messageInput" class="form-control" placeholder="Type a message... (Enter to send)" />
            <button onclick="sendMessage()" class="btn btn-primary"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let currentRoom = 'general';
        const conn = new signalR.HubConnectionBuilder().withUrl('/chatHub').withAutomaticReconnect().build();

        conn.on('ReceiveMessage', m => {
            const box = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = 'chat-msg';
            div.innerHTML = `<img src="${m.senderPhoto}" class="avatar-xs"/><div class="msg-bubble"><strong>${m.senderName}</strong><p>${escHtml(m.message)}</p><small>${m.sentAt}</small></div>`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        });

        conn.on('SystemMessage', msg => {
            const box = document.getElementById('chatMessages');
            box.innerHTML += `<div class="system-msg">${msg}</div>`;
        });

        conn.start().then(() => conn.invoke('JoinRoom', currentRoom)).catch(console.error);

        function joinRoom(room, el) {
            conn.invoke('LeaveRoom', currentRoom);
            currentRoom = room;
            conn.invoke('JoinRoom', room);
            document.querySelectorAll('.room-btn').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('chatMessages').innerHTML = '';
            document.getElementById('currentRoomLabel').textContent = el.textContent.trim() + ' Chat';
        }

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const msg = input.value.trim();
            if (msg) { conn.invoke('SendMessage', currentRoom, msg); input.value = ''; }
        }

        document.getElementById('messageInput').addEventListener('keypress', e => { if (e.key === 'Enter') sendMessage(); });

        function escHtml(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }
    </script>
}
