@{
    ViewData["Title"] = "Community Forum";
    @if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    var posts = (List<ForumPost>)(ViewBag.Posts ?? new List<ForumPost>());
    var me = ViewBag.Me as Member;
    var selected = Context.Request.Query["category"].ToString();
}
@using ChurchMinistry.Models
@using ChurchMinistry.ViewModels
<section class="page-header">
    <h1><i class="fas fa-comments"></i> Community Forum</h1>
</section>
<div class="forum-page container">
    @Html.AntiForgeryToken()

    @* "What's on your mind?" — opens the New Post form *@
    <a asp-action="NewPost" class="fb-composer">
        <img src="@(me?.ProfilePhoto ?? "/images/avatar-default.png")" alt="" class="fb-avatar" />
        <span class="fb-composer-prompt">What's on your mind@(me != null ? $", {me.FirstName}" : "")?</span>
        <span class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Post</span>
    </a>

    <div class="category-filter">
        <a href="?" class="pill @(string.IsNullOrEmpty(selected) ? "active" : "")">All</a>
        @foreach (var cat in Enum.GetValues<ForumCategory>())
        {
            <a href="?category=@cat" class="pill @(selected == cat.ToString() ? "active" : "")">@ForumCategories.Label(cat)</a>
        }
    </div>

    @* 10 posts at a time; community.js loads the next 10 as the member nears the end *@
    <div class="fb-feed js-feed">
        @if (((PagerModel)ViewBag.Pager).Page > 1)
        {
            <a href="?@(string.IsNullOrEmpty(selected) ? "" : $"category={selected}")" class="fb-load-more"><i class="fas fa-arrow-up"></i> Back to the latest posts</a>
        }
        <partial name="_FeedPage" />
        @if (posts.Count == 0)
        {
            <div class="fb-empty"><p>No posts yet. Be the first to start a discussion!</p><a asp-action="NewPost" class="btn btn-primary">Create First Post</a></div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/community.js" asp-append-version="true"></script>
}
