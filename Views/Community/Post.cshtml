@model ChurchMinistry.Models.ForumPost
@using ChurchMinistry.ViewModels
@{
    ViewData["Title"] = Model.Title;
    @if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    var amenCounts = (Dictionary<int, int>)(ViewBag.AmenCounts ?? new Dictionary<int, int>());
    var myAmens = (HashSet<int>)(ViewBag.MyAmens ?? new HashSet<int>());
    var likeCounts = (Dictionary<int, int>)(ViewBag.LikeCounts ?? new Dictionary<int, int>());
    var myLikes = (HashSet<int>)(ViewBag.MyLikes ?? new HashSet<int>());
    var card = new ForumPostCardViewModel
    {
        Post = Model,
        ShowAllReplies = true,
        AmenCount = amenCounts.GetValueOrDefault(Model.Id),
        Amened = myAmens.Contains(Model.Id),
        LikeCount = likeCounts.GetValueOrDefault(Model.Id),
        Liked = myLikes.Contains(Model.Id),
        Me = ViewBag.Me as ChurchMinistry.Models.Member,
        ReturnUrl = Url.Action("Post", new { id = Model.Id }) ?? ""
    };
}

<div class="forum-page container">
    @Html.AntiForgeryToken()
    <a asp-action="Index" class="fb-back"><i class="fas fa-arrow-left"></i> Back to Community</a>

    <partial name="_PostCard" model="card" />

    @if (card.Me == null)
    {
        <div class="fb-empty">
            <p>Sign in to join the discussion</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> Sign In to Reply</a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/community.js" asp-append-version="true"></script>
}
