@model ChurchMinistry.ViewModels.MemberDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard"; Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
}
<div style="padding: 2rem;">
    <h1>
        Welcome back, @Model.Member.FirstName! 👋
        @if (Model.IsTopParticipant)
        {
            <span class="top-badge" title="One of the 10 most active members in the last 30 days"><i class="fas fa-medal"></i> Top Participant</span>
        }
    </h1>
    <partial name="_ProfileCompletion" model="(Model.ProfilePercent, new List<string>(), true)" />
    @if (Model.LiveSermon != null || Model.LiveMeetings.Any())
    {
        <div class="dash-live">
            <div class="live-badge"><span class="live-dot"></span> LIVE NOW</div>
            @if (Model.LiveSermon != null)
            {
                <div class="dash-live-item">
                    <div>
                        <strong>@Model.LiveSermon.Title</strong>
                        @if (!string.IsNullOrEmpty(Model.LiveSermon.Speaker))
                        {
                            <span class="meta">@Model.LiveSermon.Speaker</span>
                        }
                    </div>
                    <a asp-controller="Media" asp-action="Live" class="btn btn-primary btn-sm">
                        <i class="fas fa-play"></i> Watch Live
                    </a>
                </div>
            }
            @foreach (var room in Model.LiveMeetings)
            {
                <div class="dash-live-item">
                    <div>
                        <strong>@room.Title</strong>
                        <span class="meta">
                            @if (room.IsPublic)
                            {
                                <i class="fas fa-video"></i> @("Meeting")
                            }
                            else
                            {
                                <i class="fas fa-lock"></i> @("Private meeting · you're invited")
                            }
                        </span>
                    </div>
                    <a asp-controller="Meeting" asp-action="Room" asp-route-code="@room.RoomCode" class="btn btn-primary btn-sm">
                        <i class="fas fa-right-to-bracket"></i> Join
                    </a>
                </div>
            }
        </div>
    }
    <div class="kpi-grid">
        <div class="kpi-card kpi-purple">
            <div class="kpi-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Attendance This Month</span>
                <span class="kpi-value">@Model.AttendanceThisMonth</span>
                <span class="kpi-sub">
                    <i class="fas fa-church"></i> @Model.PhysicalAttendanceThisMonth in person ·
                    <i class="fas fa-laptop"></i> @Model.VirtualAttendanceThisMonth online
                </span>
            </div>
        </div>
        <a asp-controller="Devotionals" asp-action="Index" asp-route-unread="@(Model.DevotionsUnread > 0 ? "true" : null)"
           class="kpi-card kpi-blue kpi-link"
           title="@(Model.DevotionsUnread > 0 ? "Read your unread devotions" : "Open devotions")">
            <div class="kpi-icon"><i class="fas fa-book-bible"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Devotions Unread</span>
                <span class="kpi-value">@Model.DevotionsUnread <small class="kpi-of">/ @Model.DevotionsTotal</small></span>
                <span class="kpi-sub">
                    @(Model.DevotionsTotal == 0 ? "None published yet"
                        : Model.DevotionsUnread == 0 ? "All caught up" : $"of {Model.DevotionsTotal} devotions")
                </span>
            </div>
        </a>
        @* <div class="kpi-card kpi-green">
            <div class="kpi-icon"><i class="fas fa-hand-holding-heart"></i></div>
            <div class="kpi-info"><span class="kpi-label">Given This Year</span><span class="kpi-value">UGX @Model.TotalGivingThisYear.ToString("N0")</span></div>
        </div> *@
        <div class="kpi-card kpi-amber">
            <div class="kpi-icon"><i class="fas fa-hands-praying"></i></div>
            <div class="kpi-info"><span class="kpi-label">Prayer Requests</span><span class="kpi-value">@Model.PrayerRequestsCount</span></div>
        </div>
    </div>
    @if (Model.Notifications.Any())
    {
        <div class="notifications-box">
            <h3><i class="fas fa-bell"></i> Notifications</h3>
            @foreach (var n in Model.Notifications)
            {
                <div class="notif-item"><strong>@n.Title</strong><p>@n.Message</p><small>@n.CreatedAt.ToString("dd MMM, HH:mm")</small></div>
            }
        </div>
    }
    <div class="section-header"><h2>Recent Sermons</h2><a asp-controller="Media" asp-action="Index" class="btn btn-outline btn-sm">View All</a></div>
    <div class="cards-grid">
        @foreach (var s in Model.RecentSermons)
        {
            <div class="card sermon-card">
                <div class="card-body">
                    <h3>@s.Title</h3>
                    <p class="meta">@s.Speaker · @s.SermonDate.ToString("dd MMM yyyy")</p>
                    <a asp-controller="Media" asp-action="Watch" asp-route-id="@s.Id" class="btn btn-primary btn-sm">@(!s.IsLive && s.SermonDate > DateTime.UtcNow ? "View" : "Watch")</a>
                </div>
            </div>
        }
    </div>
    <div class="section-header"><h2>Upcoming Events</h2></div>
    <div class="events-list-row">
        @foreach (var ev in Model.UpcomingEvents)
        {
            <div class="event-item">
                <div class="event-date"><span class="day">@ev.StartDate.Day</span><span class="month">@ev.StartDate.ToString("MMM")</span></div>
                <div class="event-info">
                    <h3>@ev.Title</h3><span>@ev.StartDate.ToString("h:mm tt")</span>
                    <span>@ev.Location</span>
                </div>
                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline btn-sm">Details</a>
            </div>
        }
    </div>
</div>
