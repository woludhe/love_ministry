@model ChurchMinistry.ViewModels.MemberProfileViewModel
@{
    var canManage = ViewBag.CanManage as bool? == true;
    ViewData["Title"] = canManage ? "Edit Member" : "My Profile"; Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
    var isActive = Model.Status == ChurchMinistry.Models.MemberStatus.Active;
}
<section class="page-header">
    <h1>@(canManage ? $"Edit Member: {Model.FirstName} {Model.LastName}" : "My Profile")</h1>
    @if (canManage)
    {
        <p><span class="member-status-badge @(isActive ? "status-active" : "status-inactive")">@Model.Status</span></p>
    }
</section>
<div class="form-page">
    @if (!canManage)
    {
        <partial name="_ProfileCompletion" model="(Model.ProfilePercent, Model.ProfileMissing, false)" />
    }
    else if (ViewBag.Activity is ChurchMinistry.ViewModels.MemberActivitySummary activity)
    {
        <partial name="_MemberActivityPanel" model="activity" />
    }
    <form asp-action="Profile" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="profile-photo-section">
            <img src="@(Model.ExistingPhoto ?? "/images/avatar-default.png")" id="photoPreview" class="profile-photo-preview" />
            <label class="btn btn-outline btn-sm">
                <i class="fas fa-camera"></i> Change Photo
                <input type="file" asp-for="ProfilePhotoFile" accept="image/*" hidden onchange="openPhotoCropper(this)" />
            </label>
        </div>
        <partial name="_GroupIcons" model="Model.Groups" />
        <div class="form-row">
            <div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" /></div>
            <div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" /></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" readonly /></div>
            <div class="form-group"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" class="form-control" type="date" /></div>
            <div class="form-group"><label asp-for="Gender"></label><select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<ChurchMinistry.Models.Gender>()"></select></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label asp-for="MaritalStatus"></label><select asp-for="MaritalStatus" class="form-control" asp-items="Html.GetEnumSelectList<ChurchMinistry.Models.MaritalStatus>()"></select></div>
            <div class="form-group"><label asp-for="Occupation"></label><input asp-for="Occupation" class="form-control" /></div>
        </div>
        <div class="form-group"><label asp-for="Address"></label><input asp-for="Address" class="form-control" /></div>
        <div class="form-row">
            <div class="form-group"><label asp-for="City"></label><input asp-for="City" class="form-control" /></div>
            <div class="form-group"><label asp-for="Country"></label><input asp-for="Country" class="form-control" /></div>
        </div>
        <div class="form-row">
            <div class="form-group"><label asp-for="EmergencyContact">Emergency Contact</label><input asp-for="EmergencyContact" class="form-control" /></div>
            <div class="form-group"><label asp-for="EmergencyPhone">Emergency Phone</label><input asp-for="EmergencyPhone" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        @if (canManage)
        {
            <a asp-controller="Admin" asp-action="Members" class="btn btn-outline">Cancel</a>
        }
        else
        {
            <a asp-action="Dashboard" class="btn btn-outline">Cancel</a>
        }
    </form>
    @if (!canManage)
    {
        <p class="profile-security">
            <i class="fas fa-key"></i> Want a new password?
            <a asp-controller="Account" asp-action="ChangePassword">Change password</a>
        </p>
    }

    @if (canManage)
    {
        <div class="member-manage">
            <h3><i class="fas fa-user-gear"></i> Manage Member</h3>

            <div class="member-manage-row">
                <div>
                    <strong>@(isActive ? "Deactivate member" : "Reactivate member")</strong>
                    <p>@(isActive
                        ? "Marks the member Inactive and stops them signing in. Their records are kept and you can reactivate them at any time."
                        : "Marks the member Active again and lets them sign in.")</p>
                </div>
                <form method="post" action="/profile/@Model.Id/status"
                      data-confirm="@(isActive ? "Deactivate" : "Reactivate") @Model.FirstName @Model.LastName?"
                      onsubmit="return confirm(this.dataset.confirm)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="active" value="@(isActive ? "false" : "true")" />
                    <button type="submit" class="btn @(isActive ? "btn-warning-outline" : "btn-primary")">
                        <i class="fas @(isActive ? "fa-user-slash" : "fa-user-check")"></i>
                        @(isActive ? "Deactivate" : "Reactivate")
                    </button>
                </form>
            </div>

            <div class="member-manage-row member-manage-danger">
                <div>
                    <strong>Delete member</strong>
                    <p>Permanently removes the member and their login. Giving and prayer records are kept without their name.
                       This can't be undone.</p>
                </div>
                <form method="post" action="/profile/@Model.Id/delete"
                      data-confirm="Permanently delete @Model.FirstName @Model.LastName and their login? This cannot be undone."
                      onsubmit="return confirm(this.dataset.confirm)">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger-solid">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<style>
.member-status-badge { display:inline-block;padding:.2rem .75rem;border-radius:100px;font-size:.8rem;font-weight:700; }
.status-active       { background:#d1fae5;color:#065f46; }
.status-inactive     { background:#fee2e2;color:#991b1b; }
.member-manage       { margin-top:2.5rem;border:1.5px solid var(--border);border-radius:var(--radius);
                       background:var(--white);padding:1.25rem; }
.member-manage h3    { font-size:1rem;margin-bottom:.75rem; }
.member-manage h3 i  { color:var(--purple); }
.member-manage-row   { display:flex;justify-content:space-between;align-items:center;gap:1rem;
                       padding:.9rem 0;border-top:1px solid var(--border);flex-wrap:wrap; }
.member-manage-row p { font-size:.82rem;color:var(--text-s);margin:.2rem 0 0;max-width:460px; }
.member-manage-danger strong { color:var(--coral); }
.btn-warning-outline { background:transparent;color:#b45309;border:1.5px solid #f59e0b; }
.btn-warning-outline:hover { background:#fef3c7; }
.btn-danger-solid    { background:var(--coral);color:white;border:none; }
.btn-danger-solid:hover { background:#dc2626;color:white; }
</style>
@section Scripts {
    <partial name="_PhotoCropper" />
}
