// ── Reflow (spotlight aware) ──────────────────────────────
// Hidden off-screen container for non-spotlighted tiles
// Using display:none on tiles destroys their video layout; moving them
// to a detached container keeps srcObject alive
const _hiddenPool = document.createElement('div');
_hiddenPool.style.cssText = 'position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden';
document.body.appendChild(_hiddenPool);

function reflow(){
  const grid = document.getElementById('videoGrid');
  if(!grid) return;

  if(spotlightId){
    // Move ALL tiles to hidden pool first (preserves video streams)
    Array.from(grid.querySelectorAll('.video-tile')).forEach(t => {
      t.classList.remove('spotlighted');
      _hiddenPool.appendChild(t);
    });

    // Move spotlighted tile back to grid
    const sp = document.getElementById(`tile-${spotlightId}`);
    if(sp){
      sp.classList.add('spotlighted');
      grid.appendChild(sp);
      // Resume video if paused after DOM move
      const vid = sp.querySelector('video');
      if(vid && vid.paused && vid.srcObject) vid.play().catch(()=>{});
    }
    grid.className = 'video-grid solo spotlight-mode';

  } else {
    // Move all tiles from hidden pool back to grid
    Array.from(_hiddenPool.querySelectorAll('.video-tile')).forEach(t => {
      t.classList.remove('spotlighted');
      grid.appendChild(t);
      const vid = t.querySelector('video');
      if(vid && vid.paused && vid.srcObject) vid.play().catch(()=>{});
    });
    const n = grid.querySelectorAll('.video-tile').length;
    grid.className = 'video-grid '+(n<=1?'solo':n===2?'duo':n===3?'trio':n<=4?'quad':'many');
    const cols = Math.ceil(Math.sqrt(n));
    grid.style.setProperty('--cols', cols);
    grid.style.setProperty('--rows', Math.ceil(n/cols));
  }
  refreshSpotlightBtns();
}

