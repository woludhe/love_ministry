function appendChatMessage({senderName,message,type,sentAt,connectionId,isOwn:own,source},fromHistory=false){
  const box=document.getElementById('chatMessages');
  const isOwn=own===true||(!!connectionId&&connectionId===conn.connectionId), isPrayer=type==='prayer';
  const div=document.createElement('div'); div.className=`chat-msg-meet ${isOwn?'own':''}`;
  const tag=source==='live'?' <span class="msg-src" title="Sent from the Live page">Live</span>':'';
  div.innerHTML=`${!isOwn?`<div class="msg-sender">${escHtml(senderName)}${tag}</div>`:''}
    <div class="${isPrayer?'msg-prayer':'msg-bubble-meet'}">${escHtml(message)}</div>
    <div class="msg-time">${fmtChatTime(sentAt)}</div>`;
  box.appendChild(div); box.scrollTop=box.scrollHeight;
  if(!fromHistory&&!isOwn) flashChatIcon();
  if(!fromHistory&&!isOwn&&(currentTab!=='chat'||!sidebarOpen)){unreadChat++;const b=document.getElementById('chatCount');b.style.display='inline';b.textContent=unreadChat;}
