@model ChurchMinistry.ViewModels.MeetingRoomViewModel
@{
    ViewData["Title"] = Model.Room.Title;
    Layout = null;
    bool isAdminPastor = User.IsInRole("Admin") || User.IsInRole("Pastor");
    bool isHost        = Model.IsHost || isAdminPastor;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>@Model.Room.Title - Apostle Enock Makoko</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:      #0f0f13;
      --surface: #1a1a24;
      --card:    #22222e;
      --border:  #2e2e3e;
      --purple:  #7c6ff7;
      --purple-d:#6355e8;
      --green:   #22c55e;
      --red:     #ef4444;
      --amber:   #f59e0b;
      --text:    #f1f0fb;
      --text-s:  #8b8aa6;
      --radius:  12px;
    }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text);
           height: 100vh; height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }

    /* ── Top bar ── */
    .meet-topbar { display: flex; align-items: center; justify-content: space-between;
                   padding: .75rem 1.25rem; background: var(--surface);
                   border-bottom: 1px solid var(--border); flex-shrink: 0; z-index: 10; gap:.75rem; }
    .meet-title  { display: flex; align-items: center; gap: .75rem; flex:1; min-width:0; }
    .meet-title h1 { font-size: 1rem; font-weight: 600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .meet-badge  { background: var(--purple); color: white; padding: .2rem .6rem;
                   border-radius: 100px; font-size: .72rem; font-weight: 700; flex-shrink:0; }
    .meet-code   { background: var(--card); border: 1px solid var(--border); border-radius: 8px;
                   padding: .3rem .75rem; font-size: .78rem; font-family: monospace;
                   color: var(--text-s); cursor: pointer; transition: all .15s; }
    .meet-code:hover { border-color: var(--purple); color: var(--purple); }
    .timer       { font-size: .85rem; color: var(--text-s); font-variant-numeric: tabular-nums; white-space:nowrap; }

    /* ── LIVE indicator ── */
    .live-indicator { display:flex; align-items:center; gap:.4rem;
                      background:rgba(239,68,68,.12); border:1px solid rgba(239,68,68,.3);
                      border-radius:100px; padding:.22rem .7rem; flex-shrink:0; }
    .live-dot-pulse { width:8px; height:8px; border-radius:50%; background:var(--red);
                      animation:livePulse 1.3s ease infinite; }
    @@keyframes livePulse { 0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.6)} 70%{box-shadow:0 0 0 6px rgba(239,68,68,0)} }
    .live-text    { font-size:.7rem; font-weight:800; letter-spacing:.1em; color:var(--red); }

    /* ── Recording indicator (host) ── */
    .rec-indicator { display:flex; align-items:center; gap:.4rem; border:1px solid rgba(239,68,68,.3);
                     border-radius:100px; padding:.15rem .3rem .15rem .65rem; flex-shrink:0;
                     font-size:.72rem; font-weight:700; color:var(--red); font-variant-numeric:tabular-nums; }
    .rec-indicator .rec-dot { width:8px; height:8px; border-radius:50%; background:var(--red); }
    .rec-indicator.paused { color:var(--text-s); border-color:var(--border); }
    .rec-indicator.paused .rec-dot { background:var(--text-s); }
    .rec-indicator button { background:none; border:none; color:inherit; cursor:pointer;
                            padding:.15rem .35rem; border-radius:100px; font-size:.7rem; }
    .rec-indicator button:hover { background:rgba(239,68,68,.15); }

    /* ── Count chips ── */
    .count-chips  { display:flex; align-items:center; gap:.4rem; flex-shrink:0; }
    .count-chip   { display:inline-flex; align-items:center; gap:.3rem; font-size:.74rem;
                    font-weight:600; color:var(--text-s); background:var(--card);
                    border:1px solid var(--border); border-radius:100px; padding:.2rem .6rem; }
    .count-chip.viewers i { color:var(--green); font-size:.68rem; }
    .count-chip.members i { color:var(--purple); font-size:.68rem; }

    /* ── Main layout ── */
    .meet-body   { display: flex; flex: 1; overflow: hidden; }
    .meet-main   { flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }

    /* ── Video grid ── */
    .video-grid  { flex: 1; min-height: 0; display: grid; gap: 6px; padding: 10px; overflow: hidden;
                   grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-content: center; }
    .video-grid.solo   { grid-template-columns: 1fr; }
    .video-grid.duo    { grid-template-columns: 1fr 1fr; }
    .video-grid.trio   { grid-template-columns: repeat(3, 1fr); }
    .video-grid.quad   { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); }
    /* 5+ tiles: columns/rows set by reflow() so every tile fits without clipping */
    .video-grid.many   { grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
                         grid-template-rows: repeat(var(--rows, 2), minmax(0, 1fr)); align-content: stretch; }
    .video-grid.many .video-tile { aspect-ratio: auto; min-height: 0; }
    .video-grid.spotlight-mode { grid-template-columns: 1fr; }

    .video-tile  { position: relative; background: var(--card); border-radius: var(--radius);
                   overflow: hidden; border: 2px solid transparent; aspect-ratio: 16/9;
                   display: flex; align-items: center; justify-content: center; transition: border-color .2s; }
    .video-tile.speaking    { border-color: var(--green); }
    .video-tile.screenshare { border-color: var(--purple); grid-column: 1/-1; }
    .video-tile.spotlighted { border-color: var(--purple) !important; }
    .video-tile video { width: 100%; height: 100%; object-fit: cover; }
    .video-tile.video-off video { display: none; }
    .tile-avatar { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
    .tile-avatar img { width: 72px; height: 72px; border-radius: 50%; border: 3px solid var(--purple); object-fit: cover; }
    .tile-avatar span { font-size: .85rem; font-weight: 600; color: var(--text-s); }
    .video-off .tile-avatar { display: flex; }
    .video-on  .tile-avatar { display: none; }
    .tile-name   { position: absolute; bottom: .5rem; left: .6rem; background: rgba(0,0,0,.6);
                   backdrop-filter: blur(4px); padding: .2rem .6rem; border-radius: 6px;
                   font-size: .78rem; font-weight: 600; display: flex; align-items: center; gap: .35rem; }
    .tile-badges { position: absolute; top: .5rem; right: .5rem; display: flex; gap: .3rem; }
    .tile-badge  { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center;
                   justify-content: center; font-size: .7rem; backdrop-filter: blur(4px); }
    .badge-mute  { background: rgba(239,68,68,.8); }
    .badge-hand  { background: rgba(245,158,11,.8); }
    .badge-host  { background: rgba(124,111,247,.8); }
    .local-tile  { border-color: var(--purple-d) !important; }
    #screenVideo { display: none; }

    /* ── Spotlight label on stage ── */
    #spotlightLabel { position:absolute; top:.75rem; left:.75rem; z-index:10;
                      align-items:center; gap:.4rem;
                      background:rgba(124,111,247,.9); backdrop-filter:blur(6px);
                      padding:.25rem .8rem; border-radius:100px;
                      font-size:.75rem; font-weight:700; pointer-events:none; }

    /* ── Background music name (top right; the spotlight label is top left) ── */
    #musicChip { position:absolute; top:.75rem; right:.75rem; z-index:10; max-width:min(60%, 300px);
                 align-items:center; gap:.4rem; padding:.25rem .8rem; border-radius:100px;
                 background:rgba(0,0,0,.6); backdrop-filter:blur(6px); color:#fff;
                 font-size:.75rem; font-weight:600; pointer-events:none; }
    #musicChip i { color:#a5b4fc; flex-shrink:0; }
    /* Audio only mode: covers the video grid; spotlight/music labels and verses stay on top */
    #audioOnlyStage { position:absolute; top:0; left:0; right:0; bottom:var(--controls-h, 80px); z-index:5;
                      display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem;
                      overflow:hidden; background:radial-gradient(circle at 50% 40%, #312e81, var(--bg) 70%); }
    .ao-poster-bg { position:absolute; inset:-20px; background-size:cover; background-position:center;
                    filter:blur(24px) brightness(.4); }
    .ao-poster { position:relative; max-width:min(60%, 320px); max-height:55%; border-radius:14px;
                 box-shadow:0 18px 50px rgba(0,0,0,.55); object-fit:cover; }
    .ao-poster-icon { position:relative; width:96px; height:96px; border-radius:50%; display:flex;
                      align-items:center; justify-content:center; font-size:2.4rem; color:#fff;
                      background:rgba(99,102,241,.85); }
    .ao-wave { position:relative; width:min(80%, 320px); height:56px; }
    #musicChipTitle { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

    /* ── Verse overlay ── */
    .meet-main { position: relative; }
    #verseOverlay { animation: verseIn .5s ease; }
    @@keyframes verseIn {
        from { opacity:0; transform:translateY(6px); }
        to   { opacity:1; transform:translateY(0); }
    }

    /* ── Controls bar ── */
    /* Always on screen: never wraps off the bottom, scrolls sideways if it can't fit,
       and clears phone home-indicator / notch areas. */
    /* Centred by the auto margins on the first and last buttons, not justify-content: when the buttons
       overflow, justify-content: center would push the first ones off the left edge where they can't be scrolled to */
    .controls    { display: flex; align-items: center; justify-content: flex-start; gap: .75rem;
                   padding: .85rem calc(1.25rem + env(safe-area-inset-right)) calc(1.4rem + env(safe-area-inset-bottom)) calc(1.25rem + env(safe-area-inset-left));
                   background: var(--surface); border-top: 1px solid var(--border);
                   flex-shrink: 0; flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden;
                   position: relative; z-index: 30; scrollbar-width: none; }
    .controls::-webkit-scrollbar { display: none; }
    .controls > :first-child { margin-left: auto; }
    .controls > :last-child  { margin-right: auto; }
    .ctrl-btn    { width: 50px; height: 50px; border-radius: 14px; border: none; cursor: pointer;
                   display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
                   transition: all .15s; position: relative; flex-shrink: 0; }
    .ctrl-btn span { position: absolute; bottom: -18px; font-size: .65rem; white-space: nowrap;
                     color: var(--text-s); font-weight: 500; left:50%; transform:translateX(-50%); }
    .ctrl-default { background: var(--card); color: var(--text); }
    .ctrl-default:hover { background: var(--border); }
    .ctrl-danger  { background: var(--red) !important; color: white; }
    .ctrl-active  { background: var(--purple) !important; color: white; }
    /* The chat icon flashes twice for a new message */
    @@keyframes chat-flash { 50% { color: #f59e0b; text-shadow: 0 0 10px #f59e0b; } }
    .chat-flash { animation: chat-flash .45s ease-in-out 2; }
    .ctrl-end     { background: var(--red); color: white; border-radius: 14px;
                    padding: .65rem 1.5rem; font-size: .9rem; font-weight: 700;
                    display: flex; align-items: center; gap: .4rem; border: none; cursor: pointer;
                    flex-shrink: 0; white-space: nowrap; }
    .ctrl-end:hover { background: #dc2626; }
    .controls-spacer { flex: 1; }

    /* ── Sidebar ── */
    .meet-sidebar { width: 320px; background: var(--surface); border-left: 1px solid var(--border);
                    display: flex; flex-direction: column; flex-shrink: 0; transition: width .2s; }
    .meet-sidebar.closed { width: 0; overflow: hidden; }
    .sidebar-tabs { display: flex; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    .sidebar-tab  { flex: 1; padding: .65rem; text-align: center; font-size: .82rem; font-weight: 600;
                    cursor: pointer; color: var(--text-s); border-bottom: 2px solid transparent;
                    transition: all .15s; background: none; border-top: none; border-left: none; border-right: none; }
    .sidebar-tab.active { color: var(--purple); border-bottom-color: var(--purple); }
    .sidebar-tab .badge-count { background: var(--red); color: white; border-radius: 100px;
                                padding: .1rem .4rem; font-size: .65rem; margin-left: .2rem; }
    .panel       { display: none; flex-direction: column; flex: 1; overflow: hidden; }
    .panel.active{ display: flex; }
    .panel-body  { flex: 1; overflow-y: auto; padding: .75rem; }
    .participant-item { display: flex; align-items: center; gap: .6rem; padding: .5rem .6rem;
                        border-radius: 8px; transition: background .15s; }
    .participant-item:hover { background: var(--card); }
    .participant-item img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); }
    .participant-name { flex: 1; font-size: .88rem; font-weight: 500; }
    .participant-badges { display: flex; align-items:center; gap: .3rem; font-size: .72rem; color: var(--text-s); }

    /* Spotlight button in participant list */
    .spotlight-person-btn { background:none; border:none; color:var(--text-s); cursor:pointer;
                             font-size:.8rem; padding:.2rem .3rem; border-radius:5px; transition:all .15s; }
    .spotlight-person-btn:hover { color:var(--amber); }
    .spotlight-person-btn.active { color:var(--amber); }

    .waiting-section { padding: .5rem .75rem; background: rgba(245,158,11,.1);
                       border: 1px solid rgba(245,158,11,.3); border-radius: 8px; margin: .5rem; }
    .waiting-section h4 { font-size: .8rem; color: var(--amber); margin-bottom: .5rem; }
    .waiting-item { display: flex; align-items: center; justify-content: space-between; font-size: .82rem; padding: .3rem 0; }
    .admit-btn { background: var(--green); color: white; border: none; border-radius: 6px;
                 padding: .25rem .6rem; font-size: .72rem; cursor: pointer; font-weight: 600; }
    .chat-messages { flex: 1; overflow-y: auto; padding: .75rem; display: flex; flex-direction: column; gap: .6rem; }
    .chat-msg-meet { display: flex; flex-direction: column; gap: .1rem; }
    .chat-msg-meet.own { align-items: flex-end; }
    .msg-sender { font-size: .72rem; color: var(--text-s); margin-bottom: .1rem; }
    .msg-bubble-meet { background: var(--card); border-radius: 10px; padding: .45rem .7rem;
                       font-size: .85rem; max-width: 85%; line-height: 1.5; }
    .chat-msg-meet.own .msg-bubble-meet { background: var(--purple-d); }
    .msg-prayer { background: rgba(124,111,247,.15) !important; border: 1px solid rgba(124,111,247,.3);
                  border-radius: 10px; padding: .5rem .7rem; font-size: .82rem; font-style: italic; }
    .msg-system { text-align: center; font-size: .75rem; color: var(--text-s); }
    .msg-time   { font-size: .65rem; color: var(--text-s); margin-top: .1rem; }
    .msg-src    { display: inline-block; margin-left: .3rem; padding: 0 .35rem; border-radius: 4px;
                  background: rgba(239,68,68,.15); color: #f87171; font-size: .6rem; font-weight: 700;
                  text-transform: uppercase; letter-spacing: .03em; vertical-align: middle; }
    .chat-input-area { padding: .75rem; border-top: 1px solid var(--border); display: flex;
                       flex-direction: column; gap: .5rem; flex-shrink: 0; }
    .chat-input-row { display: flex; gap: .4rem; }
    .chat-input-meet { flex: 1; background: var(--card); border: 1px solid var(--border);
                       border-radius: 10px; padding: .5rem .75rem; color: var(--text);
                       font-family: inherit; font-size: .88rem; resize: none; outline: none; transition: border-color .15s; }
    .chat-input-meet:focus { border-color: var(--purple); }
    .chat-send-btn { width: 38px; height: 38px; background: var(--purple); border: none;
                     border-radius: 10px; color: white; cursor: pointer; font-size: .9rem;
                     display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .prayer-btn { background: none; border: 1px solid var(--border); border-radius: 8px;
                  padding: .35rem .7rem; font-size: .78rem; color: var(--text-s); cursor: pointer;
                  display: flex; align-items: center; gap: .3rem; transition: all .15s; }
    .prayer-btn:hover { border-color: var(--purple); color: var(--purple); }

    /* ── Reactions ── */
    .reactions-bar { position: absolute; bottom: calc(var(--controls-h, 80px) + 10px); left: 50%; transform: translateX(-50%);
                     display: flex; gap: .4rem; background: rgba(26,26,36,.9); backdrop-filter: blur(8px);
                     border: 1px solid var(--border); border-radius: 100px; padding: .4rem .7rem;
                     opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 20; }
    .reactions-bar.visible { opacity: 1; pointer-events: all; }
    .reaction-emoji { font-size: 1.4rem; cursor: pointer; transition: transform .15s; padding: .1rem .2rem;
                      border-radius: 6px; border: none; background: none; }
    .reaction-emoji:hover { transform: scale(1.35); }
    .floating-reaction { position: fixed; font-size: 2rem; pointer-events: none; z-index: 999;
                         animation: floatUp 2.5s ease-out forwards; }
    @@keyframes floatUp { 0%{opacity:1;transform:translateY(0) scale(1)} 100%{opacity:0;transform:translateY(-200px) scale(1.4)} }

    /* ── Spotlight context menu ── */
    .spotlight-ctx-menu { position: fixed; z-index: 9999; background: var(--surface);
                          border: 1px solid var(--border); border-radius: 10px;
                          overflow: hidden; min-width: 185px; box-shadow: 0 8px 24px rgba(0,0,0,.6); display:none; }
    .spm-header { padding: .4rem .85rem; font-size: .68rem; font-weight: 700; color: var(--text-s);
                  border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: .05em; }
    .spotlight-ctx-menu button { display: flex; align-items: center; gap: .55rem; width: 100%;
                                  padding: .55rem .85rem; background: none; border: none;
                                  color: var(--text); font-size: .82rem; cursor: pointer; font-family: inherit; text-align: left; }
    .spotlight-ctx-menu button:hover { background: var(--card); }
    .spm-divider { height: 1px; background: var(--border); }

    /* ── Waiting / ended overlays ── */
    .waiting-overlay { position: fixed; inset: 0; background: var(--bg); z-index: 100;
                       display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; }
    .waiting-overlay h2 { font-size: 1.5rem; font-weight: 700; }
    .waiting-overlay p { color: var(--text-s); }
    .waiting-spinner { width: 56px; height: 56px; border: 3px solid var(--border);
                       border-top-color: var(--purple); border-radius: 50%; animation: spin 1s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .ended-overlay { position: fixed; inset: 0; background: var(--bg); z-index: 200;
                     display: none; flex-direction: column; align-items: center; justify-content: center;
                     gap: 1.5rem; text-align: center; padding: 2rem; }
    .ended-overlay h2 { font-size: 2rem; font-weight: 800; }
    .ended-overlay p  { color: var(--text-s); max-width: 400px; }

    /* ── Toast ── */
    .toast-container { position: fixed; top: 80px; right: 1rem; z-index: 500; display: flex; flex-direction: column; gap: .5rem; }
    .toast { background: var(--card); border: 1px solid var(--border); border-radius: 10px;
             padding: .65rem 1rem; font-size: .85rem; display: flex; align-items: center; gap: .5rem;
             animation: slideInRight .3s ease; max-width: 280px; }
    @@keyframes slideInRight { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:translateX(0)} }

    ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

    @@media (max-width: 768px) {
      /* Overlay sidebar stops above the controls bar so Chat/People/Leave stay reachable */
      .meet-sidebar { position: fixed; right: 0; top: 0; bottom: var(--controls-h, 80px); z-index: 50;
                      width: min(320px, 100vw); box-shadow: -4px 0 24px rgba(0,0,0,.4); }
      .meet-sidebar.closed { width: 0; }
      .meet-topbar { padding: .6rem .85rem; }
      .controls { gap: .4rem; padding-left: calc(.6rem + env(safe-area-inset-left));
                  padding-right: calc(.6rem + env(safe-area-inset-right)); }
      .controls-spacer { display: none; }
      .ctrl-btn { width: 44px; height: 44px; font-size: 1rem; border-radius: 12px; }
      .ctrl-btn span { font-size: .6rem; }
      .ctrl-end { padding: .6rem .9rem; font-size: .85rem; border-radius: 12px; }
      .count-chips { display: none; }
      .video-grid.many { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none;
                         grid-auto-rows: auto; align-content: start; overflow-y: auto; }
      .video-grid.many .video-tile { aspect-ratio: 4/3; }
    }
    /* Phones in landscape / short windows: shrink chrome so video + controls both fit */
    @@media (max-height: 500px) {
      .meet-topbar { padding: .35rem .85rem; }
      .controls { padding-top: .45rem; padding-bottom: calc(.45rem + env(safe-area-inset-bottom)); }
      .ctrl-btn { width: 40px; height: 40px; }
      .ctrl-btn span { display: none; }
      .ctrl-end { padding: .5rem .85rem; }
    }
    /* Phones held upright: Leave / End is just the red button with its icon, to make room for the others */
    @@media (max-width: 768px) and (orientation: portrait) {
      .ctrl-end { width: 44px; height: 44px; padding: 0; justify-content: center; font-size: 1rem; }
      .ctrl-end-label { display: none; }
      .ctrl-people-via-chat { display: none; }
    }
  </style>
</head>
<body>

<div class="waiting-overlay" id="waitingOverlay" style="display:none">
  <div class="waiting-spinner"></div>
  <h2>Waiting Room</h2>
  <p>Please wait — the host will let you in shortly.</p>
  <p style="font-size:.85rem;color:#5b5a7e">Room: <strong style="color:var(--purple)">@Model.Room.RoomCode</strong></p>
</div>

<div class="ended-overlay" id="endedOverlay">
  <div style="font-size:3rem">🙏</div>
  <h2>Meeting Ended</h2>
  <p>Thank you for joining <strong>@Model.Room.Title</strong>. God bless you!</p>
  <a href="/Meeting" style="background:var(--purple);color:white;padding:.75rem 2rem;border-radius:10px;font-weight:700;text-decoration:none;margin-top:.5rem">Back to Meetings</a>
</div>

<div class="toast-container" id="toastContainer"></div>

<div class="reactions-bar" id="reactionsBar">
  @foreach (var emoji in new[]{"🙏","❤️","🔥","👏","✝️","🎉","😭","🙌"})
  { <button class="reaction-emoji" onclick="sendReaction('@emoji')">@emoji</button> }
</div>

<div class="spotlight-ctx-menu" id="spotlightCtxMenu"></div>

<!-- Top bar -->
<div class="meet-topbar">
  <div class="meet-title">
    <span class="meet-badge">@Model.Room.MeetingType</span>
    <h1>@Model.Room.Title</h1>
    @* LIVE only while this room is streamed to the Live page as a live sermon; updated by SermonLiveChanged *@
    <div class="live-indicator" id="liveBadge" title="Being streamed live on the Live page"
         style="@(ViewBag.SermonIsLive as bool? == true ? "" : "display:none")">
      <span class="live-dot-pulse"></span>
      <span class="live-text">LIVE</span>
    </div>
    @if (isHost)
    {
      <div class="rec-indicator" id="recBadge" style="display:none" title="The meeting's audio is being recorded for the sermon">
        <span class="rec-dot"></span><span id="recTime">REC 00:00</span>
        <button type="button" id="recPauseBtn" onclick="toggleRecPause()" title="Pause recording"><i class="fas fa-pause"></i></button>
      </div>
    }
  </div>
  <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
    <div class="count-chips">
      <div class="count-chip viewers" title="Total viewers">
        <i class="fas fa-eye"></i><span id="viewerCount">0</span>
      </div>
      <div class="count-chip members" title="Participants">
        <i class="fas fa-users"></i><span id="memberCount">0</span>
      </div>
    </div>
    <span class="timer" id="meetTimer">00:00</span>
    <button class="meet-code" onclick="copyCode()"><i class="fas fa-copy"></i> @Model.Room.RoomCode</button>
    <a href="/Meeting" style="color:var(--text-s);font-size:.85rem"><i class="fas fa-times"></i></a>
  </div>
</div>

<!-- Body -->
<div class="meet-body">
  <div class="meet-main">
    <div class="video-grid solo" id="videoGrid"></div>

    <!-- Audio only mode: the sermon poster with a waveform of what's being said -->
    @{ var sermonPoster = ViewBag.SermonPoster as string; }
    <div id="audioOnlyStage" style="display:none">
      @if (!string.IsNullOrEmpty(sermonPoster))
      {
        <div class="ao-poster-bg" style="background-image:url('@sermonPoster')"></div>
        <img src="@sermonPoster" alt="" class="ao-poster" />
      }
      else
      {
        <div class="ao-poster-icon"><i class="fas fa-headphones"></i></div>
      }
      <canvas class="ao-wave" id="audioWave" width="320" height="56" aria-hidden="true"></canvas>
    </div>

    <!-- Spotlight label on stage -->
    <div id="spotlightLabel" style="display:none">
      <i class="fas fa-star"></i> <span id="spotlightName"></span>
    </div>

    <!-- Background music: shows the song only; it isn't played in the room -->
    <div id="musicChip" style="display:none" title="Background music for Live page viewers (not played in the meeting)">
      <i class="fas fa-music"></i> <span id="musicChipTitle"></span>
    </div>

    <!-- Verse overlay — projected from LiveSettings -->
    <div id="verseOverlay" style="display:none;position:absolute;bottom:var(--controls-h, 80px);left:0;right:0;
         background:linear-gradient(transparent,rgba(0,0,0,.88));
         padding:2.5rem 1.5rem 1rem;z-index:15;pointer-events:none">
      <p id="verseText" style="color:rgba(255,255,255,.95);font-size:1.15rem;line-height:1.65;
           font-weight:600;text-shadow:0 1px 6px rgba(0,0,0,.6);font-family:Tahoma,Calibri;
           margin-bottom:.3rem"></p>
      <span id="verseRef" style="color:gold;font-size:.82rem;font-weight:600"></span>
    </div>

    <div class="controls">
      <button class="ctrl-btn ctrl-default" id="btnMic" onclick="toggleMic()"><i class="fas fa-microphone" id="micIcon"></i><span>Mute</span></button>
      <button class="ctrl-btn ctrl-default" id="btnCam" onclick="toggleCamera()"><i class="fas fa-video" id="camIcon"></i><span>Camera</span></button>
      <button class="ctrl-btn ctrl-default" id="btnScreen" onclick="toggleScreenShare()"><i class="fas fa-desktop"></i><span>Share</span></button>
      <button class="ctrl-btn ctrl-default" id="btnHand" onclick="toggleHand()"><i class="fas fa-hand"></i><span>Hand</span></button>
      <button class="ctrl-btn ctrl-default" onclick="toggleReactions()"><i class="fas fa-face-smile"></i><span>React</span></button>
      <button class="ctrl-btn ctrl-default" id="btnAudioOnly" onclick="toggleAudioOnly()" title="Listen without other people's video to save data"><i class="fas fa-headphones"></i><span>Audio only</span></button>
      <div class="controls-spacer"></div>
      @if (Model.Room.ChatEnabled)
      {
        <button class="ctrl-btn ctrl-default" id="btnChat" onclick="toggleSidebar('chat')"><i class="fas fa-comments"></i><span>Chat</span></button>
      }
      @* With chat on, phones held upright reach People through the Chat panel's People tab (frees room for Leave) *@
      <button class="ctrl-btn ctrl-default @(Model.Room.ChatEnabled ? "ctrl-people-via-chat" : "")" onclick="toggleSidebar('people')"><i class="fas fa-users"></i><span>People</span></button>
      @if (isHost)
      {
        <button class="ctrl-btn ctrl-default" id="btnSpotlight" onclick="toggleSpotlightMode()" title="Spotlight a participant">
          <i class="fas fa-star"></i><span>Spotlight</span>
        </button>
        <button class="ctrl-btn ctrl-default" onclick="muteAll()"><i class="fas fa-microphone-slash"></i><span>Mute All</span></button>
        <button class="ctrl-end" onclick="confirmEnd()" title="End meeting" aria-label="End meeting"><i class="fas fa-phone-slash"></i><span class="ctrl-end-label">End</span></button>
      }
      else
      {
        <button class="ctrl-end" onclick="leaveMeeting()" title="Leave meeting" aria-label="Leave meeting"><i class="fas fa-phone-slash"></i><span class="ctrl-end-label">Leave</span></button>
      }
    </div>
  </div>

  <div class="meet-sidebar closed" id="meetSidebar">
    <div class="sidebar-tabs">
      <button class="sidebar-tab active" onclick="switchTab('people')" id="tabPeople">
        <i class="fas fa-users"></i> People <span class="badge-count" id="peopleCount">0</span>
      </button>
      @if (Model.Room.ChatEnabled)
      {
        <button class="sidebar-tab" onclick="switchTab('chat')" id="tabChat">
          <i class="fas fa-comments"></i> Chat <span class="badge-count" id="chatCount" style="display:none">0</span>
        </button>
      }
    </div>
    <div class="panel active" id="panelPeople">
      <div class="panel-body" id="waitingList"></div>
      <div class="panel-body" id="participantList"></div>
    </div>
    <div class="panel" id="panelChat">
      <div class="chat-messages" id="chatMessages"></div>
      <div class="chat-input-area">
        <div class="chat-input-row">
          <textarea class="chat-input-meet" id="chatInput" rows="1" placeholder="Message everyone..." onkeydown="chatKeyDown(event)"></textarea>
          <button class="chat-send-btn" onclick="sendChat()"><i class="fas fa-paper-plane"></i></button>
        </div>
        <div style="display:flex;gap:.4rem">
          <button class="prayer-btn" onclick="sendPrayer()"><i class="fas fa-hands-praying"></i> Send as Prayer</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="meetData"
     data-room-code="@Model.Room.RoomCode"
     data-display-name="@Model.DisplayName"
     data-display-photo="@Model.DisplayPhoto"
     data-is-host="@isHost.ToString().ToLower()"
     data-is-admin="@isAdminPastor.ToString().ToLower()"
     data-member-id="@(Model.CurrentMemberId?.ToString() ?? "")"
     data-waiting-room="@Model.Room.WaitingRoomEnabled.ToString().ToLower()"
     data-sermon-id="@(ViewBag.LiveSermonId as int? ?? 0)"
     data-sermon-live="@((ViewBag.SermonIsLive as bool? == true).ToString().ToLower())"
     data-track-attendance="@((ViewBag.TrackAttendance as bool? == true).ToString().ToLower())"
     style="display:none">@Html.AntiForgeryToken()</div>

<script src="~/js/wake-lock.js" asp-append-version="true"></script>
<script src="~/js/live-music.js" asp-append-version="true"></script>
<script src="~/js/audio-wave.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/livekit-client@2.22.3/dist/livekit-client.umd.js"
        integrity="sha384-G/xxtkVytOx/ia9Q8MXxM+V0ohsaY1fZAgVP3iSGTPz4wJ0s3+ulJNKXh/gnzEDZ" crossorigin="anonymous"></script>
<script>
const LK         = LivekitClient;
const data       = document.getElementById('meetData').dataset;
const ROOM_CODE  = data.roomCode;
const DISPLAY    = data.displayName;
const MY_PHOTO   = data.displayPhoto || '/images/avatar-default.png';
const IS_HOST    = data.isHost   === 'true';
const IS_ADMIN   = data.isAdmin  === 'true';
const WAITING_ON = data.waitingRoom === 'true';
const SERMON_ID  = parseInt(data.sermonId) || 0;
const TRACK_ATTENDANCE = data.trackAttendance === 'true';

let micTrack=null, camTrack=null;
let isMuted=false, isCamOff=false, isHandRaised=false, isScreenSharing=false;
let sidebarOpen=false, currentTab='people', unreadChat=0;
let meetingSeconds=0, timerInterval=null;
let spotlightId=null, spotlightMode=false, myConnId=null;
const peerInfo={};

// Audio and video go through the LiveKit media server: everyone sends their camera
// once and the server forwards it to the others. A participant's LiveKit identity is
// their meeting-hub connection id, the same id the tiles and host controls use.
// Separate connections for sending and receiving: with the newer single-connection
// mode every joiner renegotiates everyone's connection, and during a busy start
// (10 people arriving) those renegotiations timed out and forced full reconnects.
const room=new LK.Room({adaptiveStream:true, dynacast:true, singlePeerConnection:false});

const conn = new signalR.HubConnectionBuilder()
  .withUrl('/meetingHub').withAutomaticReconnect().build();
// A phone on a weak connection can go quiet for a while; allow longer before dropping
conn.serverTimeoutInMilliseconds=60000;

async function initMedia() {
  const audioOptions = { echoCancellation:true, noiseSuppression:true, autoGainControl:true };

  // Check if browser supports getUserMedia at all
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    console.error('getUserMedia not supported — HTTP instead of HTTPS?');
    showPermissionBanner('error', 'Camera/microphone not available. Make sure you are using HTTPS.');
    isCamOff=true; isMuted=true;
    addLocalTile(); updateMediaButtons(); return;
  }

  // Check permission state before requesting
  try {
    const camPerm = await navigator.permissions.query({name:'camera'});
    const micPerm = await navigator.permissions.query({name:'microphone'});
    console.log('Camera permission:', camPerm.state, '| Mic permission:', micPerm.state);
    if (camPerm.state === 'denied' || micPerm.state === 'denied') {
      showPermissionBanner('blocked',
        'Camera or microphone access is blocked. Click the lock icon in your browser address bar to allow access, then refresh.');
    }
  } catch {}

  let tracks = [];
  try {
    tracks = await LK.createLocalTracks({audio:audioOptions, video:{resolution:LK.VideoPresets.h720.resolution}});
    console.log('Media acquired — tracks:', tracks.map(t=>t.kind+':'+t.mediaStreamTrack.label));
  } catch(err1) {
    console.warn('Video+audio failed:', err1.name, err1.message);
    try {
      tracks = await LK.createLocalTracks({audio:audioOptions, video:false});
      isCamOff = true;
      console.log('Audio-only acquired:', tracks.map(t=>t.mediaStreamTrack.label));
    } catch(err2) {
      console.error('All media failed:', err2.name, err2.message);
      showPermissionBanner('blocked',
        `Could not access camera/microphone: ${err2.message}. Check browser permissions and try again.`);
      isCamOff=true; isMuted=true;
    }
  }
  micTrack = tracks.find(t=>t.kind==='audio') ?? null;
  camTrack = tracks.find(t=>t.kind==='video') ?? null;
  addLocalTile(); updateMediaButtons();
}

function showPermissionBanner(type, message) {
  const existing = document.getElementById('permissionBanner');
  if (existing) existing.remove();
  const banner = document.createElement('div');
  banner.id = 'permissionBanner';
  banner.style.cssText = `position:fixed;top:0;left:0;right:0;z-index:9999;
    background:${type==='blocked'?'#7f1d1d':'#1e1b4b'};color:white;
    padding:.75rem 1.25rem;font-size:.88rem;display:flex;align-items:center;
    gap:1rem;box-shadow:0 2px 12px rgba(0,0,0,.5)`;
  banner.innerHTML = `<i class="fas fa-${type==='blocked'?'microphone-slash':'exclamation-triangle'}"></i>
    <span>${message}</span>
    <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;
      border:1px solid rgba(255,255,255,.3);color:white;border-radius:6px;
      padding:.25rem .6rem;cursor:pointer;font-size:.8rem">✕</button>`;
  document.body.prepend(banner);
}

function addLocalTile() {
  const grid=document.getElementById('videoGrid');
  const tile=document.createElement('div');
  tile.className=`video-tile local-tile ${isCamOff?'video-off':'video-on'}`; tile.id='tile-local';
  tile.innerHTML=`<video autoplay muted playsinline id="localVideo"></video>
    <div class="tile-avatar"><img src="${escHtml(MY_PHOTO)}" alt="${escHtml(DISPLAY)}"/><span>${escHtml(DISPLAY)}</span></div>
    <div class="tile-name"><i class="fas fa-user"></i> ${escHtml(DISPLAY)} (You)</div>
    <div class="tile-badges" id="localBadges"></div>`;
  grid.appendChild(tile);
  showLocalVideo(camTrack);
  if(IS_HOST||IS_ADMIN) attachCtxMenu(tile,'local',DISPLAY);
  reflow();
}
// Shows our camera or screen share in our own tile
function showLocalVideo(track){
  const v=document.getElementById('localVideo');
  if(!v||v._track===track) return;
  v._track?.detach(v);
  track?.attach(v);
  v._track=track;
}

// ── SignalR handlers ──────────────────────────────────────
conn.on('RoomJoined', async({participants,isInWaitingRoom,forceMuted,spotlightId:spot}) => {
  myConnId = conn.connectionId;
  if(isInWaitingRoom){document.getElementById('waitingOverlay').style.display='flex';return;}
  await enterMeeting(participants,forceMuted,spot);
});

conn.on('Admitted',async({participants,forceMuted,spotlightId:spot})=>{
  document.getElementById('waitingOverlay').style.display='none';
  toast('You have been admitted','success');
  await enterMeeting(participants,forceMuted,spot);
});

// Shared by RoomJoined and Admitted: show the list, apply room state, join the media room
async function enterMeeting(participants,forceMuted,spot){
  startTimer();
  updateViewerCount(participants.length+1);
  for(const p of participants){
    peerInfo[p.connectionId]={name:p.displayName,photo:p.photo,isHost:p.isHost,
      isMuted:p.isMuted,isVideoOff:p.isVideoOff,isHandRaised:p.isHandRaised};
  }
  renderParticipants(participants);
  loadChat();
  if(forceMuted&&!isMuted){toggleMic();toast('The host has muted participants — unmute when you want to speak','warn');}
  if(spot){spotlightId=spot===myConnId?'local':spot;reflow();}
  await connectMedia();
}

// The hub only gives a media token to an admitted participant on this connection
async function connectMedia(){
  try{
    const t=await conn.invoke('GetMediaToken',ROOM_CODE);
    if(!t){
      console.warn('Media connection failed: the hub refused a media token');
      toast('Could not join the meeting audio/video — refresh to try again','warn');return;
    }
    // Tracks are subscribed by hand so audio only mode never downloads video
    await room.connect(t.url,t.token,{autoSubscribe:false});
    applyAllSubscriptions();
    for(const track of [micTrack,camTrack]) if(track) await room.localParticipant.publishTrack(track);
    room.remoteParticipants.forEach(p=>{ensureTile(p);showRemoteVideo(p.identity);});
    if(!room.canPlaybackAudio) showSoundUnlock();
    await maybeRecord();
  }catch(e){
    console.error('Media connection failed',e);
    toast('Could not connect audio/video — refresh to try again','warn');
  }
}

// ── Audio only mode ───────────────────────────────────────
// Other people's video isn't subscribed, so the server doesn't send it (saves data).
// Our own camera is left as it is: the host's camera may be what the Live page shows.
const wave=AudioWave(document.getElementById('audioWave'));
let audioOnly=(()=>{
  try{const saved=localStorage.getItem('meet.audioOnly');if(saved!==null)return saved==='true';}catch{}
  // No saved choice: follow the browser's data-saver / slow-connection hint
  const c=navigator.connection;
  const slow=!!(c&&(c.saveData||['slow-2g','2g'].includes(c.effectiveType)));
  if(slow) setTimeout(()=>toast('Slow connection — Audio only mode. Tap Audio only to see video.'),1500);
  return slow;
})();
function applySubscription(pub){pub.setSubscribed(pub.kind==='audio'||!audioOnly);}
function applyAllSubscriptions(){room.remoteParticipants.forEach(p=>p.trackPublications.forEach(applySubscription));}
function showAudioOnlyState(){
  document.getElementById('btnAudioOnly').classList.toggle('ctrl-active',audioOnly);
  document.getElementById('audioOnlyStage').style.display=audioOnly?'flex':'none';
  if(audioOnly){wave.unlock();wave.start();} else wave.stop();
}
function toggleAudioOnly(){
  audioOnly=!audioOnly;
  try{localStorage.setItem('meet.audioOnly',audioOnly);}catch{}
  if(room.state==='connected') applyAllSubscriptions();
  showAudioOnlyState();
  toast(audioOnly?'Audio only mode':'Video on');
}
showAudioOnlyState();

// ── LiveKit events ────────────────────────────────────────
const audioBox=document.createElement('div');
audioBox.style.display='none';
document.body.appendChild(audioBox);

room
  .on(LK.RoomEvent.ParticipantConnected,p=>ensureTile(p))
  // A camera, mic or screen share was turned on: subscribe unless it's video in audio only mode
  .on(LK.RoomEvent.TrackPublished,pub=>applySubscription(pub))
  .on(LK.RoomEvent.ParticipantDisconnected,p=>{document.getElementById(`tile-${p.identity}`)?.remove();reflow();})
  .on(LK.RoomEvent.TrackSubscribed,(track,pub,p)=>{
    if(track.kind==='audio'){audioBox.appendChild(track.attach());recAdd(track.sid,track.mediaStreamTrack);wave.addTrack(track.sid,track.mediaStreamTrack);}
    else showRemoteVideo(p.identity);
  })
  .on(LK.RoomEvent.TrackUnsubscribed,(track,pub,p)=>{
    if(track.kind==='audio'){track.detach().forEach(el=>el.remove());recRemove(track.sid);wave.removeTrack(track.sid);}
    else showRemoteVideo(p.identity);
  })
  .on(LK.RoomEvent.TrackMuted,(pub,p)=>{
    if(p!==room.localParticipant) showRemoteVideo(p.identity);
    // Muted by the host through the media server: keep our button in step
    else if(pub.source===LK.Track.Source.Microphone&&!isMuted) toggleMic();
  })
  .on(LK.RoomEvent.TrackUnmuted,(pub,p)=>{if(p!==room.localParticipant)showRemoteVideo(p.identity);})
  .on(LK.RoomEvent.ActiveSpeakersChanged,speakers=>{
    const ids=new Set(speakers.map(s=>s===room.localParticipant?'local':s.identity));
    document.querySelectorAll('.video-tile').forEach(t=>t.classList.toggle('speaking',ids.has(t.id.slice(5))));
  })
  .on(LK.RoomEvent.AudioPlaybackStatusChanged,()=>{if(!room.canPlaybackAudio)showSoundUnlock();})
  // The browser's own "Stop sharing" button ends the share without our button
  .on(LK.RoomEvent.LocalTrackUnpublished,pub=>{if(pub.source===LK.Track.Source.ScreenShare)screenShareStopped();})
  .on(LK.RoomEvent.Reconnecting,()=>toast('Audio/video connection lost — reconnecting…','warn'))
  .on(LK.RoomEvent.Reconnected,()=>toast('Audio/video reconnected','success'))
  .on(LK.RoomEvent.Disconnected,reason=>{
    if(reason!==LK.DisconnectReason.CLIENT_INITIATED) console.warn('Media room disconnected:',reason);
    // The host ended the meeting (the hub normally says so first). A removal isn't
    // handled here: the hub also removes a connection that is only reconnecting.
    if(reason===LK.DisconnectReason.ROOM_DELETED){
      clearInterval(timerInterval);
      document.getElementById('endedOverlay').style.display='flex';
    }
  });

// Who is in the meeting comes from the hub (peerInfo); LiveKit only supplies media.
// A media participant the hub hasn't announced (or already said has left, e.g. the
// old connection of someone who rejoined) gets no tile.
function ensureTile(p){
  if(!peerInfo[p.identity]||document.getElementById(`tile-${p.identity}`)) return;
  let photo;
  try{photo=JSON.parse(p.metadata||'{}').photo;}catch{}
  addRemoteTile(p.identity,peerInfo[p.identity]?.name??p.name??'Participant',
    peerInfo[p.identity]?.photo??photo??'/images/avatar-default.png');
}

conn.on('PeerJoined',async({connectionId,displayName,photo,isHost,isMuted:m,isVideoOff})=>{
  peerInfo[connectionId]={...peerInfo[connectionId],name:displayName,photo,isHost,isMuted:m,isVideoOff};
  toast(`${displayName} joined`);
  addParticipantItem(connectionId,displayName,photo,isHost);
  updatePeopleCount();
  // Their media may have arrived before this announcement
  const p=room.remoteParticipants.get(connectionId);
  if(p){ensureTile(p);showRemoteVideo(connectionId);}
});

conn.on('PeerLeft',(cid)=>{
  if(cid===myConnId) return;
  const name=peerInfo[cid]?.name;
  if(name) toast(`${name} left`);
  removePeer(cid);
});

// Removes everything we hold for a remote participant
function removePeer(cid){
  document.getElementById(`tile-${cid}`)?.remove();
  document.getElementById(`person-${cid}`)?.remove();
  delete peerInfo[cid];
  // The server clears the shared spotlight; only reset our view here
  if(spotlightId===cid) spotlightId=null;
  reflow();
  updatePeopleCount();
}

conn.on('ViewerCountUpdated', count => updateViewerCount(count));

// ── Recording ─────────────────────────────────────────────
// While the sermon is live, one host's page records the meeting's audio: everyone's
// microphone mixed together, sent to the server in 10 s pieces so little is lost if the
// page closes. When the meeting ends (or the sermon stops being live) the server turns
// the pieces into the sermon's recording. Background music plays on each device
// separately, so it isn't in the recording.
let sermonLive = data.sermonLive === 'true';
const ANTI_FORGERY = document.querySelector('#meetData input[name="__RequestVerificationToken"]')?.value ?? '';
const rec = { ctx:null, dest:null, sources:new Map(), recorder:null, part:null, seq:0,
              queue:[], sending:false, seconds:0, timer:null };

function recFormat(){
  if(!window.MediaRecorder) return null;
  if(MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) return {mime:'audio/webm;codecs=opus',ext:'webm'};
  if(MediaRecorder.isTypeSupported('audio/mp4')) return {mime:'audio/mp4',ext:'m4a'};
  return null;
}
// Adds a microphone (ours, or a participant's by track sid) to the mix
function recAdd(key,mediaStreamTrack){
  if(!rec.ctx||!mediaStreamTrack||rec.sources.has(key)) return;
  const src=rec.ctx.createMediaStreamSource(new MediaStream([mediaStreamTrack]));
  src.connect(rec.dest);
  rec.sources.set(key,src);
}
function recRemove(key){rec.sources.get(key)?.disconnect();rec.sources.delete(key);}

// Starts recording when this host may: the sermon is live and no other host's page records
async function maybeRecord(){
  if(!IS_HOST||!SERMON_ID||!sermonLive) return;
  const claimed=await conn.invoke('ClaimRecorder',ROOM_CODE).catch(()=>false);
  if(!claimed){if(rec.recorder) await stopRecording();return;}   // another host's page records
  if(rec.recorder) return;                                         // still recording after a reconnect
  const fmt=recFormat();
  if(!fmt){toast('This browser can\'t record the meeting audio — use Chrome or Edge','warn');return;}

  rec.ctx=new AudioContext();
  if(rec.ctx.state==='suspended') await rec.ctx.resume().catch(()=>{});
  if(rec.ctx.state==='suspended') toast('Click anywhere on the page so the recording can hear the meeting','warn');
  rec.dest=rec.ctx.createMediaStreamDestination();
  recAdd('local',micTrack?.mediaStreamTrack);
  room.remoteParticipants.forEach(p=>p.audioTrackPublications.forEach(pub=>{
    if(pub.track) recAdd(pub.track.sid,pub.track.mediaStreamTrack);
  }));

  // A new part each time recording starts; the server joins the parts in order
  const part=crypto.randomUUID();
  let seq=0;
  const recorder=new MediaRecorder(rec.dest.stream,{mimeType:fmt.mime,audioBitsPerSecond:64000});
  recorder.ondataavailable=e=>{
    if(e.data.size===0) return;
    rec.queue.push({part,seq:seq++,ext:fmt.ext,blob:e.data});
    recSend();
  };
  recorder.start(10000);
  rec.recorder=recorder;
  rec.seconds=0;
  rec.timer=setInterval(()=>{if(rec.recorder?.state==='recording'){rec.seconds++;showRecUi();}},1000);
  showRecUi();
  toast('Recording the meeting audio for the sermon','success');
}

// Stops recording; resolves once what was recorded has been sent (at most ~10 s)
async function stopRecording(){
  const recorder=rec.recorder;
  if(!recorder) return;
  rec.recorder=null;
  if(recorder.state!=='inactive')
    await new Promise(done=>{recorder.addEventListener('stop',done,{once:true});recorder.stop();});
  rec.sources.forEach(s=>s.disconnect()); rec.sources.clear();
  rec.ctx?.close().catch(()=>{}); rec.ctx=null; rec.dest=null;
  clearInterval(rec.timer);
  showRecUi();
  const deadline=Date.now()+10000;
  while((rec.queue.length||rec.sending)&&Date.now()<deadline) await new Promise(r=>setTimeout(r,250));
}

// Sends the pieces in order; a network or server error is retried, a refusal is dropped
async function recSend(){
  if(rec.sending) return;
  rec.sending=true;
  let wait=1000;
  while(rec.queue.length){
    const c=rec.queue[0];
    const form=new FormData();
    form.append('code',ROOM_CODE); form.append('part',c.part); form.append('seq',c.seq);
    form.append('format',c.ext); form.append('chunk',c.blob,`${c.seq}.${c.ext}`);
    form.append('__RequestVerificationToken',ANTI_FORGERY);
    let res=null;
    try{res=await fetch('/Meeting/RecordingChunk',{method:'POST',body:form});}catch{}
    if(res&&(res.ok||(res.status>=400&&res.status<500&&res.status!==429))){rec.queue.shift();wait=1000;continue;}
    await new Promise(r=>setTimeout(r,wait));
    wait=Math.min(wait*2,30000);
  }
  rec.sending=false;
}

function toggleRecPause(){
