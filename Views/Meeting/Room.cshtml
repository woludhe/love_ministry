  const c=document.getElementById('toastContainer'),t=document.createElement('div');
  t.className='toast';
  t.innerHTML=`<i class="fas fa-${type==='success'?'check-circle':type==='warn'?'triangle-exclamation':'circle-info'}" style="color:${type==='success'?'#22c55e':type==='warn'?'#f59e0b':'#7c6ff7'}"></i> ${escHtml(msg)}`;
  c.appendChild(t); setTimeout(()=>t.remove(),3500);
}
function escHtml(s){const d=document.createElement('div');d.textContent=s??'';return d.innerHTML;}
function capitalize(s){return s.charAt(0).toUpperCase()+s.slice(1);}
function pad(n){return String(n).padStart(2,'0');}

// ── LiveSession hub — verse overlays from Admin LiveSettings ─
const liveConn = SERMON_ID > 0
    ? new signalR.HubConnectionBuilder()
        .withUrl('/liveSessionHub').withAutomaticReconnect().build()
    : null;

// Attendance: send the browser's location if the viewer allows it
function reportAttendanceLocation() {
    if (!TRACK_ATTENDANCE || !navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(
        p => liveConn.invoke('ReportLocation', SERMON_ID, p.coords.latitude, p.coords.longitude).catch(() => {}),
        () => {}, { timeout: 15000, maximumAge: 600000 });
}

if (liveConn) {
    liveConn.on('VerseChanged', ({reference, verseText, translation}) => {
        document.getElementById('verseText').textContent = `"${verseText}"`;
        document.getElementById('verseRef').textContent  = `${reference} (${translation})`;
        document.getElementById('verseOverlay').style.display = 'block';
    });
    liveConn.on('VerseCleared', () => {
        document.getElementById('verseOverlay').style.display = 'none';
    });
    liveConn.on('OverlayToggled', (overlay, visible) => {
        if (overlay === 'verse')
            document.getElementById('verseOverlay').style.display = visible ? 'block' : 'none';
    });
    liveConn.on('SettingsChanged', s => {
        if (!s.showVerseOverlay || !s.activeVerse)
            document.getElementById('verseOverlay').style.display = 'none';
    });
    liveConn.on('MusicChanged', showMusic);
    setInterval(renderMusicChip, 2000);   // the song changes on its own as the playlist runs
}

// Background music from Live Settings: named here, but only Live page viewers hear it
// (playing it in the room would go back into the call through people's microphones)
let musicState = null, musicSkew = 0;
function showMusic(s) {
    if (!s) return;
    musicState = s;
    musicSkew = (s.serverNow || Date.now()) - Date.now();
    renderMusicChip();
}
function renderMusicChip() {
    const chip = document.getElementById('musicChip');
    if (!musicState || musicState.state === 'stopped' || !musicState.playlist?.length) { chip.style.display = 'none'; return; }
    const pos = LiveMusicMath.positionNow(musicState, Date.now(), musicSkew);
    const track = musicState.playlist[LiveMusicMath.locate(musicState.playlist, pos).index];
    document.getElementById('musicChipTitle').textContent = (musicState.state === 'paused' ? 'Paused: ' : '') + track.title;
    chip.style.display = 'flex';
}

// Joins (or re-joins) the room, then re-sends our media state, since the
// server may have created a fresh participant row for this connection
async function joinRoom(){
    await conn.invoke('JoinRoom',ROOM_CODE,DISPLAY);
    if(isMuted) conn.invoke('ToggleMute',ROOM_CODE,true);
    if(isCamOff) conn.invoke('ToggleVideo',ROOM_CODE,true);
    if(isHandRaised) conn.invoke('RaiseHand',ROOM_CODE,true);
}

// After an automatic reconnect we have a new connection id, which is also our
// LiveKit identity — leave the media room (keeping our camera and mic running)
// and join again; RoomJoined then reconnects the media under the new id
conn.onreconnecting(()=>toast('Connection lost — reconnecting…','warn'));
conn.onreconnected(async()=>{
    if(isScreenSharing){await room.localParticipant.setScreenShareEnabled(false).catch(()=>{});screenShareStopped();}
    await room.disconnect(false);
    audioBox.innerHTML='';
    document.querySelectorAll('.video-tile:not(#tile-local)').forEach(t=>t.remove());
    Object.keys(peerInfo).forEach(cid=>delete peerInfo[cid]);
    document.getElementById('participantList').innerHTML='';
    spotlightId=null; reflow();
    await joinRoom();
    toast('Reconnected','success');
});
conn.onclose(()=>toast('Disconnected from the meeting — refresh the page to rejoin','warn'));

// Read-only hooks for automated tests
window.__meet = { room, peerInfo, get spotlightId(){return spotlightId;}, get myConnId(){return myConnId;},
                  get isMuted(){return isMuted;}, get isCamOff(){return isCamOff;} };

(async()=>{
    await initMedia();
    await conn.start();
    await joinRoom();

    // Connect to LiveSession hub to receive verse projections
    if (liveConn) {
        await liveConn.start();
        await liveConn.invoke('JoinLiveRoomFromMeeting', SERMON_ID);
        reportAttendanceLocation();
        // A reconnect gets a new connection id — join again so overlays and attendance continue
        liveConn.onreconnected(async () => {
            await liveConn.invoke('JoinLiveRoomFromMeeting', SERMON_ID);
            reportAttendanceLocation();
        });
        // Load current verse if one is already active
        try {
            const res = await fetch(`/api/LiveSettings/${SERMON_ID}/State`);
            const s   = await res.json();
            if (s.showVerseOverlay && s.activeVerse) {
                document.getElementById('verseText').textContent = `"${s.activeVerse.verseText}"`;
                document.getElementById('verseRef').textContent  =
                    `${s.activeVerse.reference} (${s.activeVerse.translation})`;
                document.getElementById('verseOverlay').style.display = 'block';
            }
            showMusic(s.music);
        } catch {}
    }
})();
// Publish the controls bar height so overlays (sidebar, verse, reactions) sit above it
(function trackControlsHeight(){
    const bar=document.querySelector('.controls');
    const set=()=>document.documentElement.style.setProperty('--controls-h',bar.offsetHeight+'px');
    set();
    if(window.ResizeObserver) new ResizeObserver(set).observe(bar);
    window.addEventListener('resize',set);
})();
window.addEventListener('beforeunload',()=>{
    room.disconnect();
    conn.invoke('LeaveRoom',ROOM_CODE);
    liveConn?.stop();
});
</script>
</body>
</html>
