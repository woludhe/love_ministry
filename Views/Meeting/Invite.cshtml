@model ChurchMinistry.Models.MeetingRoom
@using ChurchMinistry.Models
@{
    ViewData["Title"] = "Invite People";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allMembers = ViewBag.AllMembers as List<Member> ?? new();
    var groups = ViewBag.Groups as List<ChurchMinistry.ViewModels.MeetingInviteGroupOption> ?? new();
}

<section class="page-header">
  <h1><i class="fas fa-user-plus"></i> Invite People</h1>
  <p>
    <strong>@Model.Title</strong> ·
    @(Model.ScheduledAt?.ToLocalTime().ToString("ddd, dd MMM · h:mm tt") ?? "Unscheduled") ·
    @(Model.IsPublic ? "Public" : "Private") meeting
  </p>
</section>

<div class="form-page">
  <form method="post" asp-action="SendInvites" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()

    @if (Model.IsPublic)
    {
      <div class="inv-note">
        <i class="fas fa-globe"></i>
        This is a public meeting — every member can already join. Invitations just let people know about it.
      </div>
    }

    @if (groups.Any())
    {
      <div class="form-group">
        <label>Invite Groups <span class="inv-hint">— everyone in the group, including people who join it later</span></label>
        <div class="form-options-grid">
          @foreach (var g in groups)
          {
            var groupInvited = Model.Invitations.Any(i => i.MinistryGroupId == g.Id);
            <label class="option-toggle @(groupInvited ? "inv-already" : "")">
              <input type="checkbox" name="groupIds" value="@g.Id" @(groupInvited ? "disabled checked" : "") />
              <div class="option-content">
                <i class="fas fa-users"></i>
                <span>@g.Name</span>
                <small>@g.MemberCount member@(g.MemberCount == 1 ? "" : "s")@(groupInvited ? " · Invited" : "")</small>
              </div>
            </label>
          }
        </div>
      </div>
    }

    <div class="form-group">
      <label for="memberSearch">Invite Members</label>
      <input type="text" id="memberSearch" class="form-control" placeholder="Search members by name or email..."
             autocomplete="off" oninput="filterMembers(this.value)" />
      <div class="form-options-grid inv-member-grid" id="memberList">
        @foreach (var m in allMembers)
        {
          var alreadyInvited = Model.Invitations.Any(i => i.MemberId == m.Id);
          <label class="option-toggle inv-member @(alreadyInvited ? "inv-already" : "")">
            <input type="checkbox" name="memberIds" value="@m.Id" @(alreadyInvited ? "disabled checked" : "") />
            <div class="option-content">
              <i class="fas @(alreadyInvited ? "fa-user-check" : "fa-user")"></i>
              <span class="inv-member-name">@m.FullName</span>
              <small class="inv-member-email">@m.Email</small>
            </div>
          </label>
        }
      </div>
    </div>

    <div class="form-group">
      <label for="emailList">Invite by Email <span class="inv-hint">— for people not yet registered</span></label>
      <textarea id="emailList" name="emailList" class="form-control" rows="3"
                placeholder="Email addresses separated by commas or new lines&#10;e.g. john@example.com, jane@example.com"></textarea>
    </div>

    <div class="form-group">
      <label>Or Share the Room Code</label>
      <div class="inv-share-row">
        <input class="form-control" value="@Model.RoomCode" readonly />
        <button type="button" class="btn-meet btn-meet-primary" onclick="copyText(this, '@Model.RoomCode', 'Code copied!')">
          <i class="fas fa-copy"></i> Copy Code
        </button>
        <button type="button" class="btn-meet btn-meet-primary" onclick="copyText(this, location.origin + '/meeting/room/@Model.RoomCode', 'Link copied!')">
          <i class="fas fa-link"></i> Copy Link
        </button>
      </div>
    </div>

    <div style="display:flex;gap:1rem;margin-top:1.5rem">
      <button type="submit" class="btn-meet btn-meet-primary">
        <i class="fas fa-envelope"></i> Send Invitations
      </button>
      <a asp-action="Index" class="btn-meet btn-meet-ghost">Back to Meetings</a>
    </div>
  </form>

  <div class="form-group" style="margin-top:2.5rem">
    <label>Already Invited <span class="inv-count">@Model.Invitations.Count</span></label>

    @if (!Model.Invitations.Any())
    {
      <div class="inv-empty">
        <i class="fas fa-user-plus"></i> No one invited yet.
      </div>
    }
    else
    {
      <div class="inv-invited-list">
        @foreach (var inv in Model.Invitations.OrderByDescending(i => i.InvitedAt))
        {
          var isGroup = inv.MinistryGroupId != null;
          var name = isGroup ? $"Group: {inv.MinistryGroup?.Name}"
                   : inv.Member?.FullName ?? inv.Email ?? "External Guest";
          <div class="inv-invited-item">
            <i class="fas @(isGroup ? "fa-users" : inv.MemberId != null ? "fa-user" : "fa-envelope") inv-invited-icon"></i>
            <div class="inv-invited-info">
              <span>@name</span>
              <small>Invited @inv.InvitedAt.ToLocalTime().ToString("dd MMM · h:mm tt")</small>
            </div>
            @if (!isGroup)
            {
              <span class="inv-status @(inv.AcceptedAt.HasValue ? "inv-accepted" : "inv-pending")">
                @(inv.AcceptedAt.HasValue ? "Accepted" : "Pending")
              </span>
            }
            <form method="post" asp-action="RemoveInvite" asp-route-id="@Model.Id" style="margin:0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="invitationId" value="@inv.Id" />
              <button type="submit" class="inv-remove-btn" title="Remove invitation">
                <i class="fas fa-times"></i>
              </button>
            </form>
          </div>
        }
      </div>
    }
  </div>
</div>

<style>
.inv-hint        { font-weight:400;color:var(--text-s);font-size:.8rem; }
.inv-note        { background:var(--purple-l);color:var(--purple-d);border-radius:8px;
                   padding:.75rem 1rem;font-size:.88rem;margin-bottom:1.25rem; }
.inv-member-grid { max-height:340px;overflow-y:auto;margin-top:.6rem;padding:.1rem; }
.option-toggle.inv-already { opacity:.6;cursor:default; }
.inv-member .option-content { min-width:0; }
.inv-member-email{ overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.inv-share-row   { display:flex;gap:.6rem;flex-wrap:wrap; }
.inv-share-row .form-control { flex:1;min-width:140px;font-weight:700;font-family:monospace;letter-spacing:.05em; }
.inv-count       { background:var(--purple-l);color:var(--purple);font-size:.72rem;font-weight:800;
                   padding:.1rem .5rem;border-radius:100px;margin-left:.3rem; }
.inv-empty       { border:1.5px dashed var(--border);border-radius:10px;padding:1.25rem;
                   text-align:center;color:var(--text-s);font-size:.88rem; }
.inv-invited-list{ background:var(--white);border:1.5px solid var(--border);border-radius:10px; }
.inv-invited-item{ display:flex;align-items:center;gap:.75rem;padding:.7rem .9rem;
                   border-bottom:1px solid var(--border); }
.inv-invited-item:last-child{ border-bottom:none; }
.inv-invited-icon{ color:var(--purple);width:1.1rem;text-align:center; }
.inv-invited-info{ flex:1;display:flex;flex-direction:column;min-width:0; }
.inv-invited-info span { font-size:.88rem;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis; }
.inv-invited-info small{ font-size:.75rem;color:var(--text-s); }
.inv-status      { font-size:.7rem;font-weight:700;padding:.15rem .55rem;border-radius:100px;flex-shrink:0; }
.inv-accepted    { background:#d1fae5;color:#065f46; }
.inv-pending     { background:#fef3c7;color:#92400e; }
.inv-remove-btn  { background:none;border:none;color:var(--text-s);cursor:pointer;
                   padding:.3rem .45rem;border-radius:6px; }
.inv-remove-btn:hover{ color:var(--coral);background:#fee2e2; }
</style>

@section Scripts {
<script>
function filterMembers(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#memberList .inv-member').forEach(item => {
        const name  = item.querySelector('.inv-member-name')?.textContent.toLowerCase() ?? '';
        const email = item.querySelector('.inv-member-email')?.textContent.toLowerCase() ?? '';
        item.style.display = (name.includes(q) || email.includes(q)) ? '' : 'none';
    });
}

function copyText(btn, text, msg) {
    navigator.clipboard.writeText(text);
    const orig = btn.innerHTML;
    btn.innerHTML = `<i class="fas fa-check"></i> ${msg}`;
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
}
</script>
}
