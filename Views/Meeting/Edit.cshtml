@model ChurchMinistry.ViewModels.CreateMeetingViewModel
@{
    ViewData["Title"] = "Edit Meeting";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roomId   = ViewBag.RoomId as int? ?? 0;
    var roomCode = ViewBag.RoomCode as string ?? "";
}

<section class="page-header">
  <h1><i class="fas fa-pen-to-square"></i> Edit Meeting</h1>
  <p>Room code: <span style="font-family:monospace;font-weight:700">@roomCode</span></p>
</section>

<div class="form-page">
  <form asp-action="Edit" asp-route-id="@roomId" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
      <label asp-for="Title">Meeting Title</label>
      <input asp-for="Title" class="form-control" required placeholder="e.g. Sunday Prayer Meeting" />
      <span asp-validation-for="Title" class="field-error"></span>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label asp-for="MeetingType">Meeting Type</label>
        <select asp-for="MeetingType" class="form-control"
                asp-items="Html.GetEnumSelectList<ChurchMinistry.Models.MeetingType>()"></select>
      </div>
      <div class="form-group">
        <label asp-for="ScheduledAt">Date & Time</label>
        <input asp-for="ScheduledAt" class="form-control" type="datetime-local" />
        <span asp-validation-for="ScheduledAt" class="field-error"></span>
      </div>
      <div class="form-group">
        <label asp-for="DurationMinutes">Duration</label>
        <select asp-for="DurationMinutes" class="form-control">
          @foreach (var (minutes, label) in ChurchMinistry.ViewModels.CreateMeetingViewModel.DurationOptions)
          {
            <option value="@minutes" selected="@(Model.DurationMinutes == minutes)">@label</option>
          }
        </select>
      </div>
    </div>

    <div class="form-group">
      <label asp-for="Description">Description (optional)</label>
      <textarea asp-for="Description" class="form-control" rows="3"
                placeholder="What will this meeting cover?"></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label asp-for="MaxParticipants">Max Participants</label>
        <input asp-for="MaxParticipants" class="form-control" type="number" min="2" max="500" />
      </div>
      <div class="form-group">
        <label asp-for="PassCode">Passcode (optional)</label>
        <input asp-for="PassCode" class="form-control" placeholder="Leave blank for no passcode" />
      </div>
    </div>

    <div class="form-group">
      <label>Who can join?</label>
      <div class="form-options-grid">
        <label class="option-toggle">
          <input asp-for="IsPublic" type="radio" value="true" />
          <div class="option-content">
            <i class="fas fa-globe"></i>
            <span>Public</span>
            <small>Visible to all members</small>
          </div>
        </label>
        <label class="option-toggle">
          <input asp-for="IsPublic" type="radio" value="false" />
          <div class="option-content">
            <i class="fas fa-lock"></i>
            <span>Private</span>
            <small>Only invited people &amp; groups</small>
          </div>
        </label>
      </div>
    </div>

    <div class="form-options-grid">
      <label class="option-toggle">
        <input asp-for="WaitingRoomEnabled" type="checkbox" />
        <div class="option-content">
          <i class="fas fa-door-open"></i>
          <span>Waiting Room</span>
          <small>Admit participants manually</small>
        </div>
      </label>
      <label class="option-toggle">
        <input asp-for="ChatEnabled" type="checkbox" />
        <div class="option-content">
          <i class="fas fa-comments"></i>
          <span>Meeting Chat</span>
          <small>Allow in-meeting messages</small>
        </div>
      </label>
      <label class="option-toggle">
        <input asp-for="IsRecurring" type="checkbox"
               onchange="document.getElementById('recurringOpts').style.display=this.checked?'grid':'none'" />
        <div class="option-content">
          <i class="fas fa-rotate"></i>
          <span>Recurring</span>
          <small>Repeat daily or weekly</small>
        </div>
      </label>
    </div>

    <div id="recurringOpts" class="form-row" style="display:@(Model.IsRecurring ? "grid" : "none");grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
      <div class="form-group">
        <label asp-for="RecurringFrequency">Repeats</label>
        <select asp-for="RecurringFrequency" class="form-control"
                onchange="document.getElementById('recurringDayGroup').style.display=this.value==='Daily'?'none':''">
          <option value="Daily">Daily</option>
          <option value="Weekly">Weekly</option>
        </select>
      </div>
      <div class="form-group" id="recurringDayGroup" style="@(Model.RecurringFrequency == "Daily" ? "display:none" : "")">
        <label asp-for="RecurringDay">Day of Week</label>
        <select asp-for="RecurringDay" class="form-control">
          @foreach (var d in new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
          {
            <option value="@d">@d</option>
          }
        </select>
      </div>
      <div class="form-group">
        <label asp-for="RecurringTime">Time</label>
        <input asp-for="RecurringTime" class="form-control" type="time" />
      </div>
      <small class="form-hint" style="grid-column:1/-1;margin-top:-.5rem">
        A new meeting with its own room code is created for each day or week. Invitations carry over.
        Changes here apply to this meeting and the ones after it.
      </small>
    </div>

    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem">
      <button type="submit" class="btn-meet btn-meet-primary">
        <i class="fas fa-save"></i> Save Changes
      </button>
      @if (!Model.IsPublic)
      {
        <a asp-action="Invite" asp-route-id="@roomId" class="btn-meet btn-meet-ghost">
          <i class="fas fa-user-plus"></i> Invite People
        </a>
      }
      <a asp-action="Index" class="btn-meet btn-meet-ghost">Cancel</a>
    </div>
  </form>
</div>
