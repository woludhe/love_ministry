@model ChurchMinistry.Models.PrayerRequest
@{
    ViewData["Title"] = "Share Testimony";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-header" style="background:linear-gradient(135deg,#5b21b6,#7c3aed)">
    <h1><i class="fas fa-bullhorn"></i> Share Your Testimony</h1>
    <p>Let the community rejoice with you and build their faith</p>
</section>

<div class="form-page" style="max-width:640px">

    <div class="testify-banner">
        <div class="testify-banner-icon">🙌</div>
        <div>
            <strong>This will be posted in the Community forum</strong>
            <p>Your testimony will appear under the <em>Testimony</em> category
               where members can read, respond and be encouraged.</p>
        </div>
    </div>

    <div class="answered-original-card">
        <div class="answered-original-label">
            <i class="fas fa-hands-praying"></i> Original Prayer Request
        </div>
        <span class="prayer-tag" style="margin-bottom:.6rem;display:inline-block">@Model.Category</span>
        <p style="font-size:.9rem;line-height:1.7;color:var(--text-s)">@Model.Request</p>
        @if (Model.IsAnswered && !string.IsNullOrEmpty(Model.AnswerTestimony))
        {
            <div style="margin-top:.75rem;padding-top:.75rem;border-top:1px solid #a7f3d0">
                <p style="font-size:.78rem;font-weight:700;color:#065f46;margin-bottom:.3rem">
                    <i class="fas fa-star"></i> Recorded Testimony
                </p>
                <p style="font-size:.85rem">@Model.AnswerTestimony</p>
            </div>
        }
    </div>

    <form asp-action="Testify" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label style="font-weight:700;font-size:.95rem">
                <i class="fas fa-pen" style="color:var(--purple)"></i>
                Write your testimony
            </label>
            <p class="meta" style="margin-bottom:.5rem">
                Be specific - share what happened, when and how God answered.
                Your story will strengthen someone else's faith!
            </p>
            <textarea name="testimony" class="form-control" rows="7" required
                      placeholder="e.g. I submitted this prayer request on March 3rd when I was struggling with... God answered by...">@Model.AnswerTestimony</textarea>
        </div>

        <div class="testify-post-preview">
            <div class="testify-post-preview-header">
                <i class="fas fa-eye"></i> Preview - how it will appear in Community
            </div>
            <div class="testify-post-preview-body">
                <div style="display:flex;gap:.5rem;margin-bottom:.4rem">
                    <span class="cat-badge">Testimony</span>
                </div>
                <strong style="font-size:.95rem">Prayer Answered: @Model.Category 🙌</strong>
                <p style="font-size:.8rem;color:var(--text-s);margin-top:.3rem">
                    Your name · Just now · 0 replies
                </p>
            </div>
        </div>

        <div style="display:flex;gap:.75rem;margin-top:1.5rem">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-bullhorn"></i> Share in Community
            </button>
            <a asp-action="MyRequests" class="btn btn-outline">Cancel</a>
        </div>
    </form>

</div>

@section Scripts {
<style>
.testify-banner             { display:flex; align-items:flex-start; gap:1rem;
                              background:linear-gradient(135deg,#ede9fe,#f5f3ff);
                              border:1.5px solid #c4b5fd; border-radius:var(--radius);
                              padding:1.1rem 1.25rem; margin-bottom:1.5rem; }
.testify-banner-icon        { font-size:2rem; flex-shrink:0; }
.testify-banner strong      { font-size:.9rem; font-weight:700; display:block;
                              margin-bottom:.2rem; }
.testify-banner p           { font-size:.82rem; color:var(--text-s); margin:0; }

.answered-original-card     { background:#f0fdf4; border:1.5px solid #a7f3d0;
                              border-radius:var(--radius); padding:1.1rem 1.25rem;
                              margin-bottom:1.5rem; }
.answered-original-label    { font-size:.75rem; font-weight:700; color:#065f46;
                              text-transform:uppercase; letter-spacing:.05em;
                              margin-bottom:.5rem; display:flex;
                              align-items:center; gap:.35rem; }

.testify-post-preview       { border:1px solid var(--border); border-radius:10px;
                              overflow:hidden; margin-top:1rem; }
.testify-post-preview-header{ background:var(--purple-l); color:var(--purple);
                              font-size:.78rem; font-weight:700; padding:.5rem .9rem;
                              display:flex; align-items:center; gap:.4rem; }
.testify-post-preview-body  { padding:.85rem .9rem; }
</style>
}
