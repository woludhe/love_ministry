@model ChurchMinistry.Models.MinistryGroup
@using ChurchMinistry.Models
@{
    ViewData["Title"] = Model.Name; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var memberships = ViewBag.Memberships as List<MinistryGroupMember> ?? new();
    var available = ViewBag.Available as List<Member> ?? new();
    var meets = string.Join(" · ", new[] { Model.MeetingDay, Model.MeetingTime, Model.Location }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<div class="admin-main">
    <div class="admin-topbar">
        <div>
            <h1>
                <i class="bi @ChurchMinistry.ViewModels.MinistryGroupIcons.For(Model)" style="color:var(--purple)"></i> @Model.Name
                <span class="status-badge status-@(Model.IsActive ? "active" : "inactive")" style="vertical-align:middle">@(Model.IsActive ? "Active" : "Inactive")</span>
            </h1>
            <p class="grp-meta">
                @if (Model.Leader != null) { <span><i class="fas fa-user-tie"></i> Led by @Model.Leader.FullName</span> }
                @if (meets != "") { <span><i class="fas fa-calendar"></i> @meets</span> }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="grp-meta">@Model.Description</p>
            }
        </div>
        <div style="display:flex;gap:.5rem;flex-shrink:0">
            <a asp-action="Groups" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> All Groups</a>
            <a asp-action="EditGroup" asp-route-id="@Model.Id" class="btn btn-outline btn-sm"><i class="fas fa-pen"></i> Edit</a>
        </div>
    </div>

    <h2 class="grp-section">Members <span class="grp-count">@memberships.Count</span></h2>
    @if (!memberships.Any())
    {
        <div class="grp-empty"><i class="fas fa-user-plus"></i> No members yet. Add some below.</div>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Photo</th><th>Name</th><th>Email</th><th>Phone</th><th>Added</th><th></th></tr></thead>
            <tbody>
                @foreach (var gm in memberships)
                {
                    var m = gm.Member;
                    <tr>
                        <td><img src="@(m.ProfilePhoto ?? "/images/avatar-default.png")" class="avatar-xs" /></td>
                        <td>
                            <a asp-controller="Members" asp-action="Profile" asp-route-id="@m.Id">@m.FullName</a>
                            @if (Model.LeaderId == m.Id) { <span class="tag" style="margin:0 0 0 .3rem">Leader</span> }
                            @if (m.Status != MemberStatus.Active) { <span class="status-badge status-@m.Status.ToString().ToLower()">@m.Status</span> }
                        </td>
                        <td>@m.Email</td>
                        <td>@m.Phone</td>
                        <td>@gm.JoinedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="RemoveGroupMember" asp-route-id="@Model.Id" method="post" style="margin:0">
                                <input type="hidden" name="memberId" value="@m.Id" />
                                <button type="submit" class="btn btn-outline btn-xs" data-confirm="Remove @m.FullName from @Model.Name?">
                                    <i class="fas fa-user-minus"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="grp-section" style="margin-top:2rem">Add Members</h2>
    @if (!available.Any())
    {
        <div class="grp-empty">Every active member is already in this group.</div>
    }
    else
    {
        <form asp-action="AddGroupMembers" asp-route-id="@Model.Id" method="post" class="grp-add">
            <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:.75rem">
                <input type="text" id="memberSearch" class="form-control" style="flex:1;min-width:200px"
                       placeholder="Search members by name or email..." autocomplete="off" oninput="filterMembers(this.value)" />
                <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus"></i> Add Selected (<span id="selCount">0</span>)</button>
            </div>
            <div class="form-options-grid grp-member-grid" id="memberList">
                @foreach (var m in available)
                {
                    <label class="option-toggle grp-member">
                        <input type="checkbox" name="memberIds" value="@m.Id" onchange="updateCount()" />
                        <div class="option-content">
                            <i class="fas fa-user"></i>
                            <span class="grp-member-name">@m.FullName</span>
                            <small class="grp-member-email">@m.Email</small>
                        </div>
                    </label>
                }
            </div>
        </form>
    }
</div>

<style>
.grp-meta    { color:var(--text-s);font-size:.88rem;margin-top:.35rem;display:flex;gap:1rem;flex-wrap:wrap; }
.grp-section { font-size:1.05rem;font-weight:800;margin-bottom:.75rem; }
.grp-count   { background:var(--purple-l);color:var(--purple);font-size:.72rem;font-weight:800;
               padding:.1rem .5rem;border-radius:100px;margin-left:.3rem;vertical-align:middle; }
.grp-empty   { border:1.5px dashed var(--border);border-radius:10px;padding:1.25rem;
               text-align:center;color:var(--text-s);font-size:.88rem; }
.grp-member-grid { max-height:380px;overflow-y:auto;padding:.1rem; }
.grp-member .option-content { min-width:0; }
.grp-member-email { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
@@media (max-width: 700px) { .admin-topbar { flex-direction:column;align-items:flex-start;gap:.75rem; } }
</style>

@section Scripts {
<script>
function filterMembers(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#memberList .grp-member').forEach(item => {
        const name  = item.querySelector('.grp-member-name')?.textContent.toLowerCase() ?? '';
        const email = item.querySelector('.grp-member-email')?.textContent.toLowerCase() ?? '';
        item.style.display = (name.includes(q) || email.includes(q)) ? '' : 'none';
    });
}
function updateCount() {
    document.getElementById('selCount').textContent =
        document.querySelectorAll('#memberList input:checked').length;
}
</script>
}
