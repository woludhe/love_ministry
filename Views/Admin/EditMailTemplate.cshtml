@model ChurchMinistry.ViewModels.MailTemplateFormViewModel
@{
    ViewData["Title"] = "Edit Mail Template"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var placeholders = ViewBag.Placeholders as List<(string Token, string Description)> ?? new();
    bool isMasterLayout = Model.Key == ChurchMinistry.Models.MailTemplateCatalog.MasterLayoutKey;
    var currentUserEmail = ViewBag.CurrentUserEmail as string ?? "";
}

<div class="admin-main">
    <div class="admin-topbar">
        <h1><i class="fas fa-file-code"></i> @Model.Name</h1>
        <a asp-action="MailTemplates" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="form-page" style="max-width:820px;margin:0">
        <form asp-action="EditMailTemplate" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Key" />
            <input type="hidden" asp-for="Name" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            @if (isMasterLayout)
            {
                <input type="hidden" asp-for="Subject" />
            }
            else
            {
                <div class="form-group">
                    <label asp-for="Subject">Subject</label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="field-error"></span>
                </div>
            }

            <div class="form-group">
                <label asp-for="Body">Body (HTML)</label>
                <textarea asp-for="Body" class="form-control" rows="16" style="font-family:monospace;font-size:.85rem"></textarea>
                <span asp-validation-for="Body" class="field-error"></span>
            </div>

            <div class="mt-legend">
                <h3>Available placeholders</h3>
                <ul>
                    @foreach (var p in placeholders)
                    {
                        <li><code>@p.Token</code> = @p.Description</li>
                    }
                </ul>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
        </form>

        @if (!isMasterLayout)
        {
            <form asp-action="SendTestMailTemplate" method="post" style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border)"
                  onsubmit="document.getElementById('testSubject').value = document.getElementById('Subject').value; document.getElementById('testBody').value = document.getElementById('Body').value;">
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="Key" value="@Model.Key" />
                <input type="hidden" id="testSubject" name="Subject" value="@Model.Subject" />
                <input type="hidden" id="testBody" name="Body" value="@Model.Body" />
                <p class="form-hint" style="margin:0 0 .6rem">
                    Sends the wording currently in the form above (even if unsaved), with sample data filled in.
                </p>
                <div class="form-group" style="max-width:360px">
                    <label for="testEmail">Send to</label>
                    <input type="email" id="testEmail" name="testEmail" class="form-control" value="@currentUserEmail" required />
                </div>
                <button type="submit" class="btn btn-outline"><i class="fas fa-paper-plane"></i> Send Test Email</button>
            </form>
        }

        <form asp-action="ResetMailTemplate" asp-route-id="@Model.Id" method="post" style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border)">
            <p class="form-hint" style="margin:0 0 .6rem">
                Resets the subject and body back to their original wording. This can't be undone.
            </p>
            <button type="submit" class="btn mt-reset-btn"
                    data-confirm="Reset &quot;@Model.Name&quot; to its default wording? Your changes will be lost.">
                <i class="fas fa-rotate-left"></i> Reset to Default
            </button>
        </form>
    </div>
</div>

<style>
.mt-legend { background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:1rem 1.25rem;margin:1rem 0 1.5rem; }
.mt-legend h3 { margin:0 0 .5rem;font-size:.95rem; }
.mt-legend ul { margin:0;padding-left:1.1rem;font-size:.85rem;color:var(--text-s); }
.mt-legend li { margin-bottom:.25rem; }
.mt-legend code { color:var(--purple);font-weight:600; }
.mt-reset-btn { background:var(--amber, #d97706);color:white;border:none; }
.mt-reset-btn:hover { background:#b45309;color:white; }
</style>
