@model ChurchMinistry.Models.ServiceSession?
@{
    ViewData["Title"] = "Attendance Report"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}
<div class="member-main">
    <section class="page-header">
        <h1>Attendance Report</h1>
        @if (Model != null)
        {
            <p>@Model.Title – @Model.ServiceDate.ToString("dddd, dd MMMM yyyy")</p>
        }
    </section>

    <div class="container">
        @if (Model != null)
        {
            <div class="kpi-grid" style="margin-bottom:2rem">
                <div class="kpi-card kpi-purple">
                    <div class="kpi-icon"><i class="fas fa-users"></i></div>
                    <div class="kpi-info"><span class="kpi-label">Total Attendance</span><span class="kpi-value">@Model.AttendanceRecords.Count</span></div>
                </div>
            </div>
            <div class="table-card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
                    <h3>Attendees</h3>
                    <button onclick="window.print()" class="btn btn-outline btn-sm"><i class="fas fa-print"></i> Print</button>
                </div>
                <table class="data-table">
                    <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Check-in Time</th><th>Method</th></tr></thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var a in Model.AttendanceRecords.OrderBy(a => a.CheckInTime))
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@a.Member.FullName</td>
                                <td>@a.Member.Email</td>
                                <td>@a.CheckInTime.ToString("h:mm tt")</td>
                                <td><span class="tag">@a.CheckInMethod</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>Session not found.</p>
        }
        <a asp-action="Attendance" class="btn btn-outline" style="margin-top:1rem"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
</div>