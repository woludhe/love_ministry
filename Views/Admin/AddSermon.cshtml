@model ChurchMinistry.Models.Sermon
@{
    ViewData["Title"] = "Add Sermon";
    Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}

<div class="member-main">
    <section class="page-header">
        <h1><i class="fas fa-plus-circle"></i> Add New Sermon</h1>
    </section>

    <div class="form-page">
        <form asp-action="AddSermon" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Title">Title <span style="color:var(--coral)">*</span></label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Speaker">Speaker</label>
                    <input asp-for="Speaker" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="SeriesName">Series Name</label>
                    <input asp-for="SeriesName" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="SermonDate">Sermon Date</label>
                    <input asp-for="SermonDate" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ScriptureReference">Scripture Reference</label>
                <input asp-for="ScriptureReference" class="form-control" placeholder="e.g. John 3:16" />
            </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Tags">Tags (comma separated)</label>
                <input asp-for="Tags" class="form-control" placeholder="faith, prayer, healing" />
            </div>

            @* {{-- ═══════════════════════════════════════════════════
            DELIVERY MODE
            Pick one: video, audio, live stream URL or meeting room
            ═══════════════════════════════════════════════════ --}} *@

            <div class="form-group">
                <label>Delivery Mode</label>
                <div class="delivery-modes">
                    <label class="delivery-mode-card">
                        <input type="radio" name="deliveryMode" value="video" checked />
                        <i class="fas fa-video"></i> Video
                    </label>
                    <label class="delivery-mode-card">
                        <input type="radio" name="deliveryMode" value="audio" />
                        <i class="fas fa-headphones"></i> Audio
                    </label>
                    <label class="delivery-mode-card">
                        <input type="radio" name="deliveryMode" value="live" />
                        <i class="fas fa-broadcast-tower"></i> Live Stream URL
                    </label>
                    <label class="delivery-mode-card">
                        <input type="radio" name="deliveryMode" value="meeting" />
                        <i class="fas fa-users"></i> Online Meeting Room
                    </label>
                </div>
            </div>

            <div class="delivery-panel" data-mode="video">
                <div class="form-group">
                    <label asp-for="VideoUrl">Video URL</label>
                    <input asp-for="VideoUrl" class="form-control"
                           placeholder="https://youtu.be/... or a Facebook video link"
                           oninput="checkVideoLink(this)" />
                    <small class="meta">YouTube or Facebook video link, or a direct .mp4 link. When the sermon goes live it plays as a premiere: everyone watches the same moment.</small>
                    <small class="meta link-warn" style="display:none"></small>
                </div>
            </div>

            <div class="delivery-panel" data-mode="audio">
                <partial name="_AudioPicker" model="Model" />
            </div>

            @* {{-- Meeting room picker --}} *@
            <div id="meetingRoomGroup" class="delivery-panel" data-mode="meeting">
                <div class="form-group">
                    <label asp-for="MeetingRoomCode">
                        <i class="fas fa-link" style="color:var(--purple)"></i>
                        Meeting Room Code
                    </label>
                    <div style="display:flex;gap:.6rem">
                        <select asp-for="MeetingRoomCode" class="form-control" id="roomCodeSelect"
                                onchange="updateRoomPreview(this)">
                            <option value="">— Select a meeting room —</option>
                            @foreach (var room in (ViewBag.MeetingRooms as List<ChurchMinistry.Models.MeetingRoom>
                            ?? new List<ChurchMinistry.Models.MeetingRoom>()))
                            {
                                <option value="@room.RoomCode">
                                    @room.RoomCode — @room.Title
                                    (@room.MeetingType
                                    @(room.Status == ChurchMinistry.Models.RoomStatus.Live ? "• LIVE" :
                                        room.ScheduledAt.HasValue
                                        ? "• " + room.ScheduledAt.Value.ToString("dd MMM h:mm tt")
                                        : ""))
                                </option>
                            }
                        </select>
                        <a asp-controller="Meeting" asp-action="Create" target="_blank"
                           class="btn btn-outline btn-sm" style="white-space:nowrap">
                            <i class="fas fa-plus"></i> New Room
                        </a>
                    </div>
                    <small class="meta">
                        No room yet?
                        <a asp-controller="Meeting" asp-action="Create" target="_blank">Create one first</a>
                        then refresh this page.
                    </small>
                </div>

                <div id="roomPreviewCard" style="display:none;background:var(--purple-l);border:1px solid #ddd6fe;border-radius:10px;padding:1rem;margin-bottom:1.25rem">
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <div style="width:38px;height:38px;background:var(--purple);border-radius:8px;display:flex;align-items:center;justify-content:center;color:white">
                            <i class="fas fa-video"></i>
                        </div>
                        <div>
                            <div id="previewTitle" style="font-weight:700;font-size:.9rem"></div>
                            <div id="previewCode" style="font-size:.78rem;color:var(--text-s);font-family:monospace"></div>
                        </div>
                        <span id="previewStatus" class="status-badge" style="margin-left:auto"></span>
                    </div>
                    <p class="form-hint" style="margin-top:.5rem">
                        <i class="fas fa-info-circle"></i>
                        Logged-in members get full meeting controls.
                        Guests see the video stream only.
                    </p>
                </div>
            </div>

            @* {{-- Standard live stream URL --}} *@
            <div id="liveStreamGroup" class="delivery-panel" data-mode="live">
                <div class="form-group">
                    <label asp-for="LiveStreamUrl">
                        <i class="fas fa-broadcast-tower" style="color:var(--coral)"></i>
                        Live Stream URL
                    </label>
                    <input asp-for="LiveStreamUrl" class="form-control"
                           placeholder="https://youtube.com/live/... or a Facebook Live link"
                           oninput="checkVideoLink(this)" />
                    <small class="meta link-warn" style="display:none"></small>
                    <small class="meta">YouTube Live or Facebook Live link, or an HLS (.m3u8) stream. Streaming from OBS? Stream to YouTube or Facebook Live and paste its link here.</small>
                </div>
            </div>

            <div class="form-group">
                <label>Thumbnail Image</label>
                <input type="file" name="thumbnail" accept="image/*" class="form-control"
                       onchange="previewThumb(this)" />
                <div id="thumbPreviewWrap" style="margin-top:.5rem;display:none">
                    <img id="thumbPreview" style="max-width:240px;border-radius:8px" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group checkbox-group">
                    <label><input asp-for="IsPublished" type="checkbox" checked /> Active (visible to the public)</label>
                </div>
                <div class="form-group checkbox-group">
                    <label><input asp-for="TrackAttendance" type="checkbox" /> Track attendance</label>
                    <small class="meta">Logs who joins on the Live page or meeting room, with location if they allow it.</small>
                </div>
            </div>

            <div style="display:flex;gap:.75rem;margin-top:1.5rem">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save Sermon
                </button>
                <a asp-action="Sermons" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Warn about links the Live page can't play
        function checkVideoLink(input) {
            const warn = input.parentElement.querySelector('.link-warn');
            const v = input.value.trim().toLowerCase();
            let msg = '';
            if (/youtube\.com\/(@@|c\/|user\/)/.test(v))
                msg = 'This YouTube link can\'t be embedded. Use the link from YouTube\'s Share button (youtu.be/… or youtube.com/live/…).';
            else if (v.startsWith('rtmp'))
                msg = 'Browsers can\'t play RTMP. Stream to YouTube or Facebook Live from OBS and paste that link instead.';
            warn.textContent = msg;
            warn.style.display = msg ? 'block' : 'none';
        }

        const roomData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (ViewBag.MeetingRooms as List<ChurchMinistry.Models.MeetingRoom> ?? new())
        .Select(r => new { code = r.RoomCode, title = r.Title, status = r.Status.ToString(), type = r.MeetingType.ToString() })
        ));

        // Show only the selected delivery mode's fields; only its main field is required
        function showDeliveryMode(mode) {
            document.querySelectorAll('.delivery-panel').forEach(p => {
                const on = p.dataset.mode === mode;
                p.style.display = on ? 'block' : 'none';
                const main = p.querySelector('[data-main]') ?? p.querySelector('input.form-control, select.form-control');
                if (main) main.required = on;
            });
        }
        document.querySelectorAll('input[name="deliveryMode"]').forEach(r =>
            r.addEventListener('change', () => showDeliveryMode(r.value)));
        showDeliveryMode(document.querySelector('input[name="deliveryMode"]:checked').value);

        function updateRoomPreview(sel) {
            const room = roomData.find(r => r.code === sel.value);
            const card = document.getElementById('roomPreviewCard');
            if (room) {
                document.getElementById('previewTitle').textContent = room.title;
                document.getElementById('previewCode').textContent = room.code + ' · ' + room.type;
                const s = document.getElementById('previewStatus');
                s.textContent = room.status === 'Live' ? '🔴 Live' : room.status === 'Scheduled' ? '🕐 Scheduled' : room.status;
                s.className = 'status-badge ' + (room.status === 'Live' ? 'status-active' : 'status-pending');
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        }

        function previewThumb(input) {
            if (input.files?.length) {
                const r = new FileReader();
                r.onload = e => {
                    document.getElementById('thumbPreview').src = e.target.result;
                    document.getElementById('thumbPreviewWrap').style.display = 'block';
                };
                r.readAsDataURL(input.files[0]);
            }
        }
    </script>
    <style>
        .delivery-modes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: .6rem;
        }

        .delivery-mode-card {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .7rem .9rem;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s;
        }

            .delivery-mode-card input {
                display: none;
            }

            .delivery-mode-card i {
                color: var(--text-s);
            }

            .delivery-mode-card:hover {
                border-color: var(--purple);
            }

            .delivery-mode-card:has(input:checked) {
                border-color: var(--purple);
                background: var(--purple-l);
                color: var(--purple);
            }

                .delivery-mode-card:has(input:checked) i {
                    color: var(--purple);
                }
    </style>
}
