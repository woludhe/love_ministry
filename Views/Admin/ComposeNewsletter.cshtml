@model ChurchMinistry.ViewModels.NewsletterComposeViewModel
@{
    ViewData["Title"] = "Compose Newsletter"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}
<div class="member-main">
    <section class="page-header"><h1>Compose Newsletter</h1></section>
    <div class="form-page">
        <form asp-action="ComposeNewsletter" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="form-group"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control" required /><span asp-validation-for="Subject" class="field-error"></span></div>
            <div class="form-group"><label asp-for="PreviewText">Preview Text</label><textarea asp-for="PreviewText" class="form-control" rows="5" placeholder="Short preview shown in email clients..."></textarea></div>
            <div class="form-group"><label asp-for="Body">Email Body (HTML supported)</label><textarea asp-for="Body" class="form-control" rows="12"></textarea><span asp-validation-for="Body" class="field-error"></span></div>
            <div class="form-group">
                <label>Newsletter Photo</label>
                <div class="thumbnail-preview placeholder">
                    <i class="fas fa-image fa-2x" style="color:var(--border)"></i>
                    <p class="meta">No photo set</p>
                </div>
                <input type="file" name="photo" accept="image/*" class="form-control" style="margin-top:.5rem" />
                <small class="form-hint">Shown on My Daily's lead story when this newsletter is featured.</small>
            </div>
            <div class="form-group checkbox-group"><label><input asp-for="SendNow" type="checkbox" /> Send to all subscribers now</label></div>
            <div class="form-row">
                <div class="form-group"><label asp-for="FeaturedFrom"></label><input asp-for="FeaturedFrom" type="date" class="form-control" /></div>
                <div class="form-group"><label asp-for="FeaturedUntil"></label><input asp-for="FeaturedUntil" type="date" class="form-control" /><span asp-validation-for="FeaturedUntil" class="field-error"></span></div>
            </div>
            <small class="form-hint" style="display:block;margin:-.5rem 0 1rem">
                Leave blank to not feature this on the newspaper. When set, it replaces the latest sermon as My Daily's leading story during this date range.
            </small>
            <button type="submit" class="btn btn-primary">Save Newsletter</button>
            <a asp-action="Newsletters" class="btn btn-outline">Cancel</a>
        </form>
    </div>
</div>

<style>
.thumbnail-preview { border:1px solid var(--border);border-radius:8px;padding:.75rem;background:#f9fafb;display:inline-block; }
.thumbnail-preview img { max-width:280px;max-height:160px;object-fit:cover;border-radius:6px;display:block; }
.thumbnail-preview.placeholder { display:flex;flex-direction:column;align-items:center;gap:.4rem;padding:1.5rem 2rem; }
</style>

