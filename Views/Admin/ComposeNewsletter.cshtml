@model ChurchMinistry.ViewModels.NewsletterComposeViewModel
@{
    ViewData["Title"] = "Compose Newsletter"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}
<div class="member-main">
    <section class="page-header"><h1>Compose Newsletter</h1></section>
    <div class="form-page">
        <form asp-action="ComposeNewsletter" method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="form-group"><label asp-for="Subject"></label><input asp-for="Subject" class="form-control" required /><span asp-validation-for="Subject" class="field-error"></span></div>
            <div class="form-group"><label asp-for="PreviewText">Preview Text</label><input asp-for="PreviewText" class="form-control" placeholder="Short preview shown in email clients..." /></div>
            <div class="form-group"><label asp-for="Body">Email Body (HTML supported)</label><textarea asp-for="Body" class="form-control" rows="12"></textarea><span asp-validation-for="Body" class="field-error"></span></div>
            <div class="form-group checkbox-group"><label><input asp-for="SendNow" type="checkbox" /> Send to all subscribers now</label></div>
            <button type="submit" class="btn btn-primary">Save Newsletter</button>
            <a asp-action="Newsletters" class="btn btn-outline">Cancel</a>
        </form>
    </div>
</div>

