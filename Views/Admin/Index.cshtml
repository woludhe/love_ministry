@model ChurchMinistry.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}

<!-- Main content -->
<div class="admin-main">
    <div class="admin-topbar">
        <h1>Dashboard Overview</h1>
        <span class="date-badge">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
    </div>

    @{
        var liveSermon = ViewBag.LiveSermon as ChurchMinistry.Models.Sermon;
        var audience = ((int OnLivePage, int InMeeting)?)ViewBag.LiveAudience ?? (0, 0);
    }
    @if (liveSermon != null)
    {
        var isMeeting = liveSermon.IsOnlineMeeting;
        var modeLabel = liveSermon.DeliveryMode switch
        {
            "meeting" => "Online meeting",
            "live" => "Live stream",
            "audio" => "Audio premiere",
            _ => "Video premiere"
        };
        var started = liveSermon.LiveStartedAt is DateTime s
            ? (DateTime.UtcNow - s) switch
            {
                var d when d.TotalMinutes < 1 => "just now",
                var d when d.TotalHours < 1 => $"{(int)d.TotalMinutes} min ago",
                var d when d.TotalDays < 1 => $"{(int)d.TotalHours} h {d.Minutes} min ago",
                var d => $"{(int)d.TotalDays} days ago"
            }
            : null;

        <div class="dash-live" id="dashLive" data-sermon-id="@liveSermon.Id" data-meeting="@isMeeting.ToString().ToLower()">
            <div class="dash-live-main">
                <span class="dash-live-badge"><span class="live-dot"></span> LIVE NOW</span>
                <div class="dash-live-info">
                    <strong>@liveSermon.Title</strong>
                    <span>@string.Join(" · ", new[] { liveSermon.Speaker, modeLabel, started == null ? null : $"started {started}" }
                                                  .Where(p => !string.IsNullOrWhiteSpace(p)))</span>
                </div>
            </div>
            <div class="dash-live-count" aria-live="polite">
                <span class="dash-live-num" id="dashLiveTotal">@(audience.OnLivePage + audience.InMeeting)</span>
                <span class="dash-live-label">watching</span>
                <small id="dashLiveSplit">
                    @(isMeeting ? $"{audience.OnLivePage} on Live page · {audience.InMeeting} in meeting" : "on the Live page")
                </small>
            </div>
            <div class="dash-live-actions">
                <a asp-controller="LiveSettings" asp-action="Index" asp-route-sermonId="@liveSermon.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-sliders"></i> Live Settings
                </a>
                <a asp-controller="Media" asp-action="Live" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                    <i class="fas fa-eye"></i> View
                </a>
            </div>
        </div>

        <style>
            .dash-live { display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-bottom:1.5rem;padding:1rem 1.25rem;
                         border-radius:14px;color:white;background:linear-gradient(135deg,#7f1d1d,#dc2626);
                         box-shadow:0 10px 26px rgba(220,38,38,.25); }
            .dash-live-main { flex:1;min-width:220px;display:flex;align-items:center;gap:.9rem; }
            .dash-live-badge { display:inline-flex;align-items:center;gap:.4rem;flex-shrink:0;padding:.25rem .65rem;border-radius:100px;
                               background:rgba(255,255,255,.18);font-size:.72rem;font-weight:800;letter-spacing:.06em; }
            .dash-live-badge .live-dot { background:white; }
            .dash-live-info { display:flex;flex-direction:column;min-width:0; }
            .dash-live-info strong { font-size:1.05rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
            .dash-live-info span { font-size:.82rem;opacity:.85; }
            .dash-live-count { display:grid;grid-template-columns:auto auto;align-items:baseline;column-gap:.4rem;
                               padding:.4rem .9rem;border-radius:12px;background:rgba(0,0,0,.15); }
            .dash-live-num { font-size:1.6rem;font-weight:800;line-height:1; }
            .dash-live-label { font-size:.85rem;font-weight:600; }
            .dash-live-count small { grid-column:1 / -1;font-size:.72rem;opacity:.85; }
            .dash-live-actions { display:flex;gap:.5rem; }
            .dash-live-actions .btn-primary { background:white;color:#b91c1c;border-color:white; }
            .dash-live-actions .btn-outline { color:white;border-color:rgba(255,255,255,.5); }
            .dash-live-actions .btn-outline:hover { background:rgba(255,255,255,.12); }
        </style>
        <script>
            // Keep the watching count current while the dashboard is open
            (function () {
                const box = document.getElementById('dashLive');
                const isMeeting = box.dataset.meeting === 'true';
                async function refresh() {
                    try {
                        const res = await fetch(`/Admin/LiveSettings/${box.dataset.sermonId}/Audience`);
                        if (!res.ok) return;
                        const a = await res.json();
                        document.getElementById('dashLiveTotal').textContent = a.total;
                        document.getElementById('dashLiveSplit').textContent = isMeeting
                            ? `${a.onLivePage} on Live page · ${a.inMeeting} in meeting` : 'on the Live page';
                    } catch { }
                }
                setInterval(refresh, 15000);
            })();
        </script>
    }

    <!-- KPI Cards -->
    <div class="kpi-grid">
        <div class="kpi-card kpi-purple">
            <div class="kpi-icon"><i class="fas fa-users"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Total Members</span>
                <span class="kpi-value">@Model.TotalMembers</span>
                <span class="kpi-sub">@Model.ActiveMembers active · @Model.NewMembersThisMonth new this month</span>
            </div>
        </div>
        <div class="kpi-card kpi-green">
            <div class="kpi-icon"><i class="fas fa-hand-holding-heart"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Giving This Month</span>
                <span class="kpi-value">UGX @Model.TotalGivingThisMonth.ToString("N0")</span>
                <span class="kpi-sub">Year total: UGX @Model.TotalGivingThisYear.ToString("N0")</span>
            </div>
        </div>
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Last Service Attendance</span>
                <span class="kpi-value">@Model.AttendanceLastService</span>
                <span class="kpi-sub @(Model.AttendanceGrowthPercent >= 0 ? "positive" : "negative")">
                    @(Model.AttendanceGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AttendanceGrowthPercent)% vs last service
                </span>
            </div>
        </div>
        <div class="kpi-card kpi-amber">
            <div class="kpi-icon"><i class="fas fa-hands-praying"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Prayer Requests</span>
                <span class="kpi-value">@Model.PrayerRequestsPending</span>
                <span class="kpi-sub">Awaiting response</span>
            </div>
        </div>
        <div class="kpi-card kpi-coral">
            <div class="kpi-icon"><i class="fas fa-calendar"></i></div>
            <div class="kpi-info">
                <span class="kpi-label">Upcoming Events</span>
                <span class="kpi-value">@Model.UpcomingEvents</span>
                <span class="kpi-sub">Scheduled</span>
            </div>
        </div>
    </div>

    <!-- Charts row -->
    <div class="charts-row">
        <div class="chart-card">
            <h3>Giving by Type (This Year)</h3>
            <canvas id="givingChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Members by Ministry Group</h3>
            <canvas id="groupChart" height="200"></canvas>
        </div>
    </div>

    <!-- Tables row -->
    <div class="tables-row">
        <div class="table-card">
            <div class="table-header">
                <h3>Recent Members</h3>
                <a asp-controller="Admin" asp-action="Members" class="btn btn-outline btn-sm">View All</a>
            </div>
            <table class="data-table">
                <thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.RecentMembers)
                    {
                        <tr>
                            <td>@m.FullName</td>
                            <td>@m.Email</td>
                            <td>@m.JoinDate.ToString("dd MMM yyyy")</td>
                            <td><span class="status-badge status-@m.Status.ToString().ToLower()">@m.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-card">
            <div class="table-header">
                <h3>Recent Givings</h3>
                <a asp-controller="Admin" asp-action="Givings" class="btn btn-outline btn-sm">View All</a>
            </div>
            <table class="data-table">
                <thead><tr><th>Member</th><th>Amount</th><th>Method</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var g in Model.RecentGivings)
                    {
                        <tr>
                            <td>@(g.Member?.FullName ?? "Anonymous")</td>
                            <td>@g.Currency @g.Amount.ToString("N0")</td>
                            <td><span class="method-badge">@g.PaymentMethod</span></td>
                            <td><span class="status-badge status-@g.PaymentStatus.ToString().ToLower()">@g.PaymentStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const givingData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GivingByType));
        const groupData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MembersByGroup));

        new Chart(document.getElementById('givingChart'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(givingData),
                datasets: [{ data: Object.values(givingData), backgroundColor: ['#6366f1', '#8b5cf6', '#a78bfa', '#c4b5fd', '#10b981', '#f59e0b'] }]
            },
            options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
        });

        new Chart(document.getElementById('groupChart'), {
            type: 'bar',
            data: {
                labels: Object.keys(groupData),
                datasets: [{ label: 'Members', data: Object.values(groupData), backgroundColor: '#6366f1' }]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true } } }
        });
    </script>
}
