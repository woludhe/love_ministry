<div class="admin-main">
    <div class="admin-topbar">
        <h1>Events</h1>
        <a asp-action="AddEvent" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Add Event
        </a>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Registrations</th>
                    <th>Collected</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    bool isPaid = ev.TicketPrice.HasValue && ev.TicketPrice > 0;
                    int confirmed = ev.Registrations.Count(r =>
                    r.PaymentStatus == PaymentStatus.Free ||
                    r.PaymentStatus == PaymentStatus.Successful);
                    int pending = ev.Registrations.Count(r => r.PaymentStatus == PaymentStatus.Pending);
                    decimal revenue = ev.Registrations
                    .Where(r => r.PaymentStatus == PaymentStatus.Successful)
                    .Sum(r => r.AmountPaid);

                    <tr>
                        <td class="cell-title">
                            <strong>@ev.Title</strong>
                            @if (!ev.IsPublic)
                            {
                                <span class="tag" style="font-size:.68rem">Private</span>
                            }
                        </td>
                        <td style="white-space:nowrap">
                            @ev.StartDate.ToString("dd MMM yyyy")
                            <br /><small class="meta">@ev.StartDate.ToString("h:mm tt")</small>
                        </td>
                        <td>@ev.Location</td>
                        <td>
                            @if (isPaid)
                            {
                                <span class="status-badge" style="background:#ede9fe;color:#5b21b6">
                                    <i class="fas fa-ticket-alt"></i>
                                    UGX @ev.TicketPrice!.Value.ToString("N0")
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-active">Free</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
                                <span style="font-weight:700">@confirmed</span>
                                @if (ev.MaxCapacity.HasValue)
                                {
                                    <span class="meta">/ @ev.MaxCapacity</span>
                                }
                                @if (pending > 0)
                                {
                                    <span class="status-badge status-pending" style="font-size:.7rem">
                                        @pending pending
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (isPaid && revenue > 0)
                            {
                                <strong style="color:var(--green)">UGX @revenue.ToString("N0")</strong>
                            }
                            else if (isPaid)
                            {
                                <span class="meta">-</span>
                            }
                            else
                            {
                                <span class="meta">N/A</span>
                            }
                        </td>
                        <td class="cell-actions">
                            <div style="display:flex;gap:.35rem;flex-wrap:wrap">
                                <a asp-action="EventRegistrations" asp-route-id="@ev.Id"
                                   class="btn btn-outline btn-xs" title="View Registrations">
                                    <i class="fas fa-users"></i> @ev.Registrations.Count
                                </a>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id"
                                   class="btn btn-outline btn-xs" target="_blank" title="View Public Page">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />
    </div>
</div>
