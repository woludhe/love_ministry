@model List<ChurchMinistry.Models.Newsletter>
@{
    ViewData["Title"] = "Newsletters"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}

<div class="admin-main">
    <div class="admin-topbar"><h1>Newsletters</h1><a asp-action="ComposeNewsletter" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Compose</a></div>
    <table class="data-table">
        <thead><tr><th>Subject</th><th>Status</th><th>Sent</th><th>Recipients</th><th>Featured</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td class="cell-title">@n.Subject</td>
                    <td><span class="status-badge">@n.Status</span></td>
                    <td>@n.SentAt?.ToString("dd MMM yyyy")</td>
                    <td>@n.RecipientsCount</td>
                    <td>
                        @if (n.FeaturedFrom != null && n.FeaturedUntil != null)
                        {
                            <span class="status-badge status-active">@n.FeaturedFrom.Value.ToString("dd MMM") &ndash; @n.FeaturedUntil.Value.ToString("dd MMM yyyy")</span>
                        }
                        else
                        {
                            <span>&mdash;</span>
                        }
                    </td>
                    <td class="cell-actions"><a asp-action="EditNewsletter" asp-route-id="@n.Id" class="btn btn-outline btn-xs">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />
</div>
