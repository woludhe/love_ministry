@{
    ViewData["Title"] = "Manage Members"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var groups = ViewBag.Groups as List<ChurchMinistry.Models.MinistryGroup> ?? new();
}

<div class="admin-main">
    <div class="admin-topbar">
        <h1>Members (@ViewBag.Total)</h1>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Member</a>
    </div>
    <form method="get" class="filter-bar">
        <input name="search" placeholder="Search name or email..." class="form-control" value="@Context.Request.Query["search"]" />
        <select name="status" class="form-control">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<ChurchMinistry.Models.MemberStatus>())
            {
                <option selected="@(Context.Request.Query["status"] == s.ToString())">@s</option>
            }
        </select>
        <select name="group" class="form-control">
            <option value="">All Groups</option>
            @foreach (var g in groups)
            {
                <option value="@g.Id" selected="@(Context.Request.Query["group"] == g.Id.ToString())">@g.Name</option>
            }
        </select>
        <button class="btn btn-primary">Filter</button>
    </form>
    <table class="data-table">
        <thead><tr><th>Photo</th><th>Name</th><th>Email</th><th>Phone</th><th>Groups</th><th>Joined</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (ChurchMinistry.Models.Member m in (ViewBag.Members ?? new List<ChurchMinistry.Models.Member>()))
            {
                <tr>
                    <td><img src="@(m.ProfilePhoto ?? "/images/avatar-default.png")" class="avatar-xs" /></td>
                    <td>@m.FullName</td>
                    <td>@m.Email</td>
                    <td>@m.Phone</td>
                    <td class="mem-groups">
                        @foreach (var g in m.MinistryGroups.OrderBy(g => g.Name))
                        {
                            <a asp-action="GroupDetails" asp-route-id="@g.Id" class="mem-group-icon"
                               title="@g.Name" aria-label="@g.Name"><i class="bi @ChurchMinistry.ViewModels.MinistryGroupIcons.For(g)"></i></a>
                        }
                    </td>
                    <td>@m.JoinDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-badge status-@m.Status.ToString().ToLower()">@m.Status</span></td>
                    <td>
                        <a asp-controller="Members" asp-action="Profile" asp-route-id="@m.Id" class="btn btn-outline btn-xs">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
.mem-groups     { white-space:nowrap; }
.mem-group-icon { display:inline-flex;align-items:center;justify-content:center;width:1.9rem;height:1.9rem;
                  border-radius:50%;background:var(--purple-l);color:var(--purple);font-size:.95rem;
                  margin-right:.2rem;text-decoration:none;transition:all .15s; }
.mem-group-icon:hover { background:var(--purple);color:white; }
</style>
