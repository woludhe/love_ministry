@{
    ViewData["Title"] = "Manage Members"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var groups = ViewBag.Groups as List<ChurchMinistry.Models.MinistryGroup> ?? new();
    var points = ViewBag.Points as Dictionary<int, int> ?? new();
    var lastActive = ViewBag.LastActive as Dictionary<int, DateTime> ?? new();
    var topIds = ViewBag.TopIds as HashSet<int> ?? new();
}

<div class="admin-main">
    <div class="admin-topbar">
        <h1>Members (@ViewBag.Total)</h1>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Member</a>
    </div>
    <form method="get" class="filter-bar">
        <input name="search" placeholder="Search name or email..." class="form-control" value="@Context.Request.Query["search"]" />
        <select name="status" class="form-control">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<ChurchMinistry.Models.MemberStatus>())
            {
                <option selected="@(Context.Request.Query["status"] == s.ToString())">@s</option>
            }
        </select>
        <select name="group" class="form-control">
            <option value="">All Groups</option>
            @foreach (var g in groups)
            {
                <option value="@g.Id" selected="@(Context.Request.Query["group"] == g.Id.ToString())">@g.Name</option>
            }
        </select>
        <button class="btn btn-primary">Filter</button>
    </form>
    <table class="data-table">
        <thead><tr><th>Photo</th><th>Name</th><th>Email</th><th>Phone</th><th>Groups</th><th>Joined</th><th>Profile</th><th>Last Active</th><th title="Activity points, last 30 days">Points</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (ChurchMinistry.Models.Member m in (ViewBag.Members ?? new List<ChurchMinistry.Models.Member>()))
            {
                <tr>
                    <td class="cell-media"><img src="@(m.ProfilePhoto ?? "/images/avatar-default.png")" class="avatar-xs" /></td>
                    <td class="cell-title">
                        @m.FullName
                        @if (topIds.Contains(m.Id))
                        {
                            <span class="top-badge top-badge-sm" title="Top Participant"><i class="fas fa-medal"></i></span>
                        }
                    </td>
                    <td>@m.Email</td>
                    <td>@m.Phone</td>
                    <td class="mem-groups">
                        @foreach (var g in m.MinistryGroups.OrderBy(g => g.Name))
                        {
                            <a asp-action="GroupDetails" asp-route-id="@g.Id" class="group-icon"
                               title="@g.Name" aria-label="@g.Name"><i class="bi @ChurchMinistry.ViewModels.MinistryGroupIcons.For(g)"></i></a>
                        }
                    </td>
                    <td>@m.JoinDate.ToString("dd MMM yyyy")</td>
                    @{ var pct = ChurchMinistry.Services.ProfileCompletion.For(m).Percent; }
                    <td><span class="profile-pct @(pct == 100 ? "profile-pct-full" : "")">@pct%</span></td>
                    <td>@(lastActive.TryGetValue(m.Id, out var la) ? la.ToLocalTime().ToString("dd MMM yyyy") : "—")</td>
                    <td>@points.GetValueOrDefault(m.Id)</td>
                    <td><span class="status-badge status-@m.Status.ToString().ToLower()">@m.Status</span></td>
                    <td class="cell-actions">
                        <a asp-controller="Members" asp-action="Profile" asp-route-id="@m.Id" class="btn btn-outline btn-xs">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />
</div>

<style>
.mem-groups     { white-space:nowrap; }
.mem-groups .group-icon { margin-right:.2rem; }
.mem-groups .group-icon:hover { background:var(--purple);color:white; }
</style>
