@using ChurchMinistry.Models
@{
    ViewData["Title"] = "Groups"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var groups = ViewBag.Groups as List<MinistryGroup> ?? new();
    var counts = ViewBag.MemberCounts as Dictionary<int, int> ?? new();
}

<div class="admin-main">
    <div class="admin-topbar">
        <h1>Groups (@groups.Count)</h1>
        <a asp-action="CreateGroup" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Group</a>
    </div>

    @if (!groups.Any())
    {
        <div class="grp-empty">
            <i class="fas fa-users"></i>
            <p>No groups yet. Create one, then add members to it.</p>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Name</th><th>Leader</th><th>Meets</th><th>Members</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var g in groups)
                {
                    var meets = string.Join(" · ", new[] { g.MeetingDay, g.MeetingTime, g.Location }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    <tr>
                        <td>
                            <a asp-action="GroupDetails" asp-route-id="@g.Id" class="grp-name">@g.Name</a>
                            @if (!string.IsNullOrWhiteSpace(g.Description))
                            {
                                <div class="grp-desc">@g.Description</div>
                            }
                        </td>
                        <td>@(g.Leader?.FullName ?? "—")</td>
                        <td>@(meets == "" ? "—" : meets)</td>
                        <td>@(counts.TryGetValue(g.Id, out var c) ? c : 0)</td>
                        <td><span class="status-badge status-@(g.IsActive ? "active" : "inactive")">@(g.IsActive ? "Active" : "Inactive")</span></td>
                        <td style="white-space:nowrap">
                            <a asp-action="GroupDetails" asp-route-id="@g.Id" class="btn btn-primary btn-xs"><i class="fas fa-user-plus"></i> Members</a>
                            <a asp-action="EditGroup" asp-route-id="@g.Id" class="btn btn-outline btn-xs">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
.grp-name  { font-weight:700;color:var(--text);text-decoration:none; }
.grp-name:hover { color:var(--purple); }
.grp-desc  { font-size:.78rem;color:var(--text-s);max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.grp-empty { border:1.5px dashed var(--border);border-radius:10px;padding:2rem;text-align:center;color:var(--text-s); }
.grp-empty i { font-size:1.8rem;color:var(--purple);margin-bottom:.5rem; }
</style>
