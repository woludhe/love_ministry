@model ChurchMinistry.ViewModels.MinistryGroupFormViewModel
@{
    bool isEdit = Model.Id > 0;
    var leaders = ViewBag.Leaders as List<ChurchMinistry.Models.Member> ?? new();
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
}
<div class="admin-main">
    <div class="admin-topbar">
        <h1><i class="fas fa-users"></i> @(isEdit ? $"Edit Group: {Model.Name}" : "New Group")</h1>
        @if (isEdit)
        {
            <a asp-action="GroupDetails" asp-route-id="@Model.Id" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
        }
        else
        {
            <a asp-action="Groups" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
        }
    </div>

    <div class="form-page" style="max-width:640px;margin:0">
        <form asp-action="@(isEdit ? "EditGroup" : "CreateGroup")" method="post">
            @if (isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Name">Name <span class="required-star">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Youth Ministry, Choir, Kampala Cell" maxlength="150" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="What this group is for"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="MeetingDay"></label>
                    <select asp-for="MeetingDay" class="form-control">
                        <option value="">— Not set —</option>
                        @foreach (var d in days)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="MeetingTime"></label>
                    <input asp-for="MeetingTime" class="form-control" placeholder="e.g. 6:30 PM" maxlength="50" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Location"></label>
                <input asp-for="Location" class="form-control" placeholder="e.g. Church hall, or Online" />
            </div>

            <div class="form-group">
                <label>Icon <span class="grp-icon-hint">— shown for this group in the member list</span></label>
                <div class="grp-icon-grid">
                    <label class="grp-icon-opt" title="No icon (uses the default)">
                        <input type="radio" name="Icon" value="" aria-label="No icon" @(string.IsNullOrEmpty(Model.Icon) ? "checked" : "") />
                        <i class="bi bi-slash-circle"></i>
                    </label>
                    @foreach (var (css, label) in ChurchMinistry.ViewModels.MinistryGroupIcons.All)
                    {
                        <label class="grp-icon-opt" title="@label">
                            <input type="radio" name="Icon" value="@css" aria-label="@label" @(Model.Icon == css ? "checked" : "") />
                            <i class="bi @css"></i>
                        </label>
                    }
                </div>
                <span asp-validation-for="Icon" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="LeaderId"></label>
                <select asp-for="LeaderId" class="form-control">
                    <option value="">— No leader —</option>
                    @foreach (var m in leaders)
                    {
                        <option value="@m.Id">@m.FullName (@m.Email)</option>
                    }
                </select>
                <small class="form-hint">The leader is added to the group as a member.</small>
                <span asp-validation-for="LeaderId" class="field-error"></span>
            </div>

            <div class="form-group">
                <label style="display:flex;align-items:center;gap:.5rem;font-weight:600">
                    <input asp-for="IsActive" type="checkbox" /> Active
                </label>
                <small class="form-hint">Inactive groups are hidden from the member directory filter and meeting invitations.</small>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @(isEdit ? "Save Changes" : "Create Group")</button>
        </form>

        @if (isEdit)
        {
            <form asp-action="DeleteGroup" asp-route-id="@Model.Id" method="post" style="margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--border)">
                <p class="form-hint" style="margin:0 0 .6rem">
                    Deleting the group removes everyone from it and cancels its meeting invitations. Members' accounts are not affected.
                </p>
                <button type="submit" class="btn grp-delete-btn"
                        data-confirm="Delete the group &quot;@Model.Name&quot;? Its members are removed from it and its meeting invitations are cancelled.">
                    <i class="fas fa-trash"></i> Delete Group
                </button>
            </form>
        }
    </div>
</div>

<style>
.grp-delete-btn       { background:var(--coral);color:white;border:none; }
.grp-delete-btn:hover { background:#dc2626;color:white; }
.grp-icon-hint { font-weight:400;color:var(--text-s);font-size:.8rem; }
.grp-icon-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(46px,1fr));gap:.45rem;
                 max-height:260px;overflow-y:auto;padding:.1rem; }
.grp-icon-opt  { display:flex;align-items:center;justify-content:center;aspect-ratio:1;padding:.4rem;
                 background:var(--white);border:1.5px solid var(--border);border-radius:10px;cursor:pointer;
                 transition:all .15s;min-width:0;position:relative; }
.grp-icon-opt input { position:absolute;opacity:0;pointer-events:none; }
.grp-icon-opt i     { font-size:1.35rem;color:var(--purple); }
.grp-icon-opt:hover { border-color:var(--purple); }
.grp-icon-opt:has(input:checked) { border-color:var(--purple);background:var(--purple-l); }
.grp-icon-opt:has(input:focus-visible) { outline:2px solid var(--purple);outline-offset:2px; }
</style>
