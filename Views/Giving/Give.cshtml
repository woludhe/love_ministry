@model ChurchMinistry.ViewModels.GivingViewModel
@using ChurchMinistry.Models
@{
    ViewData["Title"] = "Give";
    Layout = User.Identity?.IsAuthenticated == true ? "~/Views/Shared/_MemberDashboard_Layout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    var methods  = ViewBag.PaymentMethods as List<PaymentMethodConfig> ?? new();
    var selected = ViewBag.SelectedMethod as PaymentMethodConfig;
    var memberName  = ViewBag.MemberName  as string ?? "";
    var memberEmail = ViewBag.MemberEmail as string ?? "";
}

<div class="gv-page">
    <section class="page-header">
        <h1><i class="fas fa-hand-holding-heart"></i> Give</h1>
        <p class="gv-hero-verse">"Give, and it will be given to you — good measure, pressed down, shaken together, running over." <span>Luke 6:38</span></p>
    </section>

    @* Errors (TempData["Error"]) are shown by the layout *@
    <div class="gv-body">

        @if (!methods.Any())
        {
            <div class="gv-empty">
                <i class="fas fa-info-circle fa-2x"></i>
                <h3>No payment methods available</h3>
                <p>Please check back later or contact the church office.</p>
            </div>
        }
        else
        {
            @* Safe JSON island — Razor serializes here, JS reads it *@
            <script id="methodsData" type="application/json">
                @Html.Raw(ViewBag.MethodsJson as string ?? "[]")
            </script>

            <form method="post" asp-action="Give" id="giveForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MethodCode" id="methodCode" />
                <input type="hidden" asp-for="Currency"   id="currencyField" />

                <div class="gv-layout">

                    @* ── Left: Payment method selector ── *@
                    <div class="gv-col gv-col-methods">
                        <h2 class="gv-section-title">Choose Payment Method</h2>

                        <div class="gv-methods" id="methodList">
                            @foreach (var m in methods)
                            {
                                <button type="button"
                                        class="gv-method-btn @(selected?.Code == m.Code ? "active" : "")"
                                        data-code="@m.Code"
                                        data-name="@m.Name"
                                        data-currency="@m.Currency"
                                        data-symbol="@m.CurrencySymbol"
                                        data-type="@m.IntegrationType.ToString().ToLower()"
                                        data-amounts="@m.DefaultAmounts"
                                        onclick="selectMethod(this)">
                                    <span class="gv-method-badge" style="background:@m.BadgeColor">
                                        @m.BadgeLabel
                                    </span>
                                    <div class="gv-method-info">
                                        <span class="gv-method-name">@m.Name</span>
                                        <span class="gv-method-currency">@m.Currency · @m.CurrencySymbol</span>
                                    </div>
                                    <i class="fas fa-chevron-right gv-method-arrow"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @* ── Right: Amount + type + details ── *@
                    <div class="gv-col gv-col-form">
                        <h2 class="gv-section-title">Giving Details</h2>

                        @* Quick amounts *@
                        <div class="gv-field">
                            <label class="gv-label">Quick Amount</label>
                            <div class="gv-amounts" id="quickAmounts">
                                @* Rendered by JS on method select *@
                            </div>
                        </div>

                        @* Custom amount *@
                        <div class="gv-field">
                            <label class="gv-label" for="amountInput">
                                Amount <span id="currencyLabel">(@(selected?.CurrencySymbol ?? ""))</span>
                                <span class="gv-req">*</span>
                            </label>
                            <div class="gv-amount-input-wrap">
                                <span class="gv-currency-prefix" id="currencyPrefix">
                                    @(selected?.CurrencySymbol ?? "")
                                </span>
                                <input asp-for="Amount" type="number" id="amountInput"
                                       class="form-control gv-amount-input"
                                       placeholder="Enter amount" min="1000" step="100" required />
                            </div>
                            <span asp-validation-for="Amount" class="gv-error"></span>
                        </div>

                        @* Giving type *@
                        <div class="gv-field">
                            <label class="gv-label">Giving Type <span class="gv-req">*</span></label>
                            <div class="gv-type-grid">
                                @foreach (var type in Enum.GetValues<GivingType>())
                                {
                                    var icons = new Dictionary<GivingType, string>
                                    {
                                        [GivingType.Tithe]    = "fa-percentage",
                                        [GivingType.Offering] = "fa-hand-holding-heart",
                                        [GivingType.Seed]     = "fa-seedling",
                                        [GivingType.Partnership] = "fa-handshake",
                                        [GivingType.Welfare]  = "fa-heart",
                                        [GivingType.Missions]  = "fa-globe-africa",
                                    };
                                    var icon = icons.TryGetValue(type, out var ic) ? ic : "fa-gift";
                                    <label class="gv-type-opt @(Model.GivingType == type ? "active" : "")">
                                        <input type="radio" asp-for="GivingType" value="@type"
                                               onchange="this.closest('.gv-type-grid').querySelectorAll('.gv-type-opt').forEach(e=>e.classList.remove('active'));this.closest('.gv-type-opt').classList.add('active')" />
                                        <i class="fas @icon"></i>
                                        <span>@type</span>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="GivingType" class="gv-error"></span>
                        </div>

                        @* Phone (mobile money only) *@
                        <div class="gv-field" id="phoneField" style="display:none">
                            <label class="gv-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control"
                                   placeholder="e.g. 0771234567" type="tel" id="phoneInput" />
                            <span class="gv-hint">The number registered with your mobile money.</span>
                        </div>

                        @* Notes *@
                        <div class="gv-field">
                            <label class="gv-label">Note <span class="gv-hint">(optional)</span></label>
                            <input asp-for="Notes" class="form-control" placeholder="e.g. For building fund" />
                        </div>

                        @* Giving reminder (members only: we need someone to remind) *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="gv-field">
                                <label class="gv-check-label">
                                    <input asp-for="IsRecurring" type="checkbox" class="gv-checkbox"
                                           onchange="document.getElementById('recurringRow').style.display=this.checked?'block':'none'" />
                                    Remind me to give this regularly
                                </label>
                            </div>
                            <div id="recurringRow" style="display:none" class="gv-field">
                                <label class="gv-label">Remind me every</label>
                                <select asp-for="RecurringInterval" class="form-control">
                                    <option value="Monthly">Month</option>
                                    <option value="Weekly">Week</option>
                                    <option value="Quarterly">Quarter</option>
                                    <option value="Annually">Year</option>
                                </select>
                                <span class="gv-hint">When it's due we'll send you a notification and email with a link to give the same amount. Nothing is charged automatically, and you can stop reminders from Giving Reminders in your account.</span>
                            </div>
                        }

                        @* Instructions preview (manual only) *@
                        <div class="gv-instructions" id="instructionsPanel" style="display:none">
                            <div class="gv-instructions-header">
                                <i class="fas fa-info-circle"></i>
                                <span>Payment Instructions</span>
                            </div>
                            <p class="gv-instructions-text" id="instructionsText"></p>
                            <img id="instructionsImage" style="display:none"
                                 class="gv-instructions-img" alt="Payment instructions" />
                        </div>

                        @* Submit *@
                        <button type="submit" class="btn btn-primary btn-lg btn-full gv-submit-btn" id="submitBtn">
                            <i class="fas fa-heart"></i>
                            <span id="submitLabel">Give Now</span>
                        </button>

                        <p class="gv-secure-note">
                            <i class="fas fa-lock"></i> Secured by Flutterwave &amp; SSL
                        </p>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>

        // ── Method config from Razor ──────────────────────────────
        // Payment methods data — serialized from server, no Razor/JS mixing
        const _raw = document.getElementById('methodsData')?.textContent ?? '[]';
        const METHODS_LIST = JSON.parse(_raw);
        // Build a lookup map by code for fast access
        const METHODS_DATA = Object.fromEntries(METHODS_LIST.map(m => [m.code, m]));

        // ── Select a method ───────────────────────────────────────
        function selectMethod(btn) {
            // Update active class
            document.querySelectorAll('.gv-method-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const code = btn.dataset.code;
            const cfg = METHODS_DATA[code];
            if (!cfg) return;

            // Update hidden fields
            document.getElementById('methodCode').value = code;
            document.getElementById('currencyField').value = cfg.currency;

            // Update currency display
            document.getElementById('currencyPrefix').textContent = cfg.currencySymbol;
            document.getElementById('currencyLabel').textContent = `(${cfg.currencySymbol})`;

            // Render quick amounts
            renderAmounts(cfg.amounts, cfg.currencySymbol);

            // Phone field — show for mobile money methods
            const isMobile = code === 'mtn' || code === 'airtel' || code === 'mpesa';
            document.getElementById('phoneField').style.display = isMobile ? 'block' : 'none';
            document.getElementById('phoneInput').required = isMobile;

            // Instructions panel
            const panel = document.getElementById('instructionsPanel');
            if (cfg.integrationType === 'manual' && cfg.instructionsText) {
                document.getElementById('instructionsText').textContent = cfg.instructionsText;
                const img = document.getElementById('instructionsImage');
                if (cfg.instructionsImage) {
                    img.src = cfg.instructionsImage;
                    img.style.display = 'block';
                } else {
                    img.style.display = 'none';
                }
                panel.style.display = 'block';
            } else {
                panel.style.display = 'none';
            }

            // Submit button label
            document.getElementById('submitLabel').textContent =
                cfg.integrationType === 'flutterwave' ? 'Pay with Card' : 'Continue to Pay';
        }

        function renderAmounts(amounts, symbol) {
            const container = document.getElementById('quickAmounts');
            container.innerHTML = (amounts || []).map(amt =>
                `<button type="button" class="gv-amt-btn" onclick="pickAmount(${amt}, this)">
                    ${symbol} ${parseInt(amt).toLocaleString()}
                 </button>`
            ).join('');
        }

        function pickAmount(val, btn) {
            document.querySelectorAll('.gv-amt-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            document.getElementById('amountInput').value = val;
        }

        // ── Boot: initialise the pre-selected method ──────────────
        const preSelected = document.querySelector('.gv-method-btn.active');
        if (preSelected) selectMethod(preSelected);

        // ── Form submit loading state ─────────────────────────────
        document.getElementById('giveForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing…';
        });

    </script>
}
<style>
/* Uses the site's colours, cards, form fields and buttons (site.css) */
.gv-hero-verse  { font-style:italic; }
.gv-hero-verse span { font-style:normal; font-weight:600; margin-left:.25rem; }

/* Body layout */
.gv-body        { max-width:1000px;margin:0 auto;padding:2rem 1.5rem; }
.gv-layout      { display:grid;grid-template-columns:320px 1fr;gap:1.5rem;align-items:start; }
.gv-col         { background:var(--white);border:1px solid var(--border);
                  border-radius:var(--radius);padding:1.5rem;box-shadow:var(--shadow); }
.gv-section-title{ font-size:.8rem;font-weight:700;color:var(--text-s);
                   text-transform:uppercase;letter-spacing:.05em;margin-bottom:1rem; }

/* Method list */
.gv-methods     { display:flex;flex-direction:column;gap:.5rem; }
.gv-method-btn  { display:flex;align-items:center;gap:.85rem;width:100%;
                  background:var(--white);border:1.5px solid var(--border);
                  border-radius:10px;padding:.75rem;cursor:pointer;font-family:inherit;
                  text-align:left;color:var(--text);transition:all .15s; }
.gv-method-btn:hover{ border-color:var(--purple); }
.gv-method-btn.active{ background:var(--purple-l);border-color:var(--purple); }
.gv-method-badge{ width:46px;height:28px;border-radius:6px;display:flex;flex-shrink:0;
                  align-items:center;justify-content:center;
                  font-size:.7rem;font-weight:800;color:white; }
.gv-method-info { flex:1;display:flex;flex-direction:column;gap:.1rem; }
.gv-method-name { font-size:.9rem;font-weight:600; }
.gv-method-currency{ font-size:.75rem;color:var(--text-s); }
.gv-method-arrow{ color:var(--text-s);font-size:.75rem; }
.gv-method-btn.active .gv-method-arrow{ color:var(--purple); }

/* Form fields */
.gv-field       { margin-bottom:1.1rem; }
.gv-label       { display:block;font-size:.88rem;font-weight:600;color:var(--text);margin-bottom:.4rem; }
.gv-req         { color:var(--coral); }
.gv-hint        { display:inline-block;font-size:.78rem;font-weight:400;color:var(--text-s);margin-top:.25rem; }
.gv-error       { font-size:.8rem;color:var(--coral);margin-top:.25rem;display:block; }
.gv-check-label { display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.9rem; }
.gv-checkbox    { width:16px;height:16px;accent-color:var(--purple); }

/* Quick amounts */
.gv-amounts     { display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem; }
.gv-amt-btn     { background:var(--white);border:1.5px solid var(--border);font-family:inherit;
                  color:var(--text);border-radius:8px;padding:.5rem .3rem;
                  font-size:.8rem;font-weight:600;cursor:pointer;transition:all .15s;text-align:center; }
.gv-amt-btn:hover{ border-color:var(--purple);color:var(--purple); }
.gv-amt-btn.selected{ background:var(--purple);border-color:var(--purple);color:var(--white); }

/* Amount input */
.gv-amount-input-wrap{ position:relative; }
.gv-currency-prefix { position:absolute;left:.9rem;top:50%;transform:translateY(-50%);
                      color:var(--text-s);font-weight:700;font-size:.85rem;pointer-events:none; }
.gv-amount-input{ padding-left:3.2rem !important; }

/* Giving type */
.gv-type-grid   { display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem; }
.gv-type-opt    { display:flex;flex-direction:column;align-items:center;gap:.3rem;
                  padding:.7rem .4rem;border:1.5px solid var(--border);background:var(--white);
                  border-radius:10px;cursor:pointer;font-size:.8rem;font-weight:600;
                  color:var(--text-s);transition:all .15s;text-align:center; }
.gv-type-opt input{ display:none; }
.gv-type-opt i  { font-size:1.1rem; }
.gv-type-opt:hover{ border-color:var(--purple);color:var(--text); }
.gv-type-opt.active{ border-color:var(--purple);background:var(--purple-l);color:var(--purple); }

/* Instructions */
.gv-instructions{ background:var(--purple-l);border:1px solid var(--border);
                  border-radius:10px;padding:1rem;margin-bottom:1rem; }
.gv-instructions-header{ display:flex;align-items:center;gap:.5rem;
                          font-size:.85rem;font-weight:700;color:var(--purple);margin-bottom:.6rem; }
.gv-instructions-text{ font-size:.88rem;color:var(--text);line-height:1.7;white-space:pre-line;margin:0; }
.gv-instructions-img{ max-width:180px;border-radius:10px;margin-top:.75rem;border:1px solid var(--border); }

/* Submit */
.gv-submit-btn  { margin-top:.25rem; }
.gv-submit-btn:disabled{ opacity:.7;cursor:not-allowed; }
.gv-secure-note { text-align:center;font-size:.78rem;color:var(--text-s);margin-top:.75rem; }

.gv-empty       { text-align:center;padding:4rem 1.5rem;color:var(--text-s); }
.gv-empty h3    { font-size:1.15rem;color:var(--text);margin:.75rem 0 .4rem; }

@@media(max-width:720px){
    .gv-layout    { grid-template-columns:1fr; }
    .gv-type-grid { grid-template-columns:repeat(2,1fr); }
    .gv-amounts   { grid-template-columns:repeat(2,1fr); }
}
</style>
