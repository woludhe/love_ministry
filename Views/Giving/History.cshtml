@model ChurchMinistry.ViewModels.GivingHistoryViewModel
@{
    ViewData["Title"] = "Giving History"; 
    @if (User.Identity?.IsAuthenticated == true)
    {
        Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
<section class="page-header"><h1><i class="fas fa-history"></i> My Giving History</h1></section>
<div class="container">
  <div class="kpi-grid" style="margin-bottom:2rem">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon"><i class="fas fa-calendar-check"></i></div>
      <div class="kpi-info"><span class="kpi-label">This Month</span><span class="kpi-value">UGX @Model.TotalThisMonth.ToString("N0")</span></div>
    </div>
    <div class="kpi-card kpi-purple">
      <div class="kpi-icon"><i class="fas fa-hand-holding-heart"></i></div>
      <div class="kpi-info"><span class="kpi-label">This Year</span><span class="kpi-value">UGX @Model.TotalThisYear.ToString("N0")</span></div>
    </div>
  </div>
  @if (Model.ByType.Any()) {
    <div class="table-card" style="margin-bottom:2rem">
      <h3>By Category</h3>
      @foreach (var kv in Model.ByType) {
        <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid #f3f4f6">
          <span>@kv.Key</span><strong>UGX @kv.Value.ToString("N0")</strong>
        </div>
      }
    </div>
  }
  <div class="table-card">
    <table class="data-table">
      <thead><tr><th>Date</th><th>Type</th><th>Amount</th><th>Method</th><th>Status</th><th>Ref</th></tr></thead>
      <tbody>
      @foreach (var g in Model.Givings) {
        <tr>
          <td>@g.GivingDate.ToString("dd MMM yyyy")</td>
          <td>@g.GivingType</td>
          <td class="cell-title">@g.Currency @g.Amount.ToString("N0")</td>
          <td><span class="method-badge">@g.PaymentMethod</span></td>
          <td><span class="status-badge status-@g.PaymentStatus.ToString().ToLower()">@g.PaymentStatus</span></td>
          <td class="meta">@g.TransactionId</td>
        </tr>
      }
      @if (!Model.Givings.Any()) { <tr><td colspan="6" style="text-align:center;padding:2rem">No giving records yet. <a asp-controller="Giving" asp-action="Give">Give now</a></td></tr> }
      </tbody>
    </table>
    <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />
  </div>
  <div style="margin-top:1.5rem">
    <a asp-controller="Giving" asp-action="Give" class="btn btn-primary"><i class="fas fa-hand-holding-heart"></i> Give Again</a>
  </div>
</div>
