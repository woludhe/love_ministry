@model ChurchMinistry.Models.Giving
@{
    ViewData["Title"] = "Thank You";
    Layout = User.Identity?.IsAuthenticated == true ? "~/Views/Shared/_MemberDashboard_Layout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    var isPending = Model.PaymentStatus == ChurchMinistry.Models.PaymentStatus.PendingVerification;
}

<div class="ty-page">
    <div class="ty-card">
        <div class="ty-icon @(isPending ? "ty-icon-pending" : "ty-icon-done")">
            <i class="fas fa-@(isPending ? "clock" : "check-circle")"></i>
        </div>

        <h1>@(isPending ? "Gift Recorded!" : "Thank You! 🙏")</h1>

        <p class="ty-text">
            @if (isPending)
            {
                <span>
                    Your gift of <strong>@Model.Currency @Model.Amount.ToString("N0")</strong>
                    has been recorded and is pending verification.
                    Our team will confirm it shortly.
                </span>
            }
            else
            {
                <span>
                    Your @Model.GivingType of
                    <strong>@Model.Currency @Model.Amount.ToString("N0")</strong>
                    has been received. May God bless you abundantly.
                </span>
            }
        </p>

        <div class="ty-ref">
            Reference: <code>@Model.TransactionId</code>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">
            <i class="fas fa-home"></i> Home
        </a>
    </div>
</div>

<style>
/* Uses the site's colours, card and buttons (site.css) */
.ty-page  { display:flex;justify-content:center;padding:3rem 1rem; }
.ty-card  { background:var(--white);border:1px solid var(--border);box-shadow:var(--shadow);
            border-radius:var(--radius);padding:2.5rem;max-width:480px;width:100%;text-align:center; }
.ty-card h1 { font-size:1.6rem;font-weight:800;margin-bottom:.5rem; }
.ty-icon  { width:80px;height:80px;border-radius:50%;display:flex;align-items:center;justify-content:center;
            margin:0 auto 1.25rem;font-size:2rem; }
.ty-icon-pending { background:var(--purple-l);color:var(--purple); }
.ty-icon-done    { background:#d1fae5;color:var(--green); }
.ty-text  { color:var(--text-s);font-size:.95rem;line-height:1.7;margin-bottom:1.5rem; }
.ty-text strong { color:var(--text); }
.ty-ref   { background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:.85rem;
            margin-bottom:1.5rem;font-size:.85rem;color:var(--text-s); }
.ty-ref code { color:var(--text);font-size:.85rem; }
</style>
