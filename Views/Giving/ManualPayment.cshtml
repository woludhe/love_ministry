@model ChurchMinistry.Models.Giving
@using ChurchMinistry.Models
@{
    ViewData["Title"] = "Complete Your Giving";
    Layout = User.Identity?.IsAuthenticated == true ? "~/Views/Shared/_MemberDashboard_Layout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    var method = ViewBag.Method as PaymentMethodConfig;
    var txRef  = ViewBag.TxRef as string ?? Model.TransactionId;
}

<div class="mp-page">
    <div class="mp-card">

        <div class="mp-header">
            <div class="mp-badge" style="background:@(method?.BadgeColor ?? "#374151")">
                @(method?.BadgeLabel ?? "PAY")
            </div>
            <div>
                <h1 class="mp-title">@(method?.Name ?? "Payment")</h1>
                <p class="mp-subtitle">Complete your giving of
                    <strong>@Model.Currency @Model.Amount.ToString("N0")</strong>
                </p>
            </div>
        </div>

        <div class="mp-amount-display">
            <span class="mp-amount-label">Amount to Pay</span>
            <span class="mp-amount-value">
                @(method?.CurrencySymbol ?? Model.Currency) @Model.Amount.ToString("N0")
            </span>
            <span class="mp-ref">Ref: @txRef</span>
        </div>

        @if (!string.IsNullOrEmpty(method?.InstructionsText))
        {
            <div class="mp-instructions">
                <h2 class="mp-instructions-title">
                    <i class="fas fa-info-circle"></i> How to Pay
                </h2>
                <p class="mp-instructions-text">@method.InstructionsText</p>

                @if (!string.IsNullOrEmpty(method.InstructionsImagePath))
                {
                    <div class="mp-qr-wrap">
                        <img src="@method.InstructionsImagePath"
                             class="mp-qr" alt="Payment QR / Paybill" />
                        <p class="mp-qr-caption">Scan or use the details above</p>
                    </div>
                }
            </div>
        }

        <div class="mp-steps">
            <div class="mp-step">
                <div class="mp-step-num">1</div>
                <div class="mp-step-text">Follow the payment instructions above</div>
            </div>
            <div class="mp-step">
                <div class="mp-step-num">2</div>
                <div class="mp-step-text">
                    Use reference <strong>@txRef</strong> as your account/reason
                </div>
            </div>
            <div class="mp-step">
                <div class="mp-step-num">3</div>
                <div class="mp-step-text">
                    Click <strong>"I Have Paid"</strong> below to notify the church
                </div>
            </div>
        </div>

        <form method="post" asp-action="ConfirmManual" id="confirmForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="givingId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary btn-lg btn-full mp-confirm-btn" id="confirmBtn">
                <i class="fas fa-check-circle"></i> I Have Paid
            </button>
        </form>

        <div class="mp-footer-links">
            <a asp-action="Give" class="mp-link">
                <i class="fas fa-arrow-left"></i> Choose a different method
            </a>
            <span class="mp-divider">·</span>
            <span class="mp-note">
                <i class="fas fa-shield-alt"></i> Your giving is recorded securely
            </span>
        </div>
    </div>
</div>

<style>
/* Uses the site's colours, card and buttons (site.css) */
.mp-page        { display:flex;justify-content:center;padding:2.5rem 1rem; }
.mp-card        { background:var(--white);border:1px solid var(--border);box-shadow:var(--shadow);
                  border-radius:var(--radius);padding:2rem;max-width:520px;width:100%; }
.mp-header      { display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem; }
.mp-badge       { width:56px;height:34px;border-radius:8px;display:flex;
                  align-items:center;justify-content:center;
                  font-size:.75rem;font-weight:800;color:white;flex-shrink:0; }
.mp-title       { font-size:1.3rem;font-weight:800;color:var(--text); }
.mp-subtitle    { font-size:.88rem;color:var(--text-s);margin-top:.1rem; }
.mp-subtitle strong{ color:var(--text); }

.mp-amount-display{ background:var(--purple-l);border-radius:12px;padding:1.25rem;
                    text-align:center;margin-bottom:1.5rem; }
.mp-amount-label{ display:block;font-size:.75rem;font-weight:600;color:var(--text-s);
                  text-transform:uppercase;letter-spacing:.05em;margin-bottom:.3rem; }
.mp-amount-value{ display:block;font-size:2rem;font-weight:800;color:var(--purple);margin-bottom:.3rem; }
.mp-ref         { font-size:.78rem;color:var(--text-s);font-family:monospace;letter-spacing:.04em; }

.mp-instructions{ border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:1.5rem; }
.mp-instructions-title{ font-size:.9rem;font-weight:700;color:var(--purple);
                         display:flex;align-items:center;gap:.45rem;margin-bottom:.75rem; }
.mp-instructions-text{ font-size:.9rem;color:var(--text);line-height:1.8;white-space:pre-line;margin:0; }
.mp-qr-wrap     { margin-top:1rem;text-align:center; }
.mp-qr          { max-width:160px;border-radius:10px;border:1px solid var(--border);margin:0 auto; }
.mp-qr-caption  { font-size:.78rem;color:var(--text-s);margin-top:.4rem; }

.mp-steps       { display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.75rem; }
.mp-step        { display:flex;align-items:center;gap:.85rem; }
.mp-step-num    { width:28px;height:28px;border-radius:50%;background:var(--purple);
                  display:flex;align-items:center;justify-content:center;
                  font-size:.8rem;font-weight:800;color:var(--white);flex-shrink:0; }
.mp-step-text   { font-size:.9rem;color:var(--text-s);line-height:1.5; }
.mp-step-text strong{ color:var(--text); }

.mp-confirm-btn { margin-bottom:1rem; }
.mp-confirm-btn:disabled{ opacity:.7;cursor:not-allowed; }

.mp-footer-links{ display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap; }
.mp-link        { font-size:.85rem; }
.mp-divider     { color:var(--border); }
.mp-note        { font-size:.8rem;color:var(--text-s);display:flex;align-items:center;gap:.3rem; }
</style>

@section Scripts {
<script>
document.getElementById('confirmForm')?.addEventListener('submit', function() {
    const btn = document.getElementById('confirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Recording your gift…';
});
</script>
}
