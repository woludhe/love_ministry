@model ChurchMinistry.Models.Giving
@{
    ViewData["Title"] = "Card Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-header">
    <h1><i class="fas fa-credit-card"></i> Secure Card Payment</h1>
    <p>Complete your giving via VISA or Mastercard</p>
</section>

<div class="give-page" style="max-width:900px;margin:2rem auto;padding:0 1.5rem;
     display:grid;grid-template-columns:1fr 320px;gap:2rem">

    <div class="give-form-card">

        <div class="card-payment-header">
            <div class="card-payment-icon">
                <i class="fas fa-lock" style="color:var(--green)"></i>
            </div>
            <div>
                <h2 style="font-size:1.05rem;font-weight:700;margin-bottom:.2rem">
                    Secure Checkout
                </h2>
                <p style="font-size:.85rem;color:var(--text-s)">
                    Your card details are encrypted and never stored on our servers.
                </p>
            </div>
        </div>

        <div class="payment-summary" style="margin:1.25rem 0">
            <div class="summary-row">
                <span>Giving Type</span>
                <strong>@Model.GivingType</strong>
            </div>
            <div class="summary-row">
                <span>Amount</span>
                <strong>@Model.Currency @Model.Amount.ToString("N0")</strong>
            </div>
            <div class="summary-row">
                <span>Reference</span>
                <code style="font-size:.78rem;background:#f3f4f6;
                      padding:.15rem .4rem;border-radius:4px">@Model.TransactionId</code>
            </div>
            <div class="summary-row" style="border-top:1.5px solid var(--border);
                 padding-top:.6rem;margin-top:.3rem">
                <strong>Total</strong>
                <strong style="color:var(--purple);font-size:1.1rem">
                    @Model.Currency @Model.Amount.ToString("N0")
                </strong>
            </div>
        </div>

        <div class="accepted-cards">
            <span style="font-size:.82rem;color:var(--text-s);font-weight:600">
                Accepted cards:
            </span>
            <div class="card-logos">
                <span class="card-logo card-logo-visa">VISA</span>
                <span class="card-logo card-logo-mc">MC</span>
                <span class="card-logo card-logo-verve">VERVE</span>
            </div>
        </div>

        <button id="payBtn" onclick="initiateCardPayment()"
                class="btn btn-primary btn-full" style="padding:.9rem;margin-top:1.25rem">
            <i class="fas fa-lock"></i>
            Pay @Model.Currency @Model.Amount.ToString("N0") Securely
        </button>

        <p class="secure-note" style="margin-top:.75rem">
            <i class="fas fa-shield-alt"></i>
            Powered by Flutterwave &nbsp;·&nbsp;
            <i class="fas fa-lock"></i> 256-bit SSL encryption
        </p>

        <div class="card-payment-footer-links">
            <a asp-controller="Giving" asp-action="Give">
                <i class="fas fa-arrow-left"></i> Back to Giving
            </a>
            <a asp-controller="Giving" asp-action="History">
                <i class="fas fa-history"></i> My Giving History
            </a>
        </div>

    </div>

    @* {{-- Sidebar --}} *@
    <div>
        <div class="sidebar-card" style="position:sticky;top:80px">
            <h3 style="font-size:.95rem;font-weight:700;margin-bottom:1rem">
                Your Giving
            </h3>
            <div style="text-align:center;padding:1rem 0">
                <div style="font-size:2rem;margin-bottom:.5rem">🙏</div>
                <p style="font-size:.88rem;color:var(--text-s);line-height:1.7">
                    "Honor the Lord with your wealth and with the firstfruits of all your produce."
                </p>
                <cite style="font-size:.78rem;color:var(--purple);font-weight:600">
                    Proverbs 3:9
                </cite>
            </div>
            <div class="give-summary" style="margin-top:1rem">
                <div class="summary-row">
                    <span>Amount</span>
                    <strong>@Model.Currency @Model.Amount.ToString("N0")</strong>
                </div>
                <div class="summary-row">
                    <span>Type</span>
                    <strong>@Model.GivingType</strong>
                </div>
                <div class="summary-row">
                    <span>Processing fee</span>
                    <strong>Covered by church</strong>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://checkout.flutterwave.com/v3.js"></script>
<script>
const TX_REF    = '@Model.TransactionId';
const PUB_KEY   = '@ViewBag.PubKey';
const AMOUNT    = @Model.Amount;
const CURRENCY  = '@Model.Currency';
const EMAIL     = '@ViewBag.Email';
const CALLBACK  = '@Url.Action("Callback", "Giving", null, Context.Request.Scheme)';

function initiateCardPayment() {
    const btn = document.getElementById('payBtn');
    btn.disabled  = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Opening checkout…';

    FlutterwaveCheckout({
        public_key:      PUB_KEY,
        tx_ref:          TX_REF,
        amount:          AMOUNT,
        currency:        CURRENCY,
        payment_options: 'card',
        customer: {
            email: EMAIL,
            name:  EMAIL
        },
        meta: {
            tx_ref:      TX_REF,
            giving_type: '@Model.GivingType'
        },
        customizations: {
            title:       'Love Fellowship Ministries',
            description: '@Model.GivingType Giving',
            logo:        '/images/logo.png'
        },
        redirect_url: CALLBACK,
        callback: function(data) {
            if (data.status === 'successful' || data.status === 'completed') {
                // Redirect to callback to update DB and send receipt
                window.location.href =
                    `${CALLBACK}?status=${data.status}` +
                    `&tx_ref=${TX_REF}` +
                    `&transaction_id=${data.transaction_id}`;
            } else {
                btn.disabled  = false;
                btn.innerHTML = '<i class="fas fa-lock"></i> Pay @Model.Currency @Model.Amount.ToString("N0") Securely';
                showToast('Payment was not completed. Please try again.', 'error');
            }
        },
        onclose: function() {
            btn.disabled  = false;
            btn.innerHTML = '<i class="fas fa-lock"></i> Pay @Model.Currency @Model.Amount.ToString("N0") Securely';
        }
    });
}

function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = `alert alert-${type === 'error' ? 'error' : 'info'}`;
    t.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;border-radius:10px;max-width:320px';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 4000);
}
</script>

<style>
.card-payment-header   { display:flex; align-items:flex-start; gap:1rem;
                          background:#f0fdf4; border:1px solid #a7f3d0;
                          border-radius:var(--radius); padding:1.1rem 1.25rem;
                          margin-bottom:1rem; }
.card-payment-icon     { width:40px; height:40px; background:#d1fae5;
                          border-radius:10px; display:flex; align-items:center;
                          justify-content:center; font-size:1.1rem; flex-shrink:0; }

.accepted-cards        { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;
                          padding:.75rem; background:#f9fafb;
                          border-radius:8px; border:1px solid var(--border); }
.card-logos            { display:flex; gap:.4rem; }
.card-logo             { padding:.2rem .55rem; border-radius:4px;
                          font-size:.72rem; font-weight:800; }
.card-logo-visa        { background:#1e40af; color:white; }
.card-logo-mc          { background:#dc2626; color:white; }
.card-logo-verve       { background:#059669; color:white; }

.card-payment-footer-links { display:flex; justify-content:space-between;
                              margin-top:1rem; font-size:.82rem; }
.card-payment-footer-links a { color:var(--text-s); display:flex;
                                align-items:center; gap:.3rem; }
.card-payment-footer-links a:hover { color:var(--purple); }
</style>
}
