@model ChurchMinistry.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Home - Apostle Enock Makoko";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using ChurchMinistry.Models

<!-- ═══════════════════════════════════════════
     HERO - sliding background images
═══════════════════════════════════════════ -->
<section class="hero" id="heroSection">

    @* {{-- Slide layers --}} *@
    <div class="hero-slides">
        <div class="hero-slide active" style="background-image:url('/images/hero/slide1.jpg')"></div>
        <div class="hero-slide" style="background-image:url('/images/hero/slide2.jpg')"></div>
        <div class="hero-slide" style="background-image:url('/images/hero/slide3.jpg')"></div>
        <div class="hero-slide" style="background-image:url('/images/hero/slide4.jpg')"></div>
    </div>
    @* {{-- Dark gradient so text stays readable over any photo --}} *@
    <div class="hero-overlay"></div>

    @* {{-- Prev / Next arrows --}} *@
    <button class="hero-arrow hero-prev" onclick="heroShift(-1)" aria-label="Previous slide">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button class="hero-arrow hero-next" onclick="heroShift(1)" aria-label="Next slide">
        <i class="fas fa-chevron-right"></i>
    </button>

    @* {{-- Dot indicators --}} *@
    <div class="hero-dots" id="heroDots"></div>

    @* {{-- Content --}} *@
    <div class="hero-content">
        <span class="hero-badge">Welcome Home</span>
        <h1>Building Lives,<br>Transforming <span class="highlight">Communities</span></h1>
        <p>Join our family of believers. Experience the love of God through worship, fellowship and service.</p>
        <div class="hero-actions">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Join Our Family</a>
            <a asp-controller="Media" asp-action="Live" class="btn btn-outline hero-outline-btn">
                <span class="live-dot"></span> Watch Live
            </a>
        </div>
        @* <div class="hero-stats">
        <div class="stat"><strong>@(Model?.TotalMembers ?? 0)+</strong><span>Members</span></div>
        <div class="stat"><strong>15+</strong><span>Years</span></div>
        <div class="stat"><strong>12</strong><span>Ministries</span></div>
        </div> *@
    </div>

    @* {{-- Side card: live sermon, else the next scheduled event (hidden when neither) --}} *@
    @if (Model?.LiveSermon != null || Model?.NextEvent != null)
    {
        <div class="hero-visual">
            <div class="hero-card glass-card">
                @if (Model?.LiveSermon != null)
                {
                    <div class="live-badge"><span class="live-dot"></span> LIVE NOW</div>
                    <p class="live-title">@Model.LiveSermon.Title</p>
                    <a asp-controller="Media" asp-action="Live" class="btn btn-primary btn-sm">Watch Now</a>
                }
                else
                {
                    <div class="next-service">
                        <i class="fas fa-church fa-2x"></i>
                        <span><strong>@Model!.NextEvent!.Title</strong></span>
                        <span><i class="fas fa-calendar"></i> @Model.NextEvent.StartDate.ToString("ddd, dd MMM yyyy")</span>
                        <span><i class="fas fa-clock"></i> @Model.NextEvent.StartDate.ToString("h:mm tt")</span>
                        @if (!string.IsNullOrEmpty(Model.NextEvent.Location))
                        {
                            <span><i class="fas fa-map-marker-alt"></i> @Model.NextEvent.Location</span>
                        }
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.NextEvent.Id"
                           class="btn btn-outline hero-outline-btn btn-sm" style="margin-top:.75rem">
                            View Details
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</section>

<!-- ═══════════════════════════════════════════
     REST OF PAGE (unchanged)
═══════════════════════════════════════════ -->

<section class="section">
    <div class="section-header">
        <h2>Recent Sermons</h2>
        <a asp-controller="Media" asp-action="Index" class="btn btn-outline btn-sm">View All</a>
    </div>
    <div class="cards-grid">
        @foreach (var sermon in (Model?.RecentSermons ?? new List<Sermon>()))
        {
            <div class="card sermon-card">
                @if (!string.IsNullOrEmpty(sermon.ThumbnailUrl))
                {
                    <img src="@sermon.ThumbnailUrl" alt="@sermon.Title" class="card-thumb" />
                }
                else
                {
                    <div class="card-thumb-placeholder"><i class="fas fa-play-circle fa-3x"></i></div>
                }
                <div class="card-body">
                    <span class="tag">@sermon.SeriesName</span>
                    <h3>@sermon.Title</h3>
                    <p class="meta">
                        <i class="fas fa-user"></i> @sermon.Speaker &nbsp;
                        <i class="fas fa-calendar"></i> @sermon.SermonDate.ToString("dd MMM yyyy")
                    </p>
                    <div class="card-actions">
                        <a asp-controller="Media" asp-action="Watch" asp-route-id="@sermon.Id" class="btn btn-primary btn-sm">
                            <i class="fas fa-play"></i> Watch
                        </a>
                        @if (!string.IsNullOrEmpty(sermon.AudioUrl))
                        {
                            <a href="@sermon.AudioUrl" class="btn btn-outline btn-sm">
                                <i class="fas fa-headphones"></i> Listen
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="give-section">
    <div class="give-content">
        <div class="give-text">
            <h2>Give &amp; Partner with the Ministry</h2>
            <p>Your giving makes a difference. Support our missions, community outreach and church operations.</p>
            @if (Model.ActivePaymentMethods.Any())
            {
                <div class="payment-badges">
                    @foreach (var pm in Model.ActivePaymentMethods)
                    {
                        <span class="badge" style="background:@pm.BadgeColor;color:#fff">@pm.Name</span>
                    }
                </div>
            }
            <a asp-controller="Giving" asp-action="Give" class="btn btn-primary">Give Now</a>
        </div>
        <div class="give-verse">
            <blockquote>
                "Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver."
                <cite>2 Corinthians 9:7</cite>
            </blockquote>
        </div>
    </div>
</section>

@if (Model.UpcomingEvents.Any())
{
    <section class="section">
        <div class="section-header">
            <h2>Upcoming Events</h2>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline btn-sm">See Calendar</a>
        </div>
        <div class="events-list-row">
            @foreach (var ev in Model.UpcomingEvents)
            {
                <div class="event-item">
                    <div class="event-date">
                        <span class="day">@ev.StartDate.Day</span>
                        <span class="month">@ev.StartDate.ToString("MMM")</span>
                    </div>
                    <div class="event-info">
                        <h3>@ev.Title</h3>
                        <p>
                            <i class="fas fa-clock"></i> @ev.StartDate.ToString("h:mm tt")
                            @if (!string.IsNullOrEmpty(ev.Location))
                            {
                                <span>&nbsp;<i class="fas fa-map-marker-alt"></i> @ev.Location</span>
                            }
                        </p>
                    </div>
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id"
                       class="btn btn-outline btn-sm">Details</a>
                </div>
            }
        </div>
    </section>
}

