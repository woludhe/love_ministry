@section Scripts {
    <style>
        /* ── Hero layout ─────────────────────────────────────────── */
        .hero {
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            min-height: 92vh;
            padding: 5rem 4rem 5rem 4rem;
            overflow: hidden;
            isolation: isolate; /* creates stacking context */
            background-image: url('/images/hero/slide1.jpg');
        }

        /* Text swap when a highlighted sermon slide comes and goes */
        #heroContent { transition: opacity .3s ease; }
        #heroContent.swap { opacity: 0; }

        /* ── Highlighted sermon slide ───────────────────────────────
           Black background; the thumbnail is shown whole (not cropped) on the right,
           and a black gradient on the left sits behind the sermon text and buttons. */
        .hero-slide-sermon {
            background: #000;
        }

            /* Full banner height, natural width (never cropped top/bottom), pinned to the right;
               anything wider than the screen runs off under the left gradient */
            .hero-slide-sermon .hero-sermon-thumb {
                position: absolute;
                top: 0;
                right: 0;
                width: auto;
                height: 100%;
                max-width: none;
                object-fit: contain;
                object-position: right center;
                /* Feathered left edge: the image fades in from transparent, so there's no hard line */
                -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
                mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
            }

            .hero-slide-sermon::after {
                content: "";
                position: absolute;
                inset: 0;
                /* Black at 80% so the thumbnail shows faintly behind the text */
                background: linear-gradient(90deg, rgba(0,0,0,.8) 0%, rgba(0,0,0,.8) 34%, rgba(0,0,0,.68) 42%, rgba(0,0,0,.28) 52%, rgba(0,0,0,0) 62%);
            }

        /* While a sermon slide shows: no photo tint over the thumbnail, no upcoming-event card */
        .hero-overlay,
        .hero-visual {
            transition: opacity .6s ease, visibility .6s ease;
        }

        .hero.hero-sermon-on .hero-overlay {
            opacity: 0;
        }

        .hero.hero-sermon-on .hero-visual {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        /* ── Slide layers ────────────────────────────────────────── */
        .hero-slides {
            position: absolute;
            inset: 0;
            z-index: -2;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.4s cubic-bezier(.4,0,.2,1);
            will-change: opacity;
        }

            .hero-slide.active {
                opacity: 1;
            }

        /* ── Overlay gradient ────────────────────────────────────── */
        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: -1;
            /* background: linear-gradient( 125deg, rgba(10,8,35,.82) 0%, rgba(30,27,75,.72) 45%, rgba(10,8,35,.78) 100% ); */
            background: linear-gradient( 125deg, rgba(10,8,35,.82) 0%, rgba(0,0,0,0) 45%, rgba(10,8,35,.78) 100% );
        }

        /* ── Text colours over photos ───────────────────────────── */
        .hero h1 {
            color: #ffffff;
            text-shadow: 0 2px 18px rgba(0,0,0,.5);
        }

        .hero p {
            color: rgba(255,255,255,.88);
        }

        .hero .highlight {
            color: #c4b5fd;
        }

        .hero-badge {
            background: rgba(255,255,255,.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,.28);
            backdrop-filter: blur(8px);
        }

        .hero .stat strong {
            color: #c4b5fd;
        }

        .hero .stat span {
            color: rgba(255,255,255,.72);
        }

        .hero-outline-btn {
            color: white !important;
            border-color: rgba(255,255,255,.45) !important;
            background: rgba(255,255,255,.08) !important;
        }

            .hero-outline-btn:hover {
                background: rgba(255,255,255,.18) !important;
            }

        /* ── Glass card ─────────────────────────────────────────── */
        .glass-card {
            background: rgba(255,255,255,.10) !important;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255,255,255,.22) !important;
            box-shadow: 0 8px 32px rgba(0,0,0,.35) !important;
            color: #fff !important;
        }

            .glass-card .next-service {
                color: rgba(255,255,255,.88);
            }

                .glass-card .next-service i {
                    color: #c4b5fd;
                }

            .glass-card p {
                color: rgba(255,255,255,.82);
            }

            .glass-card strong {
                color: #fff;
            }

        /* ── Arrows ─────────────────────────────────────────────── */
        .hero-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,.32);
            background: rgba(0,0,0,.28);
            backdrop-filter: blur(8px);
            color: white;
            font-size: .95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
        }

            .hero-arrow:hover {
                background: rgba(0,0,0,.58);
                border-color: rgba(255,255,255,.75);
                transform: translateY(-50%) scale(1.08);
            }

        .hero-prev {
            left: 1.5rem;
        }

        .hero-next {
            right: 1.5rem;
        }

        /* ── Dots ───────────────────────────────────────────────── */
        .hero-dots {
            position: absolute;
            bottom: 1.6rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: .45rem;
            z-index: 10;
        }

        .hero-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            border: none;
            background: rgba(255,255,255,.38);
            cursor: pointer;
            padding: 0;
            transition: all .3s;
        }

            .hero-dot.active {
                background: #fff;
                width: 24px;
                border-radius: 100px;
            }

        /* ── Responsive ─────────────────────────────────────────── */
        @@media (max-width: 1024px) {
            .hero {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 5rem 1.5rem 4rem;
                min-height: 70vh;
            }

            .hero-visual {
                display: none;
            }

            .hero-actions {
                justify-content: center;
            }

            .hero-stats {
                justify-content: center;
            }

            .hero-prev, .hero-next {
                display: none;
            }

            /* Phones/tablets: the thumbnail fills a 16:9 band at the top, and the badge, title,
               speaker/date and buttons start below it, on the black */
            .hero {
                /* Same height for every slide (tall enough for the picture band plus the sermon text),
                   so the page below never jumps when a sermon slide comes or goes */
                min-height: max(70vh, calc(56.25vw + 28rem));
            }

            .hero-slide-sermon .hero-sermon-thumb {
                width: 100%;
                height: 56.25vw;
                object-position: center top;
                -webkit-mask-image: none;   /* full width here, no left edge to feather */
                mask-image: none;
            }

            .hero-slide-sermon::after {
                background: linear-gradient(180deg, rgba(0,0,0,0) 0, rgba(0,0,0,0) calc(56.25vw - 3rem), #000 56.25vw);
            }

            .hero.hero-sermon-on {
                align-content: start;
                padding-top: calc(56.25vw + 1.5rem);
            }

            /* Long sermon titles stop at two lines, so the slide never grows taller than the others */
            .hero.hero-sermon-on h1 {
                display: -webkit-box;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 2;
                line-clamp: 2;
                overflow: hidden;
            }

            /* Both buttons on one row (My Dashboard / Join Our Family + Watch Live / Watch Sermon) */
            .hero-actions {
                flex-wrap: nowrap;
                gap: .6rem;
            }

                .hero-actions .btn {
                    flex: 0 1 auto;
                    min-width: 0;
                    white-space: nowrap;
                    padding: .7rem 1rem;
                    font-size: .9rem;
                }
        }

        @@media (max-width: 380px) {
            .hero {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .hero-content {
                padding: 0;
            }

            .hero-actions .btn {
                flex: 1 1 0;
                justify-content: center;
                overflow: hidden;
                text-overflow: ellipsis;
                padding: .65rem .5rem;
                font-size: .8rem;
            }
        }
    </style>

    <script>
        (function () {
            const INTERVAL = 6000;
            const slides = Array.from(document.querySelectorAll('.hero-slide'));
            const dotsEl = document.getElementById('heroDots');
            let current = 0;
            let timer;

            // Build dots dynamically to match slide count
            slides.forEach((_, i) => {
                const btn = document.createElement('button');
                btn.className = 'hero-dot' + (i === 0 ? ' active' : '');
                btn.setAttribute('aria-label', 'Slide ' + (i + 1));
                btn.addEventListener('click', () => { resetTimer(); goTo(i); });
                dotsEl.appendChild(btn);
            });

            // Highlighted sermon slides swap the hero text and turn Watch Live into Watch Sermon
            const heroEl = document.getElementById('heroSection');
            const content = document.getElementById('heroContent');
            const badge = document.getElementById('heroBadge');
            const title = document.getElementById('heroTitle');
            const text = document.getElementById('heroText');
            const watch = document.getElementById('heroWatchBtn');
            const defaults = { badge: badge.innerHTML, title: title.innerHTML, text: text.innerHTML, watch: watch.innerHTML, href: watch.getAttribute('href') };
            let shownSermon = '';   // id of the sermon the text currently shows ('' = welcome text)
            let swapTimer;

            function applyContent(slide) {
                const id = slide.dataset.sermonId || '';
                if (id === shownSermon) return;
                shownSermon = id;
                clearTimeout(swapTimer);
                content.classList.add('swap');
                swapTimer = setTimeout(() => {
                    if (id) {
                        badge.textContent = 'Featured Sermon';
                        title.textContent = slide.dataset.title;
                        text.textContent = slide.dataset.sub;
                        watch.innerHTML = '<i class="fas fa-play"></i> Watch Sermon';
                        watch.setAttribute('href', slide.dataset.url);
                    } else {
                        badge.innerHTML = defaults.badge;
                        title.innerHTML = defaults.title;
                        text.innerHTML = defaults.text;
                        watch.innerHTML = defaults.watch;
                        watch.setAttribute('href', defaults.href);
                    }
                    // Switch the layout (picture band, text position, event card) while the text is invisible
                    heroEl.classList.toggle('hero-sermon-on', !!id);
                    content.classList.remove('swap');
                }, 300);
            }

            function goTo(index) {
                slides[current].classList.remove('active');
                dotsEl.children[current].classList.remove('active');
                current = (index + slides.length) % slides.length;
                slides[current].classList.add('active');
                dotsEl.children[current].classList.add('active');
                applyContent(slides[current]);
            }

            window.heroShift = function (dir) { resetTimer(); goTo(current + dir); };

            function startTimer() { if (window.LITE) return; clearInterval(timer); timer = setInterval(() => goTo(current + 1), INTERVAL); }
            function resetTimer() { clearInterval(timer); startTimer(); }

            // Pause on hover
            const hero = document.getElementById('heroSection');
            hero.addEventListener('mouseenter', () => clearInterval(timer));
            hero.addEventListener('mouseleave', startTimer);

            // Touch swipe
            let tx = 0;
            hero.addEventListener('touchstart', e => tx = e.touches[0].clientX, { passive: true });
            hero.addEventListener('touchend', e => {
                const d = tx - e.changedTouches[0].clientX;
                if (Math.abs(d) > 50) { resetTimer(); goTo(current + (d > 0 ? 1 : -1)); }
            }, { passive: true });

            startTimer();
        })();
    </script>
}
