@model ChurchMinistry.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Home - Apostle Enock Makoko";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Lite mode (leaf button in the menu): one small welcome picture, no rotation; slides 2–4 never download
    var lite = ChurchMinistry.Services.LiteMode.IsOn(Context);
    var slide1 = lite ? "/images/hero/slide1-lite.jpg" : "/images/hero/slide1.jpg";
}
@using ChurchMinistry.Models

<!-- ═══════════════════════════════════════════
     HERO - sliding background images
═══════════════════════════════════════════ -->
<section class="hero" id="heroSection" style="@(lite ? "background-image:url('/images/hero/slide1-lite.jpg')" : null)">

    @* {{-- Slide layers --}} *@
    <div class="hero-slides">
        <div class="hero-slide active" style="background-image:url('@slide1')"></div>
        @* Sermons ticked "Highlight on home page": their thumbnail as the background; the script below
           swaps the headline and turns Watch Live into Watch Sermon while one of these is showing *@
        @foreach (var hs in Model?.HighlightedSermons ?? new List<Sermon>())
        {
            var thumb = string.IsNullOrEmpty(hs.ThumbnailUrl) ? (lite ? slide1 : "/images/hero/slide2.jpg") : hs.ThumbnailUrl;
            var sub = string.Join(" · ", new[] { hs.Speaker, hs.SermonDate.ToString("dd MMM yyyy") }.Where(x => !string.IsNullOrWhiteSpace(x)));
            @* Black slide: the whole thumbnail sits on the right, a black gradient on the left carries the text *@
            <div class="hero-slide hero-slide-sermon"
                 data-sermon-id="@hs.Id" data-title="@hs.Title" data-sub="@sub"
                 data-url="@Url.Action("Watch", "Media", new { id = hs.Id })">
                <img class="hero-sermon-thumb" src="@thumb" alt="" loading="lazy" />
            </div>
        }
        @if (!lite)
        {
        <div class="hero-slide" style="background-image:url('/images/hero/slide2.jpg')"></div>
        <div class="hero-slide" style="background-image:url('/images/hero/slide3.jpg')"></div>
        <div class="hero-slide" style="background-image:url('/images/hero/slide4.jpg')"></div>
        }
    </div>
    @* {{-- Dark gradient so text stays readable over any photo --}} *@
    <div class="hero-overlay"></div>

    @* {{-- Prev / Next arrows --}} *@
    <button class="hero-arrow hero-prev" onclick="heroShift(-1)" aria-label="Previous slide">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button class="hero-arrow hero-next" onclick="heroShift(1)" aria-label="Next slide">
        <i class="fas fa-chevron-right"></i>
    </button>

    @* {{-- Dot indicators --}} *@
    <div class="hero-dots" id="heroDots"></div>

    @* {{-- Content --}} *@
    <div class="hero-content" id="heroContent">
        <span class="hero-badge" id="heroBadge">Welcome Home</span>
        <h1 id="heroTitle">Building Lives,<br>Transforming <span class="highlight">Communities</span></h1>
        <p id="heroText">Join our family of believers. Experience the love of God through worship, fellowship and service.</p>
        <div class="hero-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Members" asp-action="Dashboard" class="btn btn-primary"><i class="fas fa-gauge"></i> My Dashboard</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Join Our Family</a>
            }
            <a asp-controller="Media" asp-action="Live" class="btn btn-outline hero-outline-btn" id="heroWatchBtn">
                <span class="live-dot"></span> Watch Live
            </a>
        </div>
        <a asp-controller="Home" asp-action="AndroidApp" class="hero-app-link"><i class="fab fa-android"></i> Get the Android app</a>
        @* <div class="hero-stats">
        <div class="stat"><strong>@(Model?.TotalMembers ?? 0)+</strong><span>Members</span></div>
        <div class="stat"><strong>15+</strong><span>Years</span></div>
        <div class="stat"><strong>12</strong><span>Ministries</span></div>
        </div> *@
    </div>

    @* {{-- Side card: live sermon, else the next scheduled event or sermon (hidden when neither) --}} *@
    @{ var next = Model?.UpcomingItems.FirstOrDefault(); }
    @if (Model?.LiveSermon != null || next != null)
    {
        <div class="hero-visual">
            <div class="hero-card glass-card">
                @if (Model?.LiveSermon != null)
                {
                    <div class="live-badge"><span class="live-dot"></span> LIVE NOW</div>
                    <p class="live-title">@Model.LiveSermon.Title</p>
                    @if (!string.IsNullOrEmpty(Model.LiveSermon.Speaker))
                    {
                        <p class="live-speaker"><i class="fas fa-user"></i> @Model.LiveSermon.Speaker</p>
                    }
                    <a asp-controller="Media" asp-action="Live" class="btn btn-primary btn-sm">Watch Now</a>
                }
                else
                {
                    <div class="next-service">
                        <i class="fas fa-church fa-2x"></i>
                        <span><strong>@next!.Title</strong></span>
                        <span><i class="fas fa-calendar"></i> @next.Date.ToString("ddd, dd MMM yyyy")</span>
                        <span><i class="fas fa-clock"></i> @next.Date.ToString("h:mm tt")</span>
                        @if (!string.IsNullOrEmpty(next.Subtitle))
                        {
                            <span><i class="fas @(next.IsSermon ? "fa-user" : "fa-map-marker-alt")"></i> @next.Subtitle</span>
                        }
                        <a asp-controller="@(next.IsSermon ? "Media" : "Events")"
                           asp-action="@(next.IsSermon ? "Watch" : "Details")" asp-route-id="@next.Id"
                           class="btn btn-outline hero-outline-btn btn-sm" style="margin-top:.75rem">
                            View Details
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</section>

<!-- ═══════════════════════════════════════════
     REST OF PAGE (unchanged)
═══════════════════════════════════════════ -->

<section class="section">
    <div class="section-header">
        <h2>Recent Sermons</h2>
        <a asp-controller="Media" asp-action="Index" class="btn btn-outline btn-sm">View All</a>
    </div>
    <div class="cards-grid">
        @foreach (var sermon in (Model?.RecentSermons ?? new List<Sermon>()))
        {
            <div class="card sermon-card">
                @if (!string.IsNullOrEmpty(sermon.ThumbnailUrl))
                {
                    <img src="@sermon.ThumbnailUrl" alt="@sermon.Title" class="card-thumb" loading="lazy" />
                }
                else
                {
                    <div class="card-thumb-placeholder"><i class="fas fa-play-circle fa-3x"></i></div>
                }
                <div class="card-body">
                    <span class="tag">@sermon.SeriesName</span>
                    <h3>@sermon.Title</h3>
                    <p class="meta">
                        <i class="fas fa-user"></i> @sermon.Speaker &nbsp;
                        <i class="fas fa-calendar"></i> @sermon.SermonDate.ToString("dd MMM yyyy")
                    </p>
                    @* Same button as the Sermons page: live / upcoming / audio / video *@
                    <div class="card-actions">
                        @if (sermon.IsLive)
                        {
                            <a asp-controller="Media" asp-action="Live" class="btn btn-primary btn-sm"><span class="live-dot"></span> Watch Live</a>
                        }
                        else if (sermon.SermonDate > DateTime.UtcNow)
                        {
                            <a asp-controller="Media" asp-action="Watch" asp-route-id="@sermon.Id" class="btn btn-primary btn-sm"><i class="fas fa-eye"></i> View</a>
                        }
                        else if (sermon.DeliveryMode == "audio")
                        {
                            <a asp-controller="Media" asp-action="Watch" asp-route-id="@sermon.Id" class="btn btn-primary btn-sm"><i class="fas fa-headphones"></i> Listen</a>
                        }
                        else
                        {
                            <a asp-controller="Media" asp-action="Watch" asp-route-id="@sermon.Id" class="btn btn-primary btn-sm"><i class="fas fa-play"></i> Watch</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="give-section">
    <div class="give-content">
        <div class="give-text">
            <h2>Give &amp; Partner with the Ministry</h2>
            <p>Your giving makes a difference. Support our missions, community outreach and church operations.</p>
            @if (Model.ActivePaymentMethods.Any())
            {
                <div class="payment-badges">
                    @foreach (var pm in Model.ActivePaymentMethods)
                    {
                        <span class="badge" style="background:@pm.BadgeColor;color:#fff">@pm.Name</span>
                    }
                </div>
            }
            <a asp-controller="Giving" asp-action="Give" class="btn btn-primary">Give Now</a>
        </div>
        <div class="give-verse">
            <blockquote>
                "Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver."
                <cite>2 Corinthians 9:7</cite>
            </blockquote>
        </div>
    </div>
</section>

@if (Model.UpcomingItems.Any())
{
    <section class="section">
        <div class="section-header">
            <h2>Upcoming Events &amp; Services</h2>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline btn-sm">See Calendar</a>
        </div>
        <div class="events-list-row">
            @foreach (var item in Model.UpcomingItems)
            {
                <div class="event-item">
                    <div class="event-date">
                        <span class="day">@item.Date.Day</span>
                        <span class="month">@item.Date.ToString("MMM")</span>
                    </div>
                    <div class="event-info">
                        <h3>
                            @item.Title
                            @if (item.IsSermon)
                            {
                                <span class="tag">@(item.DeliveryMode is "live" or "meeting" ? "Live Service" : "Sermon")</span>
                            }
                        </h3>
                        <p>
                            <i class="fas fa-clock"></i> @item.Date.ToString("h:mm tt")
                            @if (!string.IsNullOrEmpty(item.Subtitle))
                            {
                                <span>&nbsp;<i class="fas @(item.IsSermon ? "fa-user" : "fa-map-marker-alt")"></i> @item.Subtitle</span>
                            }
                        </p>
                    </div>
                    @if (item.IsSermon)
                    {
                        <a asp-controller="Media" asp-action="Watch" asp-route-id="@item.Id"
                           class="btn btn-outline btn-sm">Details</a>
                    }
                    else
                    {
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline btn-sm">Details</a>
                    }
                </div>
            }
        </div>
    </section>
}

