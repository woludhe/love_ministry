@section Scripts {
    <style>
        /* ── Hero layout ─────────────────────────────────────────── */
        .hero {
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            min-height: 92vh;
            padding: 5rem 4rem 5rem 4rem;
            overflow: hidden;
            isolation: isolate; /* creates stacking context */
            background-image: url('/images/hero/slide1.jpg');
        }

        /* ── Slide layers ────────────────────────────────────────── */
        .hero-slides {
            position: absolute;
            inset: 0;
            z-index: -2;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1.4s cubic-bezier(.4,0,.2,1);
            will-change: opacity;
        }

            .hero-slide.active {
                opacity: 1;
            }

        /* ── Overlay gradient ────────────────────────────────────── */
        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: -1;
            /* background: linear-gradient( 125deg, rgba(10,8,35,.82) 0%, rgba(30,27,75,.72) 45%, rgba(10,8,35,.78) 100% ); */
            background: linear-gradient( 125deg, rgba(10,8,35,.82) 0%, rgba(0,0,0,0) 45%, rgba(10,8,35,.78) 100% );
        }

        /* ── Text colours over photos ───────────────────────────── */
        .hero h1 {
            color: #ffffff;
            text-shadow: 0 2px 18px rgba(0,0,0,.5);
        }

        .hero p {
            color: rgba(255,255,255,.88);
        }

        .hero .highlight {
            color: #c4b5fd;
        }

        .hero-badge {
            background: rgba(255,255,255,.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,.28);
            backdrop-filter: blur(8px);
        }

        .hero .stat strong {
            color: #c4b5fd;
        }

        .hero .stat span {
            color: rgba(255,255,255,.72);
        }

        .hero-outline-btn {
            color: white !important;
            border-color: rgba(255,255,255,.45) !important;
            background: rgba(255,255,255,.08) !important;
        }

            .hero-outline-btn:hover {
                background: rgba(255,255,255,.18) !important;
            }

        /* ── Glass card ─────────────────────────────────────────── */
        .glass-card {
            background: rgba(255,255,255,.10) !important;
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255,255,255,.22) !important;
            box-shadow: 0 8px 32px rgba(0,0,0,.35) !important;
            color: #fff !important;
        }

            .glass-card .next-service {
                color: rgba(255,255,255,.88);
            }

                .glass-card .next-service i {
                    color: #c4b5fd;
                }

            .glass-card p {
                color: rgba(255,255,255,.82);
            }

            .glass-card strong {
                color: #fff;
            }

        /* ── Arrows ─────────────────────────────────────────────── */
        .hero-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,.32);
            background: rgba(0,0,0,.28);
            backdrop-filter: blur(8px);
            color: white;
            font-size: .95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
        }

            .hero-arrow:hover {
                background: rgba(0,0,0,.58);
                border-color: rgba(255,255,255,.75);
                transform: translateY(-50%) scale(1.08);
            }

        .hero-prev {
            left: 1.5rem;
        }

        .hero-next {
            right: 1.5rem;
        }

        /* ── Dots ───────────────────────────────────────────────── */
        .hero-dots {
            position: absolute;
            bottom: 1.6rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: .45rem;
            z-index: 10;
        }

        .hero-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            border: none;
            background: rgba(255,255,255,.38);
            cursor: pointer;
            padding: 0;
            transition: all .3s;
        }

            .hero-dot.active {
                background: #fff;
                width: 24px;
                border-radius: 100px;
            }

        /* ── Responsive ─────────────────────────────────────────── */
        @@media (max-width: 1024px) {
            .hero {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 5rem 1.5rem 4rem;
                min-height: 70vh;
            }

            .hero-visual {
                display: none;
            }

            .hero-actions {
                justify-content: center;
            }

            .hero-stats {
                justify-content: center;
            }

            .hero-prev, .hero-next {
                display: none;
            }
        }
    </style>

    <script>
        (function () {
            const INTERVAL = 6000;
            const slides = Array.from(document.querySelectorAll('.hero-slide'));
            const dotsEl = document.getElementById('heroDots');
            let current = 0;
            let timer;

            // Build dots dynamically to match slide count
            slides.forEach((_, i) => {
                const btn = document.createElement('button');
                btn.className = 'hero-dot' + (i === 0 ? ' active' : '');
                btn.setAttribute('aria-label', 'Slide ' + (i + 1));
                btn.addEventListener('click', () => { resetTimer(); goTo(i); });
                dotsEl.appendChild(btn);
            });

            function goTo(index) {
                slides[current].classList.remove('active');
                dotsEl.children[current].classList.remove('active');
                current = (index + slides.length) % slides.length;
                slides[current].classList.add('active');
                dotsEl.children[current].classList.add('active');
            }

            window.heroShift = function (dir) { resetTimer(); goTo(current + dir); };

            function startTimer() { timer = setInterval(() => goTo(current + 1), INTERVAL); }
            function resetTimer() { clearInterval(timer); startTimer(); }

            // Pause on hover
            const hero = document.getElementById('heroSection');
            hero.addEventListener('mouseenter', () => clearInterval(timer));
            hero.addEventListener('mouseleave', startTimer);

            // Touch swipe
            let tx = 0;
            hero.addEventListener('touchstart', e => tx = e.touches[0].clientX, { passive: true });
            hero.addEventListener('touchend', e => {
                const d = tx - e.changedTouches[0].clientX;
                if (Math.abs(d) > 50) { resetTimer(); goTo(current + (d > 0 ? 1 : -1)); }
            }, { passive: true });

            startTimer();
        })();
    </script>
}
