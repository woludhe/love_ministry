@model List<(int Id, DateTime Date, string Title, int Reads)>
@{
    ViewData["Title"] = "Devotionals"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
    var today = DateTime.Today;
    var memberCount = ViewBag.MemberCount as int? ?? 0;
}

<div class="admin-main">
    <div class="admin-topbar">
        <h1>Devotionals</h1>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Devotion</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="devo-empty">No devotions yet. Write the first one with <strong>New Devotion</strong>; members will see it on its date.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Date</th><th>Title</th><th>Read by</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td style="white-space:nowrap">
                            @d.Date.ToString("ddd d MMM yyyy")
                            @if (d.Date > today)
                            {
                                <span class="status-badge" title="Members will see it on this date">Scheduled</span>
                            }
                            else if (d.Date == today)
                            {
                                <span class="status-badge">Today</span>
                            }
                        </td>
                        <td class="cell-title"><a asp-action="Read" asp-route-id="@d.Id">@d.Title</a></td>
                        <td>@d.Reads@(memberCount > 0 ? $" of {memberCount}" : "")</td>
                        <td style="white-space:nowrap;text-align:right">
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-outline btn-xs"><i class="fas fa-pen"></i> Edit</a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Delete this devotion? Notes members wrote on it are deleted too.')">
                                <button type="submit" class="btn btn-outline btn-xs" style="color:var(--coral)"><i class="fas fa-trash"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />
    }
</div>

<style>
    .devo-empty { color: var(--text-s); padding: 2rem 0; }
</style>
