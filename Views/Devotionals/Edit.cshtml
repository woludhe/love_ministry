@model ChurchMinistry.ViewModels.DevotionalFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Devotion" : "Edit Devotion"; Layout = "~/Views/Shared/_AdminDashboard_Layout.cshtml";
}
<div class="member-main">
    <section class="page-header"><h1>@ViewData["Title"]</h1></section>
    <div class="form-page">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" required maxlength="200" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Date"></label>
                    <input asp-for="Date" class="form-control" type="date" required />
                    <span asp-validation-for="Date" class="field-error"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Scripture"></label>
                <textarea asp-for="Scripture" class="form-control" rows="2" required maxlength="500"
                          placeholder="e.g. Psalm 23:1 — The Lord is my shepherd; I shall not want."></textarea>
                <span asp-validation-for="Scripture" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content"></label>
                <textarea asp-for="Content" class="form-control" rows="14" required
                          placeholder="Leave a blank line between paragraphs."></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Prayer"></label>
                <textarea asp-for="Prayer" class="form-control" rows="4"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="StudyScriptures"></label>
                <textarea asp-for="StudyScriptures" class="form-control" rows="5"
                          placeholder="One scripture per line, e.g.&#10;John 10:11&#10;Isaiah 40:11"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Save Devotion</button>
            @if (!isNew)
            {
                <a asp-action="Read" asp-route-id="@Model.Id" class="btn btn-outline" target="_blank"><i class="fas fa-eye"></i> Preview</a>
            }
            <a asp-action="Manage" class="btn btn-outline">Cancel</a>
        </form>
    </div>
</div>
