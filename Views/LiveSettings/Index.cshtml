@model ChurchMinistry.Models.LiveSession
@{
    ViewData["Title"] = "Live Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sermon = ViewBag.Sermon as ChurchMinistry.Models.Sermon;
    var sermonId = sermon?.Id ?? 0;
    var bibleTranslations = ViewBag.BibleTranslations as IReadOnlyList<ChurchMinistry.Services.BibleTranslation>
                            ?? Array.Empty<ChurchMinistry.Services.BibleTranslation>();
    var defaultTranslation = ViewBag.DefaultTranslation as string;
    var activeVerse = Model.BibleVerses.FirstOrDefault(v => v.IsActive);
    var bibleBooks = ViewBag.BibleBooks as IReadOnlyList<ChurchMinistry.Services.BibleBookInfo>
                     ?? Array.Empty<ChurchMinistry.Services.BibleBookInfo>();
}

<section class="page-header" style="background:linear-gradient(135deg,#7f1d1d,#dc2626)">
    <div style="display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto;flex-wrap:wrap;gap:1rem">
        <div>
            <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.4rem">
                <span class="live-dot"></span>
                <span style="font-size:.78rem;font-weight:700;letter-spacing:.08em;opacity:.8">ON AIR</span>
                <span class="ls-online" id="lsOnline" aria-live="polite"
                      title="@(sermon?.IsOnlineMeeting == true ? "People on the Live page plus people in the meeting room" : "People on the Live page")">
                    <i class="fas fa-users"></i> <strong id="lsOnlineTotal">0</strong> online
                    @if (sermon?.IsOnlineMeeting == true)
                    {
                        <small id="lsOnlineSplit"></small>
                    }
                </span>
            </div>
            <h1 style="font-size:1.5rem;margin-bottom:.25rem">Live Settings</h1>
            <p>@sermon?.Title &nbsp;·&nbsp; @sermon?.Speaker</p>
        </div>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
            <a asp-controller="Media" asp-action="Live" target="_blank"
               class="btn btn-outline" style="color:white;border-color:rgba(255,255,255,.4)">
                <i class="fas fa-eye"></i> Preview Live Page
            </a>
            <a asp-controller="Admin" asp-action="Sermons" class="btn btn-outline"
               style="color:white;border-color:rgba(255,255,255,.4)">
                <i class="fas fa-arrow-left"></i> Back to Sermons
            </a>
        </div>
    </div>
</section>

<div class="live-settings-page">

    <form asp-action="Save" asp-route-sermonId="@sermonId" method="post" id="settingsForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SermonId" />

        <div class="ls-grid">

            @* {{-- ═══ LEFT COLUMN ═══ --}} *@
            <div class="ls-col">

                @* {{-- Bible Verses --}} *@
                <div class="ls-card">
                    <div class="ls-card-header">
                        <div class="ls-card-title">
                            <i class="fas fa-book-open" style="color:#6366f1"></i>
                            Bible Verses
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem">
                            <span class="ls-badge ls-badge-purple">Overlay</span>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowVerseOverlay" class="ls-toggle-input"
                                       onchange="pushOverlay('verse', this.checked)" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div>
                    </div>

                    @* {{-- Look up a chapter, click a verse to show it --}} *@
                    <div class="ls-card-body" style="border-bottom:1px solid var(--border)">
                        <div class="bv-search">
                            <select id="bvTranslation" class="form-control bv-trans" aria-label="Translation">
                                @foreach (var t in bibleTranslations)
                                {
                                    <option value="@t.Code" title="@t.Name" selected="@(t.Code == defaultTranslation)">@t.Abbrev</option>
                                }
                            </select>
                            <div class="bv-ac">
                                <input type="text" id="bvQuery" class="form-control" placeholder="e.g. John 1" autocomplete="off"
                                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="bvSuggest" />
                                <div id="bvSuggest" class="bv-suggest" role="listbox" style="display:none"></div>
                            </div>
                        </div>
                        @if (!bibleTranslations.Any())
                        {
                            <p class="bv-warn"><i class="fas fa-triangle-exclamation"></i> No Bible files found. Put the .ewb files in App_Data/bibles on the server.</p>
                        }

                        <div id="bvChapter" class="bv-chapter" style="display:none">
                            <div class="bv-chapter-head">
                                <button type="button" class="ls-icon-btn" id="bvPrev" title="Previous chapter" onclick="stepChapter(-1)">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <div class="bv-chapter-title">
                                    <strong id="bvTitle"></strong>
                                    <span class="tag" id="bvTransTag"></span>
                                    <small id="bvCount"></small>
                                </div>
                                <button type="button" class="ls-icon-btn" id="bvNext" title="Next chapter" onclick="stepChapter(1)">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                                <button type="button" class="btn btn-outline btn-xs bv-clear" onclick="clearVerse()" title="Take the verse off the screen">
                                    <i class="fas fa-stop"></i> Clear screen
                                </button>
                            </div>
                            <p class="bv-hint">Click a verse to show it on screen straight away.</p>
                            <div id="bvVerses" class="bv-verses"></div>
                        </div>
                    </div>

                    @* {{-- Log of verses shown --}} *@
                    <div class="bv-log-head">
                        <i class="fas fa-clock-rotate-left"></i> Shared verses
                        <span class="bv-log-count" id="bvLogCount">@Model.BibleVerses.Count</span>
                    </div>
                    <div id="verseList" class="bv-log">
                        @foreach (var verse in Model.BibleVerses.OrderByDescending(v => v.LastShownAt ?? v.CreatedAt))
                        {
                            <div class="ls-list-item @(verse.IsActive ? "ls-item-active" : "")" id="verse-item-@verse.Id"
                                 data-ref="@verse.Reference" data-code="@verse.Translation.ToLowerInvariant()">
                                <div style="flex:1;min-width:0">
                                    <div class="ls-item-title">
                                        @verse.Reference
                                        <span class="tag" style="font-size:.7rem;margin-left:.3rem">@verse.Translation</span>
                                        @if (verse.IsActive)
                                        {
                                            <span class="ls-badge ls-badge-green bv-onscreen" style="margin-left:.3rem">On screen</span>
                                        }
                                    </div>
                                    <div class="ls-item-sub">
                                        <span class="bv-time">@((verse.LastShownAt ?? verse.CreatedAt).ToLocalTime().ToString("h:mm tt"))</span> · @verse.VerseText
                                    </div>
                                </div>
                                <div style="display:flex;gap:.3rem;flex-shrink:0">
                                    <button type="button" class="ls-icon-btn" title="Show again" onclick="activateVerse(@verse.Id)">
                                        <i class="fas fa-play"></i>
                                    </button>
                                    <button type="button" class="ls-icon-btn" title="Open this chapter" onclick="openInChapter(@verse.Id)">
                                        <i class="fas fa-book-open"></i>
                                    </button>
                                    <button type="button" class="ls-icon-btn ls-icon-btn-red" title="Remove from log" onclick="deleteVerse(@verse.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!Model.BibleVerses.Any())
                        {
                            <div class="ls-empty" id="verseEmpty">
                                <i class="fas fa-book-open"></i>
                                <p>Verses you show will be listed here.</p>
                            </div>
                        }
                    </div>
                </div>

                @* {{-- Announcements --}} *@
                <div class="ls-card">
                    <div class="ls-card-header">
                        <div class="ls-card-title">
                            <i class="fas fa-bullhorn" style="color:#f59e0b"></i>
                            Announcements
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem">
                            <span class="ls-badge ls-badge-amber">Marquee</span>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowMarquee" class="ls-toggle-input"
                                       onchange="pushOverlay('marquee', this.checked)" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div>
                    </div>

                    @* {{-- Add new --}} *@
                    <div class="ls-card-body" style="border-bottom:1px solid var(--border)">
                        <textarea id="newAnnText" class="form-control" rows="2"
                                  placeholder="Type announcement text…"></textarea>
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:.6rem">
                            <div style="display:flex;align-items:center;gap:.5rem">
                                <span style="font-size:.82rem;color:var(--text-s)">Speed:</span>
                                <select asp-for="MarqueeSpeed" class="form-control"
                                        style="width:auto" onchange="pushMarqueeSpeed(this.value)">
                                    <option value="Slow">Slow</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Fast">Fast</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" onclick="addAnnouncement()">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                    </div>

                    @* {{-- List --}} *@
                    <div id="annList">
                        @foreach (var ann in Model.Announcements.OrderBy(a => a.SortOrder))
                        {
                            <div class="ls-list-item @(ann.IsActive ? "ls-item-active" : "")"
                                 id="ann-item-@ann.Id">
                                <div style="display:flex;align-items:center;gap:.6rem;flex:1;min-width:0">
                                    <div class="ls-radio @(ann.IsActive ? "ls-radio-on" : "")"></div>
                                    <div class="ls-item-title" style="flex:1;min-width:0">

                                        @(ann.Text.Length > 80 ? ann.Text.Substring(0, 80) + "…" : ann.Text)

                                    @if (ann.IsActive)
                                    {
                                        <span class="ls-badge ls-badge-green" style="margin-left:.3rem">Active</span>
                                    }
                                    </div>
                                </div>
                                <div style="display:flex;gap:.3rem;flex-shrink:0">
                                    @if (!ann.IsActive)
                                    {
                                        <button type="button" class="ls-icon-btn" title="Activate"
                                                onclick="activateAnnouncement(@ann.Id)">
                                            <i class="fas fa-play"></i>
                                        </button>
                                    }
                                    <button type="button" class="ls-icon-btn ls-icon-btn-red" title="Delete"
                                            onclick="deleteAnnouncement(@ann.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!Model.Announcements.Any())
                        {
                            <div class="ls-empty" id="annEmpty">
                                <i class="fas fa-bullhorn"></i>
                                <p>No announcements added yet.</p>
                            </div>
                        }
                    </div>

                    @* {{-- Marquee preview --}} *@
                    <div class="ls-card-footer">
                        <div style="font-size:.75rem;font-weight:600;color:var(--text-s);margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.05em">Live preview</div>
                        <div class="marquee-preview-box">
                            <span class="marquee-preview-inner" id="marqueePreviewText">
                                @(Model.Announcements.FirstOrDefault(a => a.IsActive)?.Text ?? "No active announcement")
                            </span>
                        </div>
                    </div>
                </div>

            </div>

            @* {{-- ═══ RIGHT COLUMN ═══ --}} *@
            <div class="ls-col">

                @* {{-- Background music: online meeting services only --}} *@
                @if (sermon?.IsOnlineMeeting == true)
                {
                    <partial name="_MusicCard" model="sermonId" />
                }

                @* {{-- Giving panel --}} *@
                <div class="ls-card">
                    <div class="ls-card-header">
                        <div class="ls-card-title">
                            <i class="fas fa-hand-holding-heart" style="color:#10b981"></i>
                            Giving Panel
                        </div>
                        <div style="display:flex;align-items:center;gap:.6rem">
                            <span class="ls-badge ls-badge-green">Live page</span>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowGivingPanel" class="ls-toggle-input"
                                       onchange="pushOverlay('giving', this.checked)" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div>
                    </div>

                    <div class="ls-card-body">
                        <div class="form-group">
                            <label class="ls-field-label">Call-to-action message</label>
                            <input asp-for="GivingCta" class="form-control"
                                   placeholder="Support this ministry - give today!"
                                   oninput="pushGivingCta(this.value)" />
                        </div>

                        <div class="ls-field-label" style="margin-bottom:.6rem">Payment methods</div>
                        <div class="ls-methods-list">
                            <label class="ls-method-row">
                                <input type="checkbox" asp-for="ShowMtn" />
                                <span class="ls-method-icon ls-mtn">MTN</span>
                                <div>
                                    <div style="font-size:.88rem;font-weight:600">MTN Mobile Money</div>
                                    <div style="font-size:.75rem;color:var(--text-s)">Uganda +256</div>
                                </div>
                            </label>
                            <label class="ls-method-row">
                                <input type="checkbox" asp-for="ShowAirtel" />
                                <span class="ls-method-icon ls-airtel">AIR</span>
                                <div>
                                    <div style="font-size:.88rem;font-weight:600">Airtel Money</div>
                                    <div style="font-size:.75rem;color:var(--text-s)">Uganda +256</div>
                                </div>
                            </label>
                            <label class="ls-method-row">
                                <input type="checkbox" asp-for="ShowMpesa" />
                                <span class="ls-method-icon ls-mpesa">M-P</span>
                                <div>
                                    <div style="font-size:.88rem;font-weight:600">M-Pesa</div>
                                    <div style="font-size:.75rem;color:var(--text-s)">Kenya +254</div>
                                </div>
                            </label>
                            <label class="ls-method-row">
                                <input type="checkbox" asp-for="ShowVisa" />
                                <span class="ls-method-icon ls-visa">VISA</span>
                                <div>
                                    <div style="font-size:.88rem;font-weight:600">VISA / Mastercard</div>
                                    <div style="font-size:.75rem;color:var(--text-s)">International</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                @* {{-- Visibility toggles --}} *@
                <div class="ls-card">
                    <div class="ls-card-header">
                        <div class="ls-card-title">
                            <i class="fas fa-eye" style="color:#6366f1"></i>
                            Visibility
                        </div>
                    </div>
                    <div class="ls-toggle-list">
                        @* <div class="ls-toggle-row">
                            <div>
                                <div style="font-size:.88rem;font-weight:600">Bible verse overlay</div>
                                <div style="font-size:.75rem;color:var(--text-s)">Bottom of video player</div>
                            </div>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowVerseOverlay" class="ls-toggle-input" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div> *@
                        @* <div class="ls-toggle-row">
                            <div>
                                <div style="font-size:.88rem;font-weight:600">Announcement marquee</div>
                                <div style="font-size:.75rem;color:var(--text-s)">Top ticker bar</div>
                            </div>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowMarquee" class="ls-toggle-input" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div> *@
                       @*  <div class="ls-toggle-row">
                            <div>
                                <div style="font-size:.88rem;font-weight:600">Giving panel</div>
                                <div style="font-size:.75rem;color:var(--text-s)">Alongside the player</div>
                            </div>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowGivingPanel" class="ls-toggle-input" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div> *@
                        <div class="ls-toggle-row">
                            <div>
                                <div style="font-size:.88rem;font-weight:600">Prayer request button</div>
                                <div style="font-size:.75rem;color:var(--text-s)">Floating action button</div>
                            </div>
                            <label class="ls-toggle-wrap">
                                <input type="checkbox" asp-for="ShowPrayerButton" class="ls-toggle-input" />
                                <span class="ls-toggle"></span>
                            </label>
                        </div>
                    </div>
                </div>

                @* {{-- Save button --}} *@
                <button type="submit" class="btn btn-primary btn-lg btn-full">
                    <i class="fas fa-save"></i> Save &amp; Push to Viewers
                </button>
                <p style="font-size:.78rem;color:var(--text-s);text-align:center;margin-top:.5rem">
                    Changes are pushed live instantly via SignalR. No page refresh needed for viewers.
                </p>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const SERMON_ID = @sermonId;
        const BASE = `/Admin/LiveSettings/${SERMON_ID}`;

        // ── SignalR admin connection ──────────────────────────────
        const conn = new signalR.HubConnectionBuilder()
            .withUrl('/liveSessionHub')
            .withAutomaticReconnect()
            .build();
        // How many are online: updates as people join and leave
        function showAudience(a) {
            if (!a) return;
            document.getElementById('lsOnlineTotal').textContent = a.total;
            const split = document.getElementById('lsOnlineSplit');
            if (split) split.textContent = `${a.onLivePage} on Live page · ${a.inMeeting} in meeting`;
        }
        conn.on('AudienceChanged', showAudience);
        const watchAudience = () => conn.invoke('WatchAudience', SERMON_ID).then(showAudience).catch(console.error);
        conn.onreconnected(watchAudience);
        conn.start().then(watchAudience).catch(console.error);

        // ── Bible: look up a chapter, click a verse to show it ────
        const TRANSLATION_KEY = 'ls-bible-translation';
        const transSelect = document.getElementById('bvTranslation');
        let chapterState = null;   // { code, translation, book, bookName, chapter, chapterCount }
        let onScreen = @Html.Raw(Json.Serialize(activeVerse == null ? null : new { reference = activeVerse.Reference, translation = activeVerse.Translation }));

        try {
            const saved = localStorage.getItem(TRANSLATION_KEY);
            if (saved && [...transSelect.options].some(o => o.value === saved)) transSelect.value = saved;
        } catch { }

        transSelect.addEventListener('change', () => {
            try { localStorage.setItem(TRANSLATION_KEY, transSelect.value); } catch { }
            if (chapterState) loadChapter({ book: chapterState.book, chapter: chapterState.chapter });
        });

        function lookupChapter() {
            closeSuggest();
            const q = document.getElementById('bvQuery').value.trim();
            if (q) loadChapter({ q });
        }

        // ── Book / chapter autocomplete ───────────────────────────
        // Typing letters suggests books ("jo" → Joshua, Job, Joel, John…, short forms like "jn" too);
        // once a book is chosen, its chapters show as a grid and a click opens that chapter
        const BIBLE_BOOKS = @Html.Raw(Json.Serialize(bibleBooks.Select(b => new
        {
            name = b.Name,
            chapters = b.Chapters,
            keys = new[] { new string(b.Name.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray()) }
                   .Concat(b.Aliases).ToArray()
        })));
        const queryInput = document.getElementById('bvQuery');
        const suggestBox = document.getElementById('bvSuggest');
        let suggestItems = [], suggestActive = -1;

        const compact = s => s.toLowerCase().replace(/[^a-z0-9]/g, '');

        // Splits "1 Cor 13" into book text "1 Cor" and chapter "13"; a ":" means a verse is being typed
        function splitQuery(value) {
            const m = value.match(/^\s*(\d?\s*[^\d:]*?)\s*(\d*)\s*(:.*)?$/);
            return m ? { book: m[1], chapter: m[2], verse: m[3] !== undefined, endsWithSpace: /\s$/.test(value) } : null;
        }

        function matchBooks(text) {
            const key = compact(text);
            if (!key) return [];
            const exact = BIBLE_BOOKS.filter(b => b.keys.includes(key));
            const prefix = BIBLE_BOOKS.filter(b => !exact.includes(b) && b.keys.some(k => k.startsWith(key)));
            return exact.concat(prefix);
        }

        function updateSuggest() {
            const q = splitQuery(queryInput.value);
            if (!q || q.verse || !q.book.trim()) { closeSuggest(); return; }

            const books = matchBooks(q.book);
            const single = books.length === 1 || (books.length > 0 && books[0].keys.includes(compact(q.book)));

            if (single && (q.chapter || q.endsWithSpace)) {
                renderChapters(books[0], q.chapter);
            } else if (books.length) {
                renderBooks(books.slice(0, 8));
            } else {
                closeSuggest();
            }
        }

        function renderBooks(books) {
            suggestItems = books.map(b => ({ type: 'book', book: b }));
            suggestBox.className = 'bv-suggest';
            suggestBox.innerHTML = books.map((b, i) => `
                <div class="bv-sug-book" role="option" id="bvSug${i}" data-i="${i}">
                    <span>${escHtml(b.name)}</span><small>${b.chapters} chapter${b.chapters === 1 ? '' : 's'}</small>
                </div>`).join('');
            openSuggest(0);
        }

        function renderChapters(book, typed) {
            const all = Array.from({ length: book.chapters }, (_, i) => i + 1);
            const chapters = typed ? all.filter(c => String(c).startsWith(typed)) : all;
            if (!chapters.length) { closeSuggest(); return; }
            suggestItems = chapters.map(c => ({ type: 'chapter', book, chapter: c }));
            suggestBox.className = 'bv-suggest bv-suggest-chapters';
            suggestBox.innerHTML = `<div class="bv-sug-head">${escHtml(book.name)} — choose a chapter</div>
                <div class="bv-sug-grid">${chapters.map((c, i) =>
                    `<div class="bv-sug-ch" role="option" id="bvSug${i}" data-i="${i}">${c}</div>`).join('')}</div>`;
            openSuggest(typed ? 0 : -1);
        }

        function openSuggest(active) {
            suggestBox.style.display = 'block';
            queryInput.setAttribute('aria-expanded', 'true');
            setActive(active);
        }

        function closeSuggest() {
            suggestBox.style.display = 'none';
            queryInput.setAttribute('aria-expanded', 'false');
            queryInput.removeAttribute('aria-activedescendant');
            suggestItems = []; suggestActive = -1;
        }

        function setActive(i) {
            suggestActive = i;
            suggestBox.querySelectorAll('[role="option"]').forEach(el =>
                el.classList.toggle('bv-sug-active', Number(el.dataset.i) === i));
            const el = document.getElementById(`bvSug${i}`);
            if (el) { queryInput.setAttribute('aria-activedescendant', el.id); el.scrollIntoView({ block: 'nearest' }); }
            else queryInput.removeAttribute('aria-activedescendant');
        }

        // Chapter cells per row in the grid, so up/down move a whole row
        function gridColumns() {
            const cells = [...suggestBox.querySelectorAll('.bv-sug-ch')];
            if (!cells.length) return 1;
            const top = cells[0].offsetTop;
            return Math.max(1, cells.findIndex(c => c.offsetTop !== top) === -1 ? cells.length
                : cells.findIndex(c => c.offsetTop !== top));
        }

        function chooseSuggestion(i) {
            const item = suggestItems[i];
            if (!item) return;
            if (item.type === 'book') {
                queryInput.value = item.book.name + ' ';
                queryInput.focus();
                updateSuggest();                     // goes straight to the chapter grid
            } else {
                queryInput.value = `${item.book.name} ${item.chapter}`;
                lookupChapter();
            }
        }

        queryInput.addEventListener('input', updateSuggest);
        queryInput.addEventListener('focus', updateSuggest);
        queryInput.addEventListener('blur', () => setTimeout(closeSuggest, 150));

        queryInput.addEventListener('keydown', e => {
            const open = suggestBox.style.display !== 'none' && suggestItems.length > 0;
            const grid = suggestBox.classList.contains('bv-suggest-chapters');
            const arrows = ['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'];

            if (open && arrows.includes(e.key)) {
                // Left/right move the caret in the book list, and move across in the chapter grid
                if (!grid && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) return;
                e.preventDefault();
                const cols = grid ? gridColumns() : 1;
                const step = { ArrowDown: cols, ArrowUp: -cols, ArrowRight: 1, ArrowLeft: -1 }[e.key];
                const start = suggestActive < 0 ? (step > 0 ? -step : suggestItems.length) : suggestActive;
                setActive(Math.min(suggestItems.length - 1, Math.max(0, start + step)));
            } else if (e.key === 'Enter') {
                e.preventDefault();                   // never submit the settings form
                if (open && suggestActive >= 0) chooseSuggestion(suggestActive);
                else lookupChapter();
            } else if (e.key === 'Tab' && open && !grid && !e.shiftKey) {
                e.preventDefault();
                chooseSuggestion(Math.max(0, suggestActive));
            } else if (e.key === 'Escape' && open) {
                e.preventDefault();
                closeSuggest();
            }
        });

        // mousedown so the choice lands before the input loses focus
        suggestBox.addEventListener('mousedown', e => {
            const el = e.target.closest('[role="option"]');
            if (!el) return;
            e.preventDefault();
            chooseSuggestion(Number(el.dataset.i));
        });

        function stepChapter(delta) {
            if (!chapterState) return;
            const c = chapterState.chapter + delta;
            if (c >= 1 && c <= chapterState.chapterCount)
                loadChapter({ book: chapterState.book, chapter: c });
        }

        async function loadChapter(params) {
            const qs = new URLSearchParams({ translation: transSelect.value });
            if (params.q) qs.set('q', params.q);
            else { qs.set('book', params.book); qs.set('chapter', params.chapter); }

            let data;
            try {
                const res = await fetch(`${BASE}/Chapter?${qs}`);
                data = await res.json();
            } catch {
                showToast('❌ Could not load the chapter. Check your connection.');
                return;
            }
            if (data.error) { showToast('❌ ' + data.error); return; }

            chapterState = {
                code: data.code, translation: data.translation, book: data.book,
                bookName: data.bookName, chapter: data.chapter, chapterCount: data.chapterCount
            };
            document.getElementById('bvQuery').value = data.reference;
            document.getElementById('bvTitle').textContent = data.reference;
            document.getElementById('bvTransTag').textContent = data.translation;
            document.getElementById('bvCount').textContent = `${data.verses.length} verses`;
            document.getElementById('bvPrev').disabled = data.chapter <= 1;
            document.getElementById('bvNext').disabled = data.chapter >= data.chapterCount;

            const list = document.getElementById('bvVerses');
            list.innerHTML = data.verses.map(v => `
                <button type="button" class="bv-verse" data-n="${v.n}" data-label="${escHtml(v.label)}" onclick="showVerse(${v.n})">
                    <span class="bv-num">${escHtml(v.label)}</span><span class="bv-text">${escHtml(v.text)}</span>
                </button>`).join('');
            document.getElementById('bvChapter').style.display = 'block';
            markOnScreen();

            const target = data.highlight ? list.querySelector(`[data-n="${data.highlight}"]`) : null;
            if (target) {
                target.classList.add('bv-target');
                list.scrollTop = target.offsetTop - list.clientHeight / 3;
            } else {
                list.scrollTop = 0;
            }
        }

        // Only one request at a time; clicks made meanwhile collapse into the latest one,
        // so the last verse clicked is the one left on screen
        let showInFlight = false, queuedShow = null;

        function showVerse(n) {
            if (!chapterState) return;
            document.querySelectorAll('.bv-verse.bv-pending').forEach(el => el.classList.remove('bv-pending'));
            document.querySelector(`.bv-verse[data-n="${n}"]`)?.classList.add('bv-pending');

            const req = { code: chapterState.code, book: chapterState.book, chapter: chapterState.chapter, verse: n };
            if (showInFlight) { queuedShow = req; return; }
            sendShow(req);
        }

        async function sendShow(req) {
            showInFlight = true;
            let data;
            try {
                const fd = new FormData();
                fd.append('translation', req.code);
                fd.append('book', req.book);
                fd.append('chapter', req.chapter);
                fd.append('verse', req.verse);
                const res = await fetch(`${BASE}/ShowVerse`, { method: 'POST', body: fd });
                data = await res.json();
            } catch {
                data = { success: false, message: 'Could not reach the server.' };
            }
            showInFlight = false;

            if (data.success) {
                upsertLog(data);
                setOnScreen(data);
            }

            if (queuedShow) {
                const next = queuedShow; queuedShow = null;
                sendShow(next);
                return;
            }
            document.querySelectorAll('.bv-verse.bv-pending').forEach(el => el.classList.remove('bv-pending'));
            if (data.success) showToast(`✝ ${data.reference} is on screen`);
            else showToast('❌ ' + (data.message ?? 'Could not show that verse'));
        }

        function setOnScreen(verse) {
            onScreen = verse ? { reference: verse.reference, translation: verse.translation } : null;
            markOnScreen();
            document.querySelectorAll('#verseList .ls-list-item').forEach(el => {
                const on = verse && el.id === `verse-item-${verse.id}`;
                el.classList.toggle('ls-item-active', !!on);
                el.querySelector('.bv-onscreen')?.remove();
                if (on) el.querySelector('.ls-item-title').insertAdjacentHTML('beforeend',
                    '<span class="ls-badge ls-badge-green bv-onscreen" style="margin-left:.3rem">On screen</span>');
            });
        }

        // Highlight the verse that's on screen if it's in the open chapter
        function markOnScreen() {
            document.querySelectorAll('.bv-verse').forEach(el => {
                const ref = chapterState && `${chapterState.bookName} ${chapterState.chapter}:${el.dataset.label}`;
                el.classList.toggle('bv-on', !!onScreen && onScreen.reference === ref
                    && onScreen.translation === chapterState.translation);
            });
        }

        // Put a log entry at the top (moving it if it's already listed)
        function upsertLog(v) {
            document.getElementById('verseEmpty')?.remove();
            document.getElementById(`verse-item-${v.id}`)?.remove();

            const div = document.createElement('div');
            div.className = 'ls-list-item';
            div.id = `verse-item-${v.id}`;
            div.dataset.ref = v.reference;
            div.dataset.code = v.translation.toLowerCase();
            div.innerHTML = `
                <div style="flex:1;min-width:0">
                    <div class="ls-item-title">
                        ${escHtml(v.reference)}
                        <span class="tag" style="font-size:.7rem;margin-left:.3rem">${escHtml(v.translation)}</span>
                    </div>
                    <div class="ls-item-sub"><span class="bv-time">${escHtml(v.shownAt)}</span> · ${escHtml(v.verseText)}</div>
                </div>
                <div style="display:flex;gap:.3rem;flex-shrink:0">
                    <button type="button" class="ls-icon-btn" title="Show again" onclick="activateVerse(${v.id})">
                        <i class="fas fa-play"></i></button>
                    <button type="button" class="ls-icon-btn" title="Open this chapter" onclick="openInChapter(${v.id})">
                        <i class="fas fa-book-open"></i></button>
                    <button type="button" class="ls-icon-btn ls-icon-btn-red" title="Remove from log" onclick="deleteVerse(${v.id})">
                        <i class="fas fa-trash"></i></button>
                </div>`;
            const list = document.getElementById('verseList');
            list.prepend(div);
            list.scrollTop = 0;
            updateLogCount();
        }

        function updateLogCount() {
            document.getElementById('bvLogCount').textContent =
                document.querySelectorAll('#verseList .ls-list-item').length;
        }

        function escHtml(s) {
            const d = document.createElement('div');
            d.textContent = s ?? '';
            return d.innerHTML;
        }

        async function activateVerse(id) {
            try {
                const res = await fetch(`${BASE}/ActivateVerse/${id}`, { method: 'POST' });
                const data = await res.json();
                if (!data.success) { showToast('❌ ' + (data.message ?? 'Could not show that verse')); return; }
                upsertLog(data);
                setOnScreen(data);
                showToast(`✝ ${data.reference} is on screen`);
            } catch {
                showToast('❌ Could not reach the server.');
            }
        }

        function openInChapter(id) {
            const item = document.getElementById(`verse-item-${id}`);
            if (!item) return;
            if ([...transSelect.options].some(o => o.value === item.dataset.code)) transSelect.value = item.dataset.code;
            loadChapter({ q: item.dataset.ref });
            document.getElementById('bvChapter').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        async function clearVerse() {
            await fetch(`${BASE}/ClearVerse`, { method: 'POST' });
            setOnScreen(null);
            showToast('Verse taken off the screen');
        }

        async function deleteVerse(id) {
            if (!confirm('Remove this verse from the log?')) return;
            await fetch(`${BASE}/DeleteVerse/${id}`, { method: 'POST' });
            const item = document.getElementById(`verse-item-${id}`);
            if (item?.classList.contains('ls-item-active')) setOnScreen(null);
            item?.remove();
            updateLogCount();
        }

        // ── Announcements ─────────────────────────────────────────
        async function addAnnouncement() {
            const text = document.getElementById('newAnnText').value.trim();
            if (!text) return;
            const fd = new FormData();
            fd.append('text', text);
            await fetch(`${BASE}/AddAnnouncement`, { method: 'POST', body: fd });
            location.reload();
        }

        async function activateAnnouncement(id) {
            const res = await fetch(`${BASE}/ActivateAnnouncement/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                document.getElementById('marqueePreviewText').textContent = data.text;
                document.querySelectorAll('[id^="ann-item-"]').forEach(el => {
                    el.classList.remove('ls-item-active');
                    el.querySelector('.ls-radio')?.classList.remove('ls-radio-on');
                });
                const item = document.getElementById(`ann-item-${id}`);
                item?.classList.add('ls-item-active');
                item?.querySelector('.ls-radio')?.classList.add('ls-radio-on');
                showToast('📢 Announcement is now scrolling on the live page');
            }
        }

        async function deleteAnnouncement(id) {
            if (!confirm('Delete this announcement?')) return;
            await fetch(`${BASE}/DeleteAnnouncement/${id}`, { method: 'POST' });
            document.getElementById(`ann-item-${id}`)?.remove();
        }

        // ── Real-time push helpers ────────────────────────────────
        function pushOverlay(name, visible) {
            conn.invoke('ToggleOverlay', SERMON_ID, name, visible).catch(console.error);
            showToast(`${visible ? '✅' : '🚫'} ${name} overlay ${visible ? 'shown' : 'hidden'} for viewers`);
        }

        function pushMarqueeSpeed(speed) {
            conn.invoke('SetMarqueeSpeed', SERMON_ID, speed.toLowerCase()).catch(console.error);
        }

        let ctaTimer;
        function pushGivingCta(text) {
            clearTimeout(ctaTimer);
            ctaTimer = setTimeout(() => {
                conn.invoke('PushGivingCta', SERMON_ID, text).catch(console.error);
            }, 800);
        }

        // ── Toast ─────────────────────────────────────────────────
        function showToast(msg) {
            const t = document.createElement('div');
            t.className = 'ls-toast';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.classList.add('ls-toast-show'), 10);
            setTimeout(() => { t.classList.remove('ls-toast-show'); setTimeout(() => t.remove(), 400); }, 3000);
        }
    </script>

