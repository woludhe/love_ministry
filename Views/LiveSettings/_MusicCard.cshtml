@using ChurchMinistry.Services
@model int
@*
    Background music for an online meeting service (Model = sermon id). Live page viewers hear it;
    people inside the meeting room don't. Tracks come from the Audio Library.
*@
@{
    var files = ViewBag.MusicFiles as List<AudioStoreFile> ?? new();
    var types = ViewBag.MusicTypes as List<AudioTypeInfo> ?? new();
    var defaultType = files.Any(f => f.Type == "music") ? "music" : (files.FirstOrDefault()?.Type ?? "music");
}

<div class="ls-card" id="musicCard" data-sermon-id="@Model">
    <div class="ls-card-header">
        <div class="ls-card-title">
            <i class="fas fa-music" style="color:#6366f1"></i>
            Background Music
        </div>
        <span class="ls-badge ls-badge-purple" title="People inside the meeting room don't hear it">Live page viewers</span>
    </div>

    @* Now playing + controls *@
    <div class="ls-card-body mc-now">
        <div class="mc-now-title" id="mcNowTitle">Not playing</div>
        <div class="mc-now-meta" id="mcNowMeta">Add tracks below, then press play.</div>
        <div class="mc-progress"><div id="mcProgress"></div></div>

        <div class="mc-controls">
            <button type="button" class="mc-btn" id="mcPrev" title="Previous track" aria-label="Previous track"><i class="fas fa-backward-step"></i></button>
            <button type="button" class="mc-btn mc-btn-main" id="mcPlay" title="Play" aria-label="Play"><i class="fas fa-play"></i></button>
            <button type="button" class="mc-btn" id="mcNext" title="Next track" aria-label="Next track"><i class="fas fa-forward-step"></i></button>
            <button type="button" class="mc-btn" id="mcStop" title="Stop" aria-label="Stop"><i class="fas fa-stop"></i></button>
            <label class="mc-shuffle" title="Play the list in a random order">
                <input type="checkbox" id="mcShuffle" /> <i class="fas fa-shuffle"></i> Shuffle
            </label>
        </div>

        <div class="mc-volume">
            <i class="fas fa-volume-low" aria-hidden="true"></i>
            <input type="range" id="mcVolume" min="0" max="100" step="1" aria-label="Music volume" />
            <span id="mcVolumeLabel">40%</span>
        </div>

        <label class="ls-toggle-wrap mc-duck">
            <input type="checkbox" class="ls-toggle-input" id="mcDuck" />
            <span class="ls-toggle"></span>
            <span class="mc-duck-text">
                Lower the music while someone talks
                <small>Drops to 20% whenever a speaker in the meeting is talking, and comes back up when they stop.</small>
            </span>
        </label>
    </div>

    @* Playlist *@
    <div class="mc-section-head">
        <span><i class="fas fa-list-ol"></i> Playlist <span class="mc-count" id="mcCount">0</span></span>
        <small id="mcDirty" style="display:none">Changes start when you press play</small>
        <button type="button" class="mc-clear" id="mcClear" title="Stop the music and empty the playlist">Clear</button>
    </div>
    <div class="mc-playlist" id="mcPlaylist"></div>

    @* Add from the library: a pop-up with search and pages, since the list can be long *@
    <div class="mc-add-row">
        <button type="button" class="btn btn-outline btn-sm" id="mcOpenLibrary">
            <i class="fas fa-folder-open"></i> Add from Audio Library
        </button>
        <small>@files.Count file@(files.Count == 1 ? "" : "s") available</small>
    </div>

    <dialog class="mc-dialog" id="mcDialog" aria-labelledby="mcDialogTitle">
        <div class="mc-dialog-head">
            <h3 id="mcDialogTitle"><i class="fas fa-folder-open"></i> Add from Audio Library</h3>
            <button type="button" class="mc-dialog-close" id="mcDialogClose" aria-label="Close"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="mc-dialog-filters">
            <select id="mcType" class="form-control" aria-label="Audio type">
                <option value="*">All types</option>
                @foreach (var t in types)
                {
                    <option value="@t.Slug" selected="@(t.Slug == defaultType)">@t.Label</option>
                }
                @if (files.Any(f => f.Type == ""))
                {
                    <option value="">Other</option>
                }
            </select>
            <input type="search" id="mcSearch" class="form-control" placeholder="Search by name…" autocomplete="off" aria-label="Search by name" />
        </div>
        <div class="mc-dialog-list" id="mcLibList" aria-live="polite"></div>
        <div class="mc-dialog-foot">
            <div class="mc-pager">
                <button type="button" class="btn btn-outline btn-xs" id="mcPrevPage"><i class="fas fa-chevron-left"></i> Previous</button>
                <span id="mcPageInfo"></span>
                <button type="button" class="btn btn-outline btn-xs" id="mcNextPage">Next <i class="fas fa-chevron-right"></i></button>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="mcDone">Done</button>
        </div>
    </dialog>
</div>

<style>
.mc-now { border-bottom:1px solid var(--border); }
.mc-now-title { font-weight:700;font-size:.95rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.mc-now-meta { font-size:.78rem;color:var(--text-s);margin-top:.15rem; }
.mc-progress { height:5px;border-radius:3px;background:var(--border);margin:.6rem 0;overflow:hidden; }
.mc-progress > div { height:100%;width:0;background:var(--purple); }
.mc-controls { display:flex;align-items:center;gap:.4rem;flex-wrap:wrap; }
.mc-btn { width:36px;height:36px;border-radius:50%;border:1px solid var(--border);background:var(--white);
          color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s; }
.mc-btn:hover:not(:disabled) { border-color:var(--purple);color:var(--purple); }
.mc-btn:disabled { opacity:.4;cursor:default; }
.mc-btn:focus-visible { outline:2px solid var(--purple);outline-offset:2px; }
.mc-btn-main { width:44px;height:44px;background:var(--purple);border-color:var(--purple);color:white;font-size:1rem; }
.mc-btn-main:hover:not(:disabled) { color:white;filter:brightness(1.1); }
.mc-shuffle { margin-left:auto;display:flex;align-items:center;gap:.35rem;font-size:.8rem;color:var(--text-s);cursor:pointer; }
.mc-volume { display:flex;align-items:center;gap:.6rem;margin-top:.75rem;color:var(--text-s); }
.mc-volume input { flex:1;accent-color:var(--purple); }
.mc-volume span { font-size:.8rem;font-weight:700;min-width:2.6rem;text-align:right;color:var(--text); }
.mc-duck { margin-top:.85rem;align-items:flex-start;cursor:pointer; }
.mc-duck-text { font-size:.85rem;font-weight:600;display:flex;flex-direction:column;gap:.1rem;margin-left:.5rem; }
.mc-duck-text small { font-weight:400;font-size:.75rem;color:var(--text-s);line-height:1.4; }
.mc-section-head { display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.6rem 1rem;
                   font-size:.8rem;font-weight:700;color:var(--text-s);background:#fafafa;border-bottom:1px solid var(--border); }
.mc-section-head small { font-weight:600;color:#b45309; }
.mc-clear { margin-left:auto;background:none;border:none;color:var(--text-s);font:inherit;font-size:.75rem;
            font-weight:600;cursor:pointer;text-decoration:underline; }
.mc-clear:hover { color:#dc2626; }
.mc-count { background:var(--purple-l);color:var(--purple);font-size:.7rem;padding:.05rem .45rem;border-radius:100px; }
.mc-add-row { display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;padding:.75rem 1rem;border-top:1px solid var(--border); }
.mc-add-row small { color:var(--text-s);font-size:.78rem; }
.mc-playlist { max-height:240px;overflow-y:auto; }
.mc-track, .mc-lib-item { display:flex;align-items:center;gap:.5rem;padding:.45rem 1rem;border-bottom:1px solid var(--border);font-size:.84rem; }
.mc-track:last-child, .mc-lib-item:last-child { border-bottom:none; }
.mc-track-play { flex:1;min-width:0;display:flex;align-items:center;gap:.5rem;background:none;border:none;padding:0;
                 font:inherit;color:inherit;text-align:left;cursor:pointer; }
.mc-track-play:focus-visible { outline:2px solid var(--purple);outline-offset:2px; }
.mc-track-num { width:1.4rem;color:var(--text-s);font-size:.75rem;flex-shrink:0; }
.mc-track-title, .mc-lib-title { flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }

/* Library pop-up */
.mc-dialog { width:min(640px, calc(100vw - 32px));max-height:min(80vh, 680px);padding:0;border:none;border-radius:14px;
             box-shadow:0 24px 60px rgba(0,0,0,.25);background:var(--white);color:var(--text);flex-direction:column; }
.mc-dialog[open] { display:flex; }
.mc-dialog::backdrop { background:rgba(15,15,25,.55); }
.mc-dialog-head { display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:1rem 1.1rem .6rem; }
.mc-dialog-head h3 { font-size:1.05rem;font-weight:800;display:flex;align-items:center;gap:.5rem;margin:0; }
.mc-dialog-head h3 i { color:var(--purple); }
.mc-dialog-close { width:32px;height:32px;border-radius:50%;border:none;background:none;color:var(--text-s);cursor:pointer;font-size:1rem; }
.mc-dialog-close:hover { background:#f3f4f6;color:var(--text); }
.mc-dialog-close:focus-visible { outline:2px solid var(--purple);outline-offset:2px; }
.mc-dialog-filters { display:flex;gap:.5rem;padding:0 1.1rem .75rem;border-bottom:1px solid var(--border); }
.mc-dialog-filters select { width:auto;max-width:42%; }
.mc-dialog-filters input { flex:1;min-width:0; }
.mc-dialog-list { flex:1;min-height:200px;overflow-y:auto; }
.mc-lib-item { display:flex;align-items:center;gap:.6rem;padding:.55rem 1.1rem;border-bottom:1px solid var(--border);font-size:.86rem; }
.mc-lib-item:last-child { border-bottom:none; }
.mc-lib-item:hover { background:#fafafa; }
.mc-lib-type { margin:0;font-size:.68rem;flex-shrink:0; }
.mc-lib-size { color:var(--text-s);font-size:.75rem;flex-shrink:0;min-width:3.6rem;text-align:right; }
.mc-lib-added { color:#059669;font-size:.78rem;font-weight:700;flex-shrink:0;min-width:4.4rem;text-align:center; }
.mc-lib-item .btn-xs { flex-shrink:0;min-width:4.4rem; }
.mc-preview { flex-shrink:0; }
.mc-dialog-foot { display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;
                  padding:.75rem 1.1rem;border-top:1px solid var(--border);background:#fafafa; }
.mc-pager { display:flex;align-items:center;gap:.6rem;flex-wrap:wrap; }
.mc-pager span { font-size:.78rem;color:var(--text-s); }
.mc-pager .btn:disabled { opacity:.4;cursor:default; }
@@media (max-width: 520px) {
    .mc-lib-size, .mc-lib-type { display:none; }
    .mc-dialog-filters { flex-direction:column; }
    .mc-dialog-filters select { max-width:none;width:100%; }
}
.mc-track-time { color:var(--text-s);font-size:.75rem;flex-shrink:0; }
.mc-track.mc-current { background:#f5f3ff;border-left:3px solid var(--purple); }
.mc-track.mc-current .mc-track-num { color:var(--purple); }
.mc-track .ls-icon-btn { width:24px;height:24px;font-size:.7rem; }
.mc-playlist-empty { padding:1rem;text-align:center;color:var(--text-s);font-size:.82rem; }
</style>

<script src="~/js/live-music.js" asp-append-version="true"></script>
<script>
(function () {
    const card = document.getElementById('musicCard');
    const MUSIC_URL = `/Admin/LiveSettings/${card.dataset.sermonId}/Music`;
    let state = @Html.Raw(Json.Serialize(ViewBag.MusicState));
    let skew = (state.serverNow || Date.now()) - Date.now();
    // The list being edited; it becomes the live playlist when play is pressed or a track is picked
    let draft = (state.playlist || []).map(t => ({ ...t }));

    const $ = id => document.getElementById(id);
    const esc = s => { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; };
    const sameAsLive = () => JSON.stringify(draft.map(t => t.url)) === JSON.stringify((state.playlist || []).map(t => t.url));

    async function send(action, extra = {}) {
        const fd = new FormData();
        fd.append('action', action);
        for (const [k, v] of Object.entries(extra)) fd.append(k, v);
        try {
            const res = await fetch(MUSIC_URL, { method: 'POST', body: fd });
            const data = await res.json();
            if (!data.success) { toast('❌ ' + (data.message ?? 'Could not change the music')); return; }
            state = data.music;
            skew = (state.serverNow || Date.now()) - Date.now();
            if (action === 'play') draft = state.playlist.map(t => ({ ...t }));   // shuffled order comes back
            render();
        } catch {
            toast('❌ Could not reach the server.');
        }
    }

    function toast(msg) { if (typeof showToast === 'function') showToast(msg); }

    function play(index = 0) {
        if (!draft.length) { toast('Add some tracks first.'); return; }
        if (draft.some(t => !(t.duration > 0))) { toast('Still reading track lengths, try again in a moment.'); return; }
        send('play', { playlist: JSON.stringify(draft), index, shuffle: $('mcShuffle').checked });
    }

    // ── Controls ────────────────────────────────────────────
    $('mcPlay').addEventListener('click', () => {
        if (state.state === 'playing' && sameAsLive()) send('pause');
        else if (state.state === 'paused' && sameAsLive()) send('resume');
        else play(0);
    });
    $('mcNext').addEventListener('click', () => send('next'));
    $('mcPrev').addEventListener('click', () => send('prev'));
    $('mcStop').addEventListener('click', () => send('stop'));
    $('mcClear').addEventListener('click', () => {
        if (!draft.length && !(state.playlist || []).length) return;
        if (!confirm('Stop the music and empty the playlist?')) return;
        draft = [];
        send('clear');
    });

    // Volume: sent while dragging (at most every 250 ms) and once more when let go
    let volTimer = null;
    const volume = $('mcVolume');
    volume.addEventListener('input', () => {
        $('mcVolumeLabel').textContent = `${volume.value}%`;
        if (volTimer) return;
        volTimer = setTimeout(() => { volTimer = null; send('volume', { volume: volume.value }); }, 250);
    });
    volume.addEventListener('change', () => { clearTimeout(volTimer); volTimer = null; send('volume', { volume: volume.value }); });

    $('mcDuck').addEventListener('change', e => send('duck', { duck: e.target.checked }));

    // ── Library pop-up → playlist ──────────────────────────
    const LIBRARY = @Html.Raw(Json.Serialize(files.Select(f => new
    {
        type = f.Type,
        typeLabel = f.TypeLabel,
        title = System.IO.Path.GetFileNameWithoutExtension(f.Name),
        url = f.Url,
        size = f.Size
    })));
    const PAGE_SIZE = 10;
    const dialog = $('mcDialog'), typeSelect = $('mcType'), search = $('mcSearch');
    const preview = new Audio();
    let page = 1, previewUrl = null;

    function matches() {
        const q = search.value.trim().toLowerCase();
        return LIBRARY.filter(f => (typeSelect.value === '*' || f.type === typeSelect.value)
                                && (!q || f.title.toLowerCase().includes(q)));
    }

    function renderLibrary() {
        const list = matches();
        const pages = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
        page = Math.min(Math.max(1, page), pages);
        const from = (page - 1) * PAGE_SIZE;
        const shown = list.slice(from, from + PAGE_SIZE);
        const inPlaylist = new Set(draft.map(t => t.url));

        $('mcLibList').innerHTML = shown.length ? shown.map(f => `
            <div class="mc-lib-item" data-url="${esc(f.url)}">
                <button type="button" class="ls-icon-btn mc-preview" data-act="preview"
                        title="${previewUrl === f.url ? 'Stop preview' : 'Preview'}" aria-label="${previewUrl === f.url ? 'Stop preview' : 'Preview'} ${esc(f.title)}">
                    <i class="fas ${previewUrl === f.url ? 'fa-stop' : 'fa-play'}"></i>
                </button>
                <span class="mc-lib-title" title="${esc(f.title)}">${esc(f.title)}</span>
                ${typeSelect.value === '*' ? `<span class="tag mc-lib-type">${esc(f.typeLabel)}</span>` : ''}
                <span class="mc-lib-size">${formatSize(f.size)}</span>
                ${inPlaylist.has(f.url)
                    ? '<span class="mc-lib-added"><i class="fas fa-check"></i> Added</span>'
                    : `<button type="button" class="btn btn-outline btn-xs" data-act="add" aria-label="Add ${esc(f.title)}"><i class="fas fa-plus"></i> Add</button>`}
            </div>`).join('')
            : `<div class="ls-empty"><i class="fas fa-music"></i><p>${search.value.trim() ? 'Nothing matches your search.' : 'No audio of this type yet.'}
                 Upload some in <a href="/Admin/AudioLibrary?type=music" target="_blank">Audio Library</a>.</p></div>`;

        $('mcPageInfo').textContent = list.length
            ? `${from + 1}–${from + shown.length} of ${list.length} · Page ${page} of ${pages}` : '';
        $('mcPrevPage').disabled = page <= 1;
        $('mcNextPage').disabled = page >= pages;
    }

    const formatSize = b => b >= 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;

    function stopPreview() { preview.pause(); previewUrl = null; }
    preview.addEventListener('ended', () => { previewUrl = null; renderLibrary(); });

    $('mcOpenLibrary').addEventListener('click', () => { page = 1; renderLibrary(); dialog.showModal(); search.focus(); });
    const closeDialog = () => dialog.close();
    $('mcDialogClose').addEventListener('click', closeDialog);
    $('mcDone').addEventListener('click', closeDialog);
    dialog.addEventListener('close', () => { stopPreview(); });
    // A click on the dimmed backdrop closes it
    dialog.addEventListener('click', e => { if (e.target === dialog) closeDialog(); });

    typeSelect.addEventListener('change', () => { page = 1; renderLibrary(); });
    search.addEventListener('input', () => { page = 1; renderLibrary(); });
    search.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });   // never submits the settings form
    $('mcPrevPage').addEventListener('click', () => { page--; renderLibrary(); });
    $('mcNextPage').addEventListener('click', () => { page++; renderLibrary(); });

    $('mcLibList').addEventListener('click', e => {
        const btn = e.target.closest('button');
        const row = e.target.closest('.mc-lib-item');
        if (!btn || !row) return;
        const file = LIBRARY.find(f => f.url === row.dataset.url);
        if (!file) return;

        if (btn.dataset.act === 'preview') {
            if (previewUrl === file.url) stopPreview();
            else { previewUrl = file.url; preview.src = file.url; preview.play().catch(() => { previewUrl = null; renderLibrary(); }); }
            renderLibrary();
            return;
        }

        const track = { url: file.url, title: file.title, duration: 0 };
        draft.push(track);
        renderLibrary();
        render();
        // Its length is needed so everyone can keep in step
        const probe = new Audio();
        probe.preload = 'metadata';
        probe.addEventListener('loadedmetadata', () => { track.duration = probe.duration; render(); }, { once: true });
        probe.addEventListener('error', () => {
            draft = draft.filter(t => t !== track);
            toast(`❌ Couldn't read ${track.title}.`);
            render();
            if (dialog.open) renderLibrary();
        }, { once: true });
        probe.src = track.url;
    });

    $('mcPlaylist').addEventListener('click', e => {
        const row = e.target.closest('.mc-track');
        if (!row) return;
        const i = Number(row.dataset.i);
        const btn = e.target.closest('button');
        if (!btn) return;
        if (btn.dataset.act === 'up' && i > 0) [draft[i - 1], draft[i]] = [draft[i], draft[i - 1]];
        else if (btn.dataset.act === 'down' && i < draft.length - 1) [draft[i + 1], draft[i]] = [draft[i], draft[i + 1]];
        else if (btn.dataset.act === 'remove') draft.splice(i, 1);
        else if (btn.dataset.act === 'play') {
            // Same list already live: jump to the track; otherwise start this list from it
            if (state.state !== 'stopped' && sameAsLive()) send('jump', { index: i });
            else play(i);
            return;
        }
        render();
    });

    // ── Drawing ────────────────────────────────────────────
    function currentIndex() {
        if (state.state === 'stopped' || !sameAsLive()) return -1;
        const pos = LiveMusicMath.positionNow(state, Date.now(), skew);
        return LiveMusicMath.locate(state.playlist, pos).index;
    }

    function render() {
        const live = state.state !== 'stopped';
        $('mcPlay').innerHTML = state.state === 'playing' && sameAsLive() ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>';
        $('mcPlay').title = state.state === 'playing' && sameAsLive() ? 'Pause' : 'Play';
        $('mcPlay').setAttribute('aria-label', $('mcPlay').title);
        $('mcPrev').disabled = $('mcNext').disabled = $('mcStop').disabled = !live;
        $('mcShuffle').checked = $('mcShuffle').dataset.touched ? $('mcShuffle').checked : !!state.shuffle;
        if (document.activeElement !== volume) {
            volume.value = state.volume ?? 40;
            $('mcVolumeLabel').textContent = `${volume.value}%`;
        }
        $('mcDuck').checked = state.duck !== false;
        $('mcDirty').style.display = live && !sameAsLive() ? '' : 'none';
        $('mcCount').textContent = draft.length;

        const cur = currentIndex();
        $('mcPlaylist').innerHTML = draft.length ? draft.map((t, i) => `
            <div class="mc-track ${i === cur ? 'mc-current' : ''}" data-i="${i}">
                <button type="button" class="mc-track-play" data-act="play" title="Play from here">
                    <span class="mc-track-num">${i === cur ? '<i class="fas fa-volume-high"></i>' : i + 1}</span>
                    <span class="mc-track-title">${esc(t.title)}</span>
                    <span class="mc-track-time">${t.duration > 0 ? LiveMusicMath.formatTime(t.duration) : '…'}</span>
                </button>
                <button type="button" class="ls-icon-btn" data-act="up" title="Move up" aria-label="Move up" ${i === 0 ? 'disabled' : ''}><i class="fas fa-arrow-up"></i></button>
                <button type="button" class="ls-icon-btn" data-act="down" title="Move down" aria-label="Move down" ${i === draft.length - 1 ? 'disabled' : ''}><i class="fas fa-arrow-down"></i></button>
                <button type="button" class="ls-icon-btn ls-icon-btn-red" data-act="remove" title="Remove" aria-label="Remove"><i class="fas fa-xmark"></i></button>
            </div>`).join('')
            : '<div class="mc-playlist-empty">No tracks yet. Add some from the library below.</div>';
        tick();
    }

    // Now playing line and progress, from the shared clock
    function tick() {
        if (state.state === 'stopped' || !state.playlist?.length) {
            $('mcNowTitle').textContent = 'Not playing';
            $('mcNowMeta').textContent = draft.length ? 'Press play to start the music for viewers.' : 'Add tracks below, then press play.';
            $('mcProgress').style.width = '0';
            return;
        }
        const pos = LiveMusicMath.positionNow(state, Date.now(), skew);
        const { index, offset } = LiveMusicMath.locate(state.playlist, pos);
        const track = state.playlist[index];
        $('mcNowTitle').textContent = (state.state === 'paused' ? 'Paused: ' : '') + track.title;
        $('mcNowMeta').textContent = `Track ${index + 1} of ${state.playlist.length} · ${LiveMusicMath.formatTime(offset)} / ${LiveMusicMath.formatTime(track.duration)}`;
        $('mcProgress').style.width = `${Math.min(100, offset / track.duration * 100)}%`;
        // Move the "now playing" mark when a track changes
        const cur = sameAsLive() ? index : -1;
        document.querySelectorAll('.mc-track').forEach(el => {
            const on = Number(el.dataset.i) === cur;
            if (on !== el.classList.contains('mc-current')) render();
        });
    }

    $('mcShuffle').addEventListener('change', () => { $('mcShuffle').dataset.touched = '1'; });
    render();
    setInterval(tick, 1000);
})();
</script>
