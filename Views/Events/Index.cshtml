@model List<ChurchMinistry.Models.ChurchEvent>
@{
    ViewData["Title"] = "Events & Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var myRegMap = ViewBag.MyRegMap as Dictionary<int, ChurchMinistry.Models.EventRegistration?>
                   ?? new Dictionary<int, ChurchMinistry.Models.EventRegistration?>();
    var pastEvents = ViewBag.PastEvents as List<ChurchMinistry.Models.ChurchEvent> ?? new();
}
@using ChurchMinistry.Models

<section class="page-header">
    <h1><i class="fas fa-calendar"></i> Events &amp; Calendar</h1>
    <p>Upcoming services, conferences and community gatherings</p>
</section>

<div class="container" style="max-width:1100px;margin:2rem auto;padding:0 1.5rem">

    @* Upcoming: soonest first *@
    <h2 class="events-section-title"><i class="fas fa-calendar-alt"></i> Upcoming Events</h2>
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:3rem 1rem;color:var(--text-s)">
            <i class="fas fa-calendar fa-3x" style="color:var(--border);display:block;margin-bottom:1rem"></i>
            <p>No upcoming events. Check back soon!</p>
        </div>
    }

    <div class="events-list large">
    @foreach (var ev in Model)
    {
        <partial name="_EventCard" model="(ev, myRegMap.GetValueOrDefault(ev.Id))" />
    }
    </div>
    <partial name="_Pager" model="(PagerModel)ViewBag.Pager" />

    @* Past: the most recent first, the last few only *@
    @if (pastEvents.Any())
    {
        <h2 class="events-section-title events-section-past"><i class="fas fa-history"></i> Past Events</h2>
        <div class="events-list large">
        @foreach (var ev in pastEvents)
        {
            <partial name="_EventCard" model="(ev, myRegMap.GetValueOrDefault(ev.Id))" />
        }
        </div>
    }
</div>

@section Scripts {
<style>
.events-list.large    { display:flex; flex-direction:column; gap:1.25rem; }
.events-section-title { font-size:1.25rem; font-weight:800; margin:0 0 1rem;
                        display:flex; align-items:center; gap:.5rem; }
.events-section-title i { color:var(--purple); }
.events-section-past  { margin-top:2.5rem; padding-top:2rem; border-top:1px solid var(--border); }

.event-card           { background:var(--white); border:1px solid var(--border);
                        border-radius:var(--radius); overflow:hidden;
                        box-shadow:var(--shadow); transition:box-shadow .2s; }
.event-card:hover     { box-shadow:var(--shadow-l); }
.event-card-past      { opacity:.72; }

.event-card-img-wrap  { position:relative; height:200px; overflow:hidden; }
.event-card-img       { width:100%; height:100%; object-fit:cover; }
.event-past-overlay   { position:absolute; inset:0; background:rgba(0,0,0,.45);
                        display:flex; align-items:center; justify-content:center;
                        color:white; font-weight:700; font-size:.95rem;
                        letter-spacing:.06em; }

.event-card-body      { display:flex; gap:1.25rem; padding:1.25rem; }
.event-date-badge     { text-align:center; min-width:58px; flex-shrink:0; }
.event-date-badge .day  { display:block; font-size:2rem; font-weight:800;
                          color:var(--purple); line-height:1; }
.event-date-badge .month{ display:block; font-size:.8rem; text-transform:uppercase;
                          color:var(--text-s); letter-spacing:.05em; }
.event-date-badge .year { display:block; font-size:.72rem; color:var(--border); }

.event-card-content   { flex:1; min-width:0; }
.event-card-title-row { display:flex; align-items:flex-start; justify-content:space-between;
                        gap:.75rem; flex-wrap:wrap; margin-bottom:.5rem; }
.event-card-title     { font-size:1.1rem; font-weight:800; margin:0; }
.event-card-title a   { color:var(--text); }
.event-card-title a:hover { color:var(--purple); }

.event-badge-row      { display:flex; gap:.35rem; flex-wrap:wrap; flex-shrink:0; }
.event-badge          { display:inline-flex; align-items:center; gap:.3rem;
                        padding:.2rem .6rem; border-radius:100px;
                        font-size:.72rem; font-weight:700; white-space:nowrap; }
.event-badge-paid     { background:#ede9fe; color:#5b21b6; }
.event-badge-free     { background:#d1fae5; color:#065f46; }
.event-badge-allday   { background:#dbeafe; color:#1e40af; }
.event-badge-partial  { background:#fef3c7; color:#92400e; }
.event-badge-soldout  { background:#fee2e2; color:#991b1b; }

.event-card-meta-row  { display:flex; gap:.75rem 1.5rem; flex-wrap:wrap;
                        font-size:.82rem; color:var(--text-s); margin-bottom:.6rem; }
.event-card-meta-row i{ color:var(--purple); }
.event-reg-count      { font-weight:600; }
.spots-urgent         { color:var(--coral); font-weight:700; }

.event-card-desc      { font-size:.88rem; color:var(--text-s); line-height:1.6;
                        margin-bottom:.75rem; }
.event-card-footer    { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; }

/* Registration status badges */
.event-reg-status     { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; }
.reg-status-badge     { display:inline-flex; align-items:center; gap:.35rem;
                        padding:.3rem .8rem; border-radius:100px; font-size:.78rem;
                        font-weight:700; }
.reg-confirmed        { background:#d1fae5; color:#065f46; }
.reg-partial          { background:#fef3c7; color:#92400e; }

@@media (max-width:640px) {
  .event-card-body    { flex-direction:column; }
  .event-card-title-row { flex-direction:column; }
}
</style>
}
