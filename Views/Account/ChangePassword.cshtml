@model ChurchMinistry.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password"; Layout = "~/Views/Shared/_MemberDashboard_Layout.cshtml";
}
<section class="page-header"><h1>Change Password</h1></section>
<div class="form-page" style="max-width:480px">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <small style="color:var(--text-s);font-size:.78rem">At least 8 characters, including a number and a lowercase letter.</small>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Change Password</button>
        <a asp-controller="Members" asp-action="Dashboard" class="btn btn-outline">Cancel</a>
    </form>
</div>
