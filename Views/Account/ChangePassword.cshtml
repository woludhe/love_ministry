@model ChurchMinistry.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    // Admins and pastors stay in the admin panel (they may have no member profile)
    var adminArea = User.IsInRole("Admin") || User.IsInRole("Pastor");
    Layout = adminArea ? "~/Views/Shared/_AdminDashboard_Layout.cshtml" : "~/Views/Shared/_MemberDashboard_Layout.cshtml";
}
<div class="@(adminArea ? "admin-main" : "")">
<section class="page-header"><h1>Change Password</h1></section>
<div class="form-page" style="max-width:480px">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <small class="form-hint">At least 8 characters, including a number and a lowercase letter.</small>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Change Password</button>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Security" class="btn btn-outline">Cancel</a>
        }
        else if (adminArea)
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline">Cancel</a>
        }
        else
        {
            <a asp-controller="Members" asp-action="Profile" class="btn btn-outline">Cancel</a>
        }
    </form>
</div>
</div>
