@model ChurchMinistry.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Join Our Family"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <div class="auth-logo">✝</div>
    <h2>Join Our Family</h2>
    <p>Create your member account to access all features</p>
    <form asp-action="Register" method="post">
      <div asp-validation-summary="All" class="validation-summary"></div>
      <div class="form-row">
        <div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="field-error"></span></div>
        <div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="field-error"></span></div>
      </div>
      <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="field-error"></span></div>
      <div class="form-group"><label asp-for="Phone">Phone Number</label><input asp-for="Phone" class="form-control" placeholder="+256 7XX XXX XXX" /></div>
      <div class="form-row">
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" type="password" /><span asp-validation-for="Password" class="field-error"></span></div>
        <div class="form-group"><label asp-for="ConfirmPassword">Confirm Password</label><input asp-for="ConfirmPassword" class="form-control" type="password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
      </div>
      <div class="form-group checkbox-group">
        <label><input asp-for="AgreeToTerms" required /> I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></label>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Create Account</button>
    </form>
    <p class="auth-switch">Already a member? <a asp-action="Login">Sign In</a></p>
  </div>
</div>
