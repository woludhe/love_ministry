@model ChurchMinistry.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Sign In"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">✝</div>
    <h2>Welcome Back</h2>
    <p>Sign in to your member account</p>
    <form asp-action="Login" method="post">
      <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
      <div asp-validation-summary="All" class="validation-summary"></div>
      <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="email" /></div>
      <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" type="password" placeholder="••••••••" autocomplete="current-password" /></div>
      <div class="form-row-inline">
        <label><input asp-for="RememberMe" /> Remember me</label>
        <a asp-action="ForgotPassword">Forgot password?</a>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Sign In</button>
    </form>
    <p class="auth-switch">Don't have an account? <a asp-action="Register">Join Us</a></p>
  </div>
</div>
