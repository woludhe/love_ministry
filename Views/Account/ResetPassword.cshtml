@model ChurchMinistry.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a New Password"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">✝</div>
    <h2>Choose a New Password</h2>
    <p>For <strong>@Model.Email</strong></p>
    <form asp-action="ResetPassword" method="post">
      <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
      <input type="hidden" asp-for="Code" />
      <input type="hidden" asp-for="Email" />
      <div class="form-group">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <small class="form-hint">At least 8 characters, including a number and a lowercase letter.</small>
        <span asp-validation-for="NewPassword" class="field-error"></span>
      </div>
      <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Reset Password</button>
    </form>
    <p class="auth-switch"><a asp-action="Login">Back to Sign In</a></p>
  </div>
</div>
