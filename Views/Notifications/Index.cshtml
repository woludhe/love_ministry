@model List<ChurchMinistry.Models.Notification>
@{ ViewData["Title"] = "Notifications"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<section class="page-header">
    <h1><i class="fas fa-bell"></i> Notifications</h1>
    <p>Your recent activity and updates</p>
</section>

<div class="container" style="max-width:700px;margin:2rem auto;padding:0 1.5rem">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:4rem 1.5rem;color:var(--text-s)">
            <i class="fas fa-bell-slash fa-3x" style="color:var(--border);margin-bottom:1rem;display:block"></i>
            <h3>No notifications yet</h3>
            <p>You'll see updates about prayers, events, givings and more here.</p>
        </div>
    }
    else
    {
        <div class="notif-page-list">
            @foreach (var n in Model)
            {
                <div class="notif-page-item @(n.IsRead ? "" : "unread")">
                    <div class="notif-page-icon">
                        <i class="@GetIcon(n.Title)"></i>
                    </div>
                    <div class="notif-page-body">
                        <strong>@n.Title</strong>
                        <p>@n.Message</p>
                        <small class="meta">@n.CreatedAt.ToString("dddd, dd MMMM yyyy · h:mm tt")</small>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Link))
                    {
                        <a href="@n.Link" class="btn btn-outline btn-xs">View</a>
                    }
                </div>
            }
        </div>
    }
</div>

@functions {
    string GetIcon(string title)
    {
        var t = title.ToLower();
        if (t.Contains("prayer"))  return "fas fa-hands-praying";
        if (t.Contains("giving") || t.Contains("tithe") || t.Contains("offering")) return "fas fa-hand-holding-heart";
        if (t.Contains("event"))   return "fas fa-calendar";
        if (t.Contains("sermon") || t.Contains("live")) return "fas fa-video";
        if (t.Contains("member") || t.Contains("welcome")) return "fas fa-user-plus";
        if (t.Contains("meeting")) return "fas fa-video";
        return "fas fa-bell";
    }
}

@section Scripts {
<style>
.notif-page-list    { display:flex; flex-direction:column; gap:.6rem; }
.notif-page-item    { display:flex; align-items:flex-start; gap:1rem;
                      background:var(--white); border:1px solid var(--border);
                      border-radius:var(--radius); padding:1rem 1.25rem;
                      box-shadow:var(--shadow); transition:all .15s; }
.notif-page-item:hover { box-shadow:var(--shadow-m); }
.notif-page-item.unread { border-left:3px solid var(--purple); background:#fafafe; }
.notif-page-icon    { width:38px; height:38px; border-radius:10px; background:var(--purple-l);
                      color:var(--purple); display:flex; align-items:center;
                      justify-content:center; flex-shrink:0; font-size:.95rem; }
.notif-page-body    { flex:1; }
.notif-page-body strong { font-size:.9rem; font-weight:700; }
.notif-page-body p  { font-size:.85rem; color:var(--text-s); margin:.2rem 0 .3rem; }
</style>
}
