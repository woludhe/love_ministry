@using ChurchMinistry.ViewComponents
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject CurrentMemberViewComponent MemberVc

@{
    var me = User.Identity?.IsAuthenticated == true
        ? await MemberVc.GetModelAsync()
        : new CurrentMemberViewModel();

    // Sidebar: the link for the current page keeps its hover look; related pages light up their parent link
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool At(string c, params string[] actions) => controller == c && (actions.Length == 0 || actions.Contains(action));
    string? Active(bool on) => on ? "active" : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? @Config["Church:Name"])</title>
    <script>/* Dark mode chosen in the dashboard menu; set before the page paints so it never flashes white */ try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) { }</script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <partial name="_NavBar" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle"></i> @TempData["Info"]</div>
    }

    <main>
        <div class="sidebar-toggle-bar">
            <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-controls="dashSidebar" aria-expanded="false">
                <i class="fas fa-bars"></i> Dashboard Menu
            </button>
            @await Component.InvokeAsync("NavUnread", new { place = "bar" })
        </div>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="member-layout">
            <aside class="member-sidebar dash-sidebar" id="dashSidebar">
                <button type="button" class="sidebar-close" aria-label="Close menu"><i class="fas fa-times"></i></button>
                <div class="member-avatar">
                    <img src="@(me.ProfilePhoto ?? "/images/avatar-default.png")" alt="Profile" />
                    <h3>@me.FullName</h3>
                    @if (me.Groups.Any())
                    {
                        <div class="member-avatar-groups">
                            @foreach (var g in me.Groups)
                            {
                                <span class="group-icon" title="@g.Name" role="img" aria-label="@g.Name"><i class="bi @ChurchMinistry.ViewModels.MinistryGroupIcons.For(g)"></i></span>
                            }
                        </div>
                    }
                </div>
                <nav class="sidebar-nav">
                    <a asp-controller="Members" asp-action="Dashboard" class="sidebar-nav-home @Active(At("Members", "Dashboard", "MyDaily"))"><i class="fas fa-home"></i> Dashboard</a>
                    <a asp-controller="Devotionals" asp-action="Index" class="@Active(At("Devotionals"))"><i class="fas fa-book-bible"></i> Devotions</a>
                    <a asp-controller="Members" asp-action="Profile" class="@Active(At("Members", "Profile", "EditProfile") || At("Account", "ChangePassword"))"><i class="fas fa-user"></i> My Profile</a>
                    <a asp-controller="Members" asp-action="MyQrCode" class="@Active(At("Members", "MyQrCode"))"><i class="fas fa-qrcode"></i> My QR Code</a>
                    <a asp-controller="Members" asp-action="Attendance" class="@Active(At("Members", "Attendance"))"><i class="fas fa-calendar-check"></i> Attendance</a>
                    <a asp-controller="Giving" asp-action="Give" class="@Active(At("Giving") && action != "Reminders")"><i class="fas fa-hand-holding-heart"></i> Give</a>
                    <a asp-controller="Giving" asp-action="Reminders" class="@Active(At("Giving", "Reminders"))"><i class="fas fa-bell"></i> Giving Pledges</a>
                    <a asp-controller="Prayer" asp-action="Submit" class="@Active(At("Prayer", "Submit"))"><i class="fas fa-hands-praying"></i> Prayer Request</a>
                    <a asp-controller="Community" asp-action="Index" class="@Active(At("Community") && action != "Chat")"><i class="fas fa-comments"></i> Community @await Component.InvokeAsync("NavUnread", new { place = "community" })</a>
                    <a asp-controller="Community" asp-action="Chat" class="@Active(At("Community", "Chat"))"><i class="fas fa-comment-dots"></i> Live Chat @await Component.InvokeAsync("NavUnread", new { place = "chat" })</a>
                    <a asp-controller="Members" asp-action="Directory" class="@Active(At("Members", "Directory", "ViewProfile"))"><i class="fas fa-address-book"></i> Directory</a>
                    @* Light / dark switch (site.js); the choice is kept in this browser *@
                    <button type="button" class="theme-toggle js-theme-toggle" role="switch" aria-checked="false">
                        <i class="fas fa-moon"></i> <span class="theme-toggle-label">Dark mode</span>
                        <span class="theme-switch" aria-hidden="true"></span>
                    </button>
                </nav>
            </aside>
            <div class="member-main">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-grid">
            <div class="footer-col">
                <h3>✝ @Config["Church:Name"]</h3>
                <p>@Config["Church:Motto"]</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-controller="Media" asp-action="Index">Sermons</a></li>
                    <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                    <li><a asp-controller="Prayer" asp-action="Submit">Prayer Request</a></li>
                    <li><a asp-controller="Giving" asp-action="Give">Give Online</a></li>
                    <li><a asp-controller="Newsletter" asp-action="Index">Newsletter</a></li>
                </ul>
            </div>
            @* Service Times column hidden; to show it again, restore:
            <div class="footer-col"><h4>Service Times</h4>
                <p><strong>Sunday Service</strong><br>8:00 AM & 10:30 AM</p>
                <p><strong>Midweek Bible Study</strong><br>Wednesday 6:30 PM</p>
                <p><strong>Prayer Meeting</strong><br>Friday 6:00 PM</p></div> *@
            <div class="footer-col">
                <h4>Contact</h4>
                <p><i class="fas fa-map-marker-alt"></i> @Config["Church:Address"]</p>
                <p><i class="fas fa-phone"></i> @Config["Church:Phone"]</p>
                <p><i class="fas fa-envelope"></i> @Config["Church:Email"]</p>
                <form asp-controller="Home" asp-action="Subscribe" method="post" class="footer-subscribe">
                    <input type="email" name="Email" placeholder="Your email" required />
                    <button type="submit">Subscribe</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year @Config["Church:Name"]. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (me.MemberId != null)
    {
        @* Keeps the Live Chat / Community tags live; the chat page already loads SignalR in its Scripts section *@
        if (!Context.Request.Path.StartsWithSegments("/Community/Chat"))
        {
            <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        }
        <script src="~/js/nav-unread.js" asp-append-version="true"></script>
    }
    @await Component.InvokeAsync("TodaysDevotion")
    @if (User.Identity?.IsAuthenticated == true)
    {
        <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
        <script src="~/js/notification.js"></script>
    }
</body>
</html>
