@inject Microsoft.Extensions.Configuration.IConfiguration Config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? @Config["Church:Name"])</title>
    <script>/* Dark mode chosen in the dashboard menu; set before the page paints so it never flashes white */ try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) { }</script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>

    <partial name="_NavBar" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info"><i class="fas fa-info-circle"></i> @TempData["Info"]</div>
    }

    <main>
        <button type="button" class="sidebar-toggle sidebar-toggle-admin" id="sidebarToggle" aria-controls="dashSidebar" aria-expanded="false">
            <i class="fas fa-bars"></i> Admin Menu
        </button>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="admin-layout">
            <!-- Sidebar -->
            <aside class="admin-sidebar dash-sidebar" id="dashSidebar">
                <button type="button" class="sidebar-close" aria-label="Close menu"><i class="fas fa-times"></i></button>
                <div class="sidebar-logo">⚙ Admin Panel</div>
                <nav class="sidebar-nav">
                    <a asp-controller="Admin" asp-action="Index" class="active"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                    @{
                        var memberNavAction = ViewContext.RouteData.Values["action"]?.ToString();
                        var inMembers = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin"
                                     && new[] { "Members", "MemberActivity", "Groups", "CreateGroup", "EditGroup", "GroupDetails" }.Contains(memberNavAction);
                    }
                    <details class="sidebar-group" open="@inMembers">
                        <summary><i class="fas fa-users"></i> Members <i class="fas fa-chevron-down sidebar-caret"></i></summary>
                        <a asp-controller="Admin" asp-action="Members"
                           class="@(inMembers && memberNavAction == "Members" ? "active" : "")">
                            <i class="fas fa-address-card"></i> All Members
                        </a>
                        <a asp-controller="Admin" asp-action="MemberActivity"
                           class="@(inMembers && memberNavAction == "MemberActivity" ? "active" : "")">
                            <i class="fas fa-chart-line"></i> Member Activity
                        </a>
                        <a asp-controller="Admin" asp-action="Groups"
                           class="@(inMembers && memberNavAction is not ("Members" or "MemberActivity") ? "active" : "")">
                            <i class="fas fa-people-group"></i> Groups
                        </a>
                    </details>
                    <a asp-controller="Admin" asp-action="Attendance"><i class="fas fa-calendar-check"></i> Attendance</a>
                    <a asp-controller="Admin" asp-action="Givings"><i class="fas fa-hand-holding-heart"></i> Givings</a>
                    <a asp-controller="AdminPayment" asp-action="Index"><i class="fa-solid fa-money-bill"></i> Payment Settings</a>
                    @{
                        var sermonNavAction = ViewContext.RouteData.Values["action"]?.ToString();
                        var inSermons = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin"
                                     && new[] { "Sermons", "AddSermon", "EditSermon", "AudioLibrary" }.Contains(sermonNavAction);
                    }
                    <details class="sidebar-group" open="@inSermons">
                        <summary><i class="fas fa-video"></i> Sermons <i class="fas fa-chevron-down sidebar-caret"></i></summary>
                        <a asp-controller="Admin" asp-action="Sermons"
                           class="@(inSermons && sermonNavAction != "AudioLibrary" ? "active" : "")">
                            <i class="fas fa-list"></i> All Sermons
                        </a>
                        <a asp-controller="Admin" asp-action="AudioLibrary"
                           class="@(sermonNavAction == "AudioLibrary" ? "active" : "")">
                            <i class="fas fa-music"></i> Audio Library
                        </a>
                    </details>
                    <a asp-controller="Devotionals" asp-action="Manage"><i class="fas fa-book-bible"></i> Devotionals</a>
                    <a asp-controller="Admin" asp-action="Events"><i class="fas fa-calendar"></i> Events</a>
                    @{
                        var navController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var inMeetings = navController == "MeetingApprovals" || navController == "MeetingRegister";
                    }
                    <details class="sidebar-group" open="@inMeetings">
                        <summary>
                            <i class="fas fa-video"></i> Meetings
                            <span id="approvalBadgeGroup" class="notif-count"
                                  style="display:none;position:relative;top:auto;right:auto"></span>
                            <i class="fas fa-chevron-down sidebar-caret"></i>
                        </summary>
                        <a asp-controller="MeetingApprovals" asp-action="Index"
                           class="@(navController == "MeetingApprovals" ? "active" : "")">
                            <i class="fas fa-clock"></i> Meeting Approvals
                            <span id="approvalBadge" class="notif-count"
                                  style="display:none;position:relative;top:auto;right:auto"></span>
                        </a>
                        <a asp-controller="MeetingRegister" asp-action="Index"
                           class="@(navController == "MeetingRegister" ? "active" : "")">
                            <i class="fas fa-book"></i> Meetings Register
                        </a>
                    </details>
                    <a asp-controller="Admin" asp-action="Newsletters"><i class="fas fa-envelope"></i> Newsletter</a>
                    @{
                        var navAction = ViewContext.RouteData.Values["action"]?.ToString();
                        var inReports = ViewContext.RouteData.Values["controller"]?.ToString() == "Admin"
                                     && (navAction == "Reports" || navAction == "SermonAttendanceReport");
                    }
                    <details class="sidebar-group" open="@inReports">
                        <summary><i class="fas fa-chart-bar"></i> Reports <i class="fas fa-chevron-down sidebar-caret"></i></summary>
                        <a asp-controller="Admin" asp-action="Reports"
                           class="@(inReports && navAction == "Reports" ? "active" : "")">
                            <i class="fas fa-hand-holding-heart"></i> Giving
                        </a>
                        <a asp-controller="Admin" asp-action="SermonAttendanceReport"
                           class="@(navAction == "SermonAttendanceReport" ? "active" : "")">
                            <i class="fas fa-user-clock"></i> Sermon Attendance
                        </a>
                    </details>
                    <hr />
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Account" asp-action="Security"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")">
                            <i class="fas fa-shield-halved"></i> Account Security
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key"></i> Change Password</a>
                    }
                    <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> View Site</a>
                </nav>
            </aside>
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="footer-grid">
            <div class="footer-col">
                <h3>✝ @Config["Church:Name"]</h3>
                <p>@Config["Church:Motto"]</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Quick Links</h4>
                <ul>
                    <li><a asp-controller="Media" asp-action="Index">Sermons</a></li>
                    <li><a asp-controller="Events" asp-action="Index">Events</a></li>
                    <li><a asp-controller="Prayer" asp-action="Submit">Prayer Request</a></li>
                    <li><a asp-controller="Giving" asp-action="Give">Give Online</a></li>
                    <li><a asp-controller="Newsletter" asp-action="Index">Newsletter</a></li>
                </ul>
            </div>
            @* Service Times column hidden; to show it again, restore:
            <div class="footer-col"><h4>Service Times</h4>
                <p><strong>Sunday Service</strong><br>8:00 AM & 10:30 AM</p>
                <p><strong>Midweek Bible Study</strong><br>Wednesday 6:30 PM</p>
                <p><strong>Prayer Meeting</strong><br>Friday 6:00 PM</p></div> *@
            <div class="footer-col">
                <h4>Contact</h4>
                <p><i class="fas fa-map-marker-alt"></i> @Config["Church:Address"]</p>
                <p><i class="fas fa-phone"></i> @Config["Church:Phone"]</p>
                <p><i class="fas fa-envelope"></i> @Config["Church:Email"]</p>
                <form asp-controller="Home" asp-action="Subscribe" method="post" class="footer-subscribe">
                    <input type="email" name="Email" placeholder="Your email" required />
                    <button type="submit">Subscribe</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year @Config["Church:Name"]. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("TodaysDevotion")
    @if (User.Identity?.IsAuthenticated == true)
    {
        <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
        <script src="~/js/notification.js"></script>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Pastor"))
    {
        <script>
            async function pollApprovals() {
                try {
                    const res = await fetch('/MeetingApprovals/PendingCount');
                    const data = await res.json();
                    ['approvalBadge', 'approvalBadgeGroup'].forEach(id => {
                        const badge = document.getElementById(id);
                        if (!badge) return;
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline-flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    });
                } catch { }
            }
            pollApprovals();
            setInterval(pollApprovals, 60000);
        </script>
    }
</body>
</html>
